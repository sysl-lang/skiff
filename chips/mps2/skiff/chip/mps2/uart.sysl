module skiff.chip.mps2

// The first of the MPS2's CMSDK UARTs, at 0x4000_4000 on the AN500 and the AN386 alike (QEMU's
// `info mtree -f`). It transmits nothing until `bauddiv` and the transmit enable in `ctrl` are set.

private struct Uart
    data: volatile u32          // 0x00 a write sends a byte
    state: volatile u32         // 0x04 bit 0: transmit buffer full
    ctrl: volatile u32          // 0x08 bit 0: transmit enable
    intstatus: volatile u32     // 0x0c
    bauddiv: volatile u32       // 0x10

@assert(offsetof(Uart, bauddiv) == 0x10, "BAUDDIV is at 0x10")

const UART0: usize = 0x4000_4000
private const STATE_TX_FULL: u32 = 1 << 0
private const CTRL_TX_ENABLE: u32 = 1 << 0

private uart() -> *Uart = ptr_cast(UART0)

// Switch the transmitter on. QEMU's model ignores the divisor's value but needs one written.
console_init()
    val u = uart()
    u.bauddiv = 16
    u.ctrl = CTRL_TX_ENABLE

// Send one byte, waiting while the transmit buffer is full.
put_byte(b: u8)
    val u = uart()
    while (u.state & STATE_TX_FULL) != 0 do ()
    u.data = u32(b)

// Send every byte of `bytes`.
write(bytes: []const u8)
    for b in bytes
        put_byte(b)
