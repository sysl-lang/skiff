module skiff.chip.an521

// The SSE-200's interrupts, as far as the board uses them: the vector table's chip half, which the link
// script puts straight after the architecture's sixteen words. Both cores run from the one table, and
// each core's NVIC is its own. Interrupt 3, timer 0's, goes to the board's `skiff_timer0`, and interrupt
// 6, MHU0's, to the doorbell's handler (mhu.sysl); the others up to it stop the machine, as an unhandled
// system exception does. No device past it is ever enabled.

// Timer 0's interrupt. The board raises it from software (the timer itself is never started).
const TIMER0_IRQ: u32 = 3

asm
    [thumb]
        ".section .vectors.irq, \"a\""
        ".rept 3"
        ".word skiff_exception"
        ".endr"
        ".word skiff_timer0"
        ".word skiff_exception"
        ".word skiff_exception"
        ".word skiff_an521_mhu0"
        ".text"
    [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "skiff.chip.an521 is for the AN521's Cortex-M33 cores"
