// The portable kernel. It is written against the traits in skiff.kernel and names no register, interrupt
// number or address, so it builds for every target sysl has and its tests run on the host.

package {
  name    = "kernel"
  version = "0.0.1"
}

options {
  cores   { type = usize, default = 1, range = [1, 8], doc = "how many cores run the kernel, each with a Core of its own" }
  tick_hz { type = u32, default = 100, range = [1, 10000], doc = "how many times a second every core ticks" }
  tasks   { type = usize, default = 16, range = [2, 4096], doc = "how many tasks each core's table holds, its idle task among them; a handle's slot has 12 bits" }
  map_regions { type = usize, default = 6, range = [2, 16], doc = "regions in an unprivileged task's map, its stack among them" }
  grants  { type = usize, default = 4, range = [0, 32], doc = "objects one unprivileged task may be granted" }
  cache_line { type = usize, default = 32, range = [4, 256], doc = "the data cache's line in bytes, a power of two: every pool buffer starts on one and fills whole lines" }
}

// The kernel's tests run in two builds. With one core, where no path between cores is in the build:
// `sysl test kernel --filter skiff.kernel`. For the paths between cores, the kernel is built for three
// and the tests of skiff.cores (skiff/cores/) play each core in turn over one port:
// `sysl test kernel --option cores=3 --filter skiff.cores`.
