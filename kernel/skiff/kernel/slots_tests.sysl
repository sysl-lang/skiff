module skiff.kernel
@tests

// Finding a slot for a new task: the table's free and stopped sets (tasks.sysl, `SlotSet`), which slot
// a creation takes, and what holds while a creation has a slot reserved between its two masked holds.

private body() -> never
    loop
        ()

private var ft_stack: [128]u32

// A table with every slot in use: the idle task in slot 0, priority 1 in the rest, each with its slot as
// its stack pointer.
private ft_full() -> Scheduler
    var s = EMPTY_SCHEDULER
    for i in 0..<option_tasks
        s.add_at(i, i, if i == 0 then IDLE_PRIORITY else 1)
    s

@test("a full table has no slot to give, and a delete gives back exactly the deleted slot")
ft_full_table()
    var s = ft_full()
    assert(s.free_slot() == None, "full")
    assert(s.reserve() == None, "nothing to reserve")
    assert(s.delete(s.handle(0, 9)) == Ok(false), "deleted")
    assert(s.free_slot() == Some(9), "its slot")
    assert(s.reserve() == Some(9), "reserved")
    assert(s.free_slot() == None, "full again")
    assert(s.reserve() == None, "and nothing more to reserve")

@test("the lowest free slot is taken first, and a stopped slot only once no slot is free")
ft_stopped_after_free()
    var s = ft_full()
    s.stop_at(2)
    s.stop_at(4)
    assert(s.delete(s.handle(0, 7)) == Ok(false), "a free slot above the stopped ones")
    assert(s.delete(s.handle(0, 5)) == Ok(false), "a lower one")
    assert(s.reserve() == Some(5), "the lowest free slot")
    assert(s.reserve() == Some(7), "the other free slot")
    assert(s.reserve() == Some(2), "then the lowest stopped slot")
    assert(s.reserve() == Some(4), "then the other")
    assert(s.reserve() == None, "then none")

@test("a deleted stopped task's slot is free, taken before any other stopped slot")
ft_deleted_stopped_is_free()
    var s = ft_full()
    s.stop_at(3)
    val six = s.handle(0, 6)
    s.stop_at(6)
    assert(s.delete(six) == Ok(false), "a stopped task deleted")
    assert(s.reserve() == Some(6), "its slot is free now, before the lower stopped one")
    assert(s.reserve() == Some(3), "then the stopped one")

@test("a slot's generation changes when it is freed and when a stopped task's slot is taken, once each")
ft_generation()
    var s = ft_full()
    val g = s.tasks[3].generation
    assert(s.delete(s.handle(0, 3)) == Ok(false), "deleted")
    assert_eq(s.tasks[3].generation, next_generation(g))
    assert(s.reserve() == Some(3), "reserved")
    s.prepare(3, 3, 1)
    s.publish(3)
    assert_eq(s.tasks[3].generation, next_generation(g))
    val stopped = s.handle(0, 6)
    s.stop_at(6)
    assert(s.check(stopped) == Ok(6), "a stopped task's handle still names it")
    assert(s.reserve() == Some(6), "the only slot left is the stopped one")
    assert_eq(s.tasks[6].generation, next_generation(stopped.generation()))
    assert(s.check(stopped) == Err(TaskError.Stale), "its handle is stale from the reservation on")
    s.add_at(6, 6, 1)
    assert_eq(s.tasks[6].generation, next_generation(stopped.generation()))
    assert(s.check(s.handle(0, 6)) == Ok(6), "the new task's handle")

@test("a reserved slot is the creator's alone: no delete reaches it and no other creation is given it")
ft_reserved_racing_delete()
    var s = ft_full()
    val old = s.handle(0, 4)
    s.stop_at(4)
    assert(s.reserve() == Some(4), "the only stopped slot of a full table")
    assert(s.delete(old) == Err(TaskError.Stale), "the stopped task's handle deletes nothing")
    assert(s.free_slot() == None, "and frees nothing")
    assert(s.delete(s.handle(0, 4)) == Err(TaskError.Stale), "the new task's handle names nothing yet")
    assert(s.free_slot() == None, "still nothing")
    assert(s.delete(s.handle(0, 8)) == Ok(false), "another task deleted meanwhile")
    assert(s.reserve() == Some(8), "a second creation takes that slot, not the reserved one")
    s.prepare(4, 4, 1)
    s.publish(4)
    assert(s.check(s.handle(0, 4)) == Ok(4), "published, the handle names it")
    assert(s.tasks[4].state == TaskState.Ready, "ready")
    assert(s.delete(s.handle(0, 4)) == Ok(false), "and a delete reaches it now")
    assert(s.free_slot() == Some(4), "freed")

@test("the running task's freed or stopped slot is not given out before the switch, even as the only one")
ft_running_skipped()
    var s = ft_full()
    s.first()
    val r = usize(s.running)
    assert(s.delete(s.handle(0, r)) == Ok(true), "the running task")
    assert(s.free_slot() == None, "its slot, the only free one, waits for the switch")
    s.stop_at(5)
    assert(s.free_slot() == Some(5), "a stopped slot is given out meanwhile")
    s.switch(0)
    assert(s.free_slot() == Some(r), "after the switch its free slot comes before the stopped one")
    assert(s.reserve() == Some(r), "taken")
    s.add_at(r, r, 1)
    val now = usize(s.running)
    s.stop()
    assert(s.free_slot() == Some(5), "a running task's own stop is skipped too")
    assert(s.reserve() == Some(5), "taken")
    assert(s.free_slot() == None, "the running stopped slot only after the switch")
    s.switch(0)
    assert(s.free_slot() == Some(now), "now")

@test("a set of 4096 slots finds its lowest member across words and groups, and leaves one out")
ft_large_set()
    var s = SlotSet[128, 4]([0; 128], [0; 4])
    val none = usize(NONE)
    assert(s.lowest_except(none) == None, "empty")
    s.add(4095)
    assert(s.lowest_except(none) == Some(4095), "the last slot")
    assert(s.lowest_except(4095) == None, "its only member left out")
    s.add(1024)
    s.add(1055)
    assert(s.lowest_except(none) == Some(1024), "the second group's first")
    assert(s.lowest_except(1024) == Some(1055), "the same word without it")
    s.remove(1055)
    assert(s.lowest_except(1024) == Some(4095), "its word empty without it: the next group")
    s.add(31)
    s.add(32)
    assert(s.lowest_except(none) == Some(31), "the first word's last bit")
    assert(s.lowest_except(31) == Some(32), "the next word")
    s.remove(31)
    s.remove(32)
    s.remove(1024)
    assert(!s.has(31) && !s.has(1024) && s.has(4095), "members")
    assert_eq(s.groups[0], 0)
    assert_eq(s.groups[1], 0)
    assert_eq(s.groups[2], 0)
    assert_eq(s.groups[3], 0x8000_0000)
    s.add(4095)
    assert_eq(s.groups[3], 0x8000_0000)
    s.remove(4095)
    assert_eq(s.groups[3], 0)
    assert(s.lowest_except(none) == None, "empty again")

@test("create takes a free slot before a stopped one, and taking the stopped one ends its handle")
ft_create_order()
    var r = recorder(1, 0)
    var tasks: [option_tasks]Task = [Task(0); option_tasks]
    for i in 0..<option_tasks
        tasks[i] = create(&r, 0, ft_stack, &body, 1).unwrap()
        assert_eq(tasks[i].slot(), i)
    assert(create(&r, 0, ft_stack, &body, 1) == Err(TaskError.Full), "full")
    here(&r).sched.stop_at(3)
    assert(delete(&r, tasks[10]).is_ok(), "deleted")
    val again = create(&r, 0, ft_stack, &body, 1).unwrap()
    assert_eq(again.slot(), 10)
    assert(again.generation() != tasks[10].generation(), "a new generation")
    assert(state(&r, tasks[3]) == Ok(TaskState.Stopped), "the stopped task's handle still answers")
    val reused = create(&r, 0, ft_stack, &body, 1).unwrap()
    assert_eq(reused.slot(), 3)
    assert(state(&r, tasks[3]) == Err(TaskError.Stale), "stale once its slot is reused")
    assert(state(&r, reused) == Ok(TaskState.Ready), "the new task is ready")
    assert(create(&r, 0, ft_stack, &body, 1) == Err(TaskError.Full), "full again")
    assert_eq(r.masked, 0)
