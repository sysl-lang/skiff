module skiff.kernel
@tests

// Unprivileged tasks on the host: their maps, the buffer check, the switch's loads, the trap's frame,
// and every call's checks. A protection unit stands in that is 32-byte granular, like PMSAv8, and
// counts what it is asked to load. The kernel's `run` is never called, so nothing masks and nothing
// blocks: every call here is made with a timeout of 0. The `user` functions that make these calls
// through the trap are tested beside them (user/user_tests.sysl).

private struct Granular
    holds: usize        // regions a map may have
    loads: u32          // maps loaded
    loaded: usize       // regions in the last one

impl Isolation for Granular
    capacity(*self) -> usize = self.holds

    encode(*self, r: Region) -> Result[Slot, RegionError]
        if r.bytes == 0 then return Err(RegionError.Empty)
        if r.bytes - 1 > usize::Max - r.base then return Err(RegionError.Wraps)
        if r.base % 32 != 0 || r.bytes % 32 != 0 then return Err(RegionError.Unaligned)
        Ok(Slot(u32(r.base & 0xffff_ffff), u32(r.bytes)))

    load(*self, map: []const Slot)
        self.loads += 1
        self.loaded = map.len

private struct CallPort
    switches: u32

impl Port for CallPort
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = usize(&stack[stack.len - 8])
    request_switch(*self) = self.switches += 1
    start_first(*self, sp: usize) -> never
        loop
            ()
    mask(*self) -> u32 = 0
    restore(*self, state: u32) = ()
    idle(*self) = ()

// Protection that reserves the bottom 64 bytes of every stack, as an Armv7-M guard does.
private struct Bottom64
    unused: u32

impl Protection for Bottom64
    guard(*self, base: usize, bytes: usize) = ()
    reserved(*self, base: usize, bytes: usize) -> usize = 64

private var unit: Granular = Granular(6, 0, 0)
private var call_port: CallPort = CallPort(0)
private var bottom: Bottom64 = Bottom64(0)

@align(32)
private var stack_user: [64]u32 = [0; 64]
@align(32)
private var stack_other: [64]u32 = [0; 64]
@align(32)
private var shared: [64]u8 = [0; 64]
@align(32)
private var readable: [64]u8 = [0; 64]
@align(32)
private var code: [64]u8 = [0; 64]
@align(32)
private var registers: [32]u8 = [0; 32]
@align(32)
private var kernel_bytes: [64]u8 = [0; 64]

private var ring: StreamBuffer[16] = StreamBuffer([0; 16], 0, 0, 1)
private var other_ring: StreamBuffer[16] = StreamBuffer([0; 16], 0, 0, 1)

private never_runs() -> never
    loop
        ()

private at(bytes: []u8) -> usize = usize(&bytes[0])

// The map every test's unprivileged task gets: a shared buffer it may write, one it may only read,
// code, and a device's registers.
private grants() -> [4]Region
    [Region(at(shared), 64, Access.ReadWrite), Region(at(readable), 64, Access.Read), Region(at(code), 64, Access.Execute), Region(at(registers), 32, Access.Device)]

// A privileged task 0 and an unprivileged task 1 granted `ring` (handle 0) but not `other_ring`
// (handle 1); task 1 is the running one. Answers its index.
private one_user() -> usize
    isolate(&unit)
    protect(&bottom)
    val h = share(&ring)
    val _ = share(&other_ring)
    spawn(&call_port, stack_other, &never_runs, 2, "privileged")
    val g = grants()
    val i = spawn_unprivileged(&call_port, stack_user, &never_runs, 2, "user", g[0..<4], [h]) match
        Ok(n) -> n
        Err(_) -> panic("a map that fits was refused")
    scheduler.running = i
    i

// A trap's frame: eight register-sized words.
private const FRAME: usize = 8 * sizeof(usize)

private stack_region() -> Region = Region(usize(&stack_user[0]), 256, Access.ReadWrite)

@test("a map holds the stack first, then the creator's regions, each as the unit encodes it")
map_is_built()
    val g = grants()
    val m = build_map(&unit, stack_region(), g[0..<4]) match
        Ok(m) -> m
        Err(_) -> panic("refused")
    assert_eq(m.len, 5)
    assert_eq(m.regions[0].base, usize(&stack_user[0]))
    assert_eq(m.slots[0].second, 256)
    assert_eq(m.regions[3].base, at(code))
    assert_eq(m.slots[4].second, 32)

@test("a map is refused, naming the region and the reason, when the unit cannot hold it")
maps_are_refused()
    val s = stack_region()
    val g = grants()
    var small = Granular(3, 0, 0)
    assert(build_map(&small, s, g[0..<4]).unwrap_err() == MapError.TooManyRegions)
    assert(build_map(&small, s, g[0..<2]).is_ok())
    val odd_stack = Region(usize(&stack_user[0]) + 4, 128, Access.ReadWrite)
    assert(build_map(&unit, odd_stack, []).unwrap_err() == MapError.Stack(RegionError.Unaligned))
    val odd: [2]Region = [g[0], Region(at(readable) + 8, 32, Access.Read)]
    assert(build_map(&unit, s, odd[0..<2]).unwrap_err() == MapError.Bad(1, RegionError.Unaligned))
    val empty: [1]Region = [Region(at(shared), 0, Access.Read)]
    assert(build_map(&unit, s, empty[0..<1]).unwrap_err() == MapError.Bad(0, RegionError.Empty))
    val twice: [3]Region = [g[1], g[0], Region(at(shared) + 32, 32, Access.Read)]
    assert(build_map(&unit, s, twice[0..<3]).unwrap_err() == MapError.Overlap(1, 2))
    val on_stack: [2]Region = [g[0], Region(usize(&stack_user[0]) + 64, 32, Access.Read)]
    assert(build_map(&unit, s, on_stack[0..<2]).unwrap_err() == MapError.OverlapsStack(1))

@test("an unprivileged task is added with its map and its objects; a refused one is not added at all")
spawning_unprivileged()
    val i = one_user()
    assert(scheduler.tasks[i].user)
    assert(!scheduler.tasks[0].user)
    assert_eq(maps[i].len, 5)
    assert_eq(maps[i].objects, 1)
    val count = scheduler.count
    val g = grants()
    assert(spawn_unprivileged(&call_port, stack_user, &never_runs, 2, "no such object", g[0..<1], [2]) == Err(MapError.NoSuchObject(2)))
    val bad: [1]Region = [Region(at(shared) + 1, 32, Access.ReadWrite)]
    assert(spawn_unprivileged(&call_port, stack_user, &never_runs, 2, "unaligned", bad[0..<1], []) == Err(MapError.Bad(0, RegionError.Unaligned)))
    assert_eq(scheduler.count, count)

@test("a buffer is reachable only wholly inside one region whose access allows the call")
buffers_are_checked()
    val i = one_user()
    val s = at(shared)
    assert(may_reach(i, s, 64, true))
    assert(may_reach(i, s + 10, 20, false))
    assert(!may_reach(i, s + 56, 16, true))                 // straddles the end of the shared buffer
    assert(!may_reach(i, s - 8, 16, false))                 // straddles its start
    assert(!may_reach(i, at(kernel_bytes), 8, false))       // outside every region
    assert(may_reach(i, at(kernel_bytes), 0, true))         // nothing at all is reached
    assert(may_reach(i, at(readable), 64, false))
    assert(!may_reach(i, at(readable), 1, true))            // read-only
    assert(may_reach(i, at(code), 16, false))
    assert(!may_reach(i, at(code), 16, true))               // code is never written
    assert(!may_reach(i, at(registers), 4, false))          // a device is never a buffer
    assert(!may_reach(i, at(registers), 4, true))
    assert(!may_reach(i, usize::Max - 3, 8, false))         // runs past the top of memory
    assert(!may_reach(i, usize::Max - 3, 8, true))

@test("an unprivileged task's stack is a buffer above the guard, and never in it")
stack_buffers()
    val i = one_user()
    val base = usize(&stack_user[0])
    assert(may_reach(i, base + 64, 192, true))
    assert(!may_reach(i, base + 60, 8, true))
    assert(!may_reach(i, base, 4, false))
    assert(!may_reach(i, base + 200, 64, false))            // past the top

@test("a privileged task may hand the kernel any buffer")
privileged_buffers()
    val _ = one_user()
    assert(may_reach(0, at(kernel_bytes), 64, true))

@test("a buffer across two adjacent regions that each allow it is refused")
adjacent_regions()
    isolate(&unit)
    val two: [2]Region = [Region(at(shared), 32, Access.ReadWrite), Region(at(shared) + 32, 32, Access.ReadWrite)]
    val i = spawn_unprivileged(&call_port, stack_user, &never_runs, 2, "two", two[0..<2], []) match
        Ok(n) -> n
        Err(_) -> panic("refused")
    assert(may_reach(i, at(shared), 32, true))
    assert(may_reach(i, at(shared) + 32, 32, true))
    assert(!may_reach(i, at(shared) + 16, 32, true))

@test("a switch loads an unprivileged task's map, and empties the unit once for a privileged task after it")
switch_loads_maps()
    val i = one_user()
    scheduler.running = 0
    isolate_running()
    assert_eq(unit.loads, 0)                // privileged after privileged: nothing to do
    scheduler.running = i
    isolate_running()
    assert_eq(unit.loads, 1)
    assert_eq(unit.loaded, 5)
    scheduler.running = 0
    isolate_running()
    assert_eq(unit.loads, 2)
    assert_eq(unit.loaded, 0)
    isolate_running()
    assert_eq(unit.loads, 2)
    assert(!running_unprivileged())
    scheduler.running = i
    assert(running_unprivileged())

@test("a trap's frame is decoded from the task's own stack: four arguments, then the call's number")
frames_are_decoded()
    val i = one_user()
    // The frame a trap leaves near the top of the stack, in register-sized words: r0-r3, r12, then
    // lr, pc and xPSR.
    val f: *usize = ptr_cast(&stack_user[32])
    f[0] = 11
    f[1] = 22
    f[2] = 33
    f[3] = 44
    f[4] = 7
    f[5] = 0xdead
    assert(begin_call(usize(f), FRAME, 32))
    assert(scheduler.tasks[i].calling)
    assert(!running_unprivileged())
    val c = maps[i].call
    assert_eq(c.args[0], 11)
    assert_eq(c.args[3], 44)
    assert_eq(c.number, 7)
    assert(!begin_call(usize(f), FRAME, 32))    // already in a call
    assert(end_call())
    assert(!end_call())                          // the task's own return, with no call in flight
    assert(running_unprivileged())

@test("a frame outside the task's own stack, or with no room below it above the guard, is refused")
frames_are_bounded()
    val _ = one_user()
    val base = usize(&stack_user[0])
    assert(!begin_call(at(shared), FRAME, 32))   // in a buffer the task may write, not its stack
    assert(!begin_call(base + 256 - FRAME + 8, FRAME, 32))  // runs past the top
    assert(!begin_call(base + 80, FRAME, 32))    // the room below it reaches into the guard
    assert(!begin_call(base + 32, FRAME, 0))     // in the guard itself
    assert(begin_call(base + 96, FRAME, 32))
    assert(end_call())
    assert(begin_call(base + 256 - FRAME, FRAME, 32))    // right at the top

@test("a call is run for the task that made it")
calls_are_served()
    val i = one_user()
    val f: *usize = ptr_cast(&stack_user[32])
    f[4] = CALL_SELF
    assert(begin_call(usize(f), FRAME, 32))
    assert_eq(serve_call(), i)

@test("a call's number and handles are checked")
handles_are_checked()
    val i = one_user()
    assert_eq(dispatch(i, CallFrame([0; 4], 99)), REFUSED_CALL)
    assert_eq(dispatch(i, CallFrame([0; 4], CALL_SELF)), i)
    assert_eq(dispatch(i, CallFrame([7, 1, 0, 0], CALL_NOTIFY)), REFUSED_HANDLE)
    assert_eq(dispatch(i, CallFrame([0, 1, 9, 0], CALL_NOTIFY)), REFUSED_ARGUMENT)
    assert_eq(dispatch(i, CallFrame([0, 0x5, 0, 0], CALL_NOTIFY)), 1)
    assert_eq(scheduler.tasks[0].note, 0x5)
    assert_eq(dispatch(i, CallFrame([1, at(shared), 4, 0], CALL_SEND)), REFUSED_HANDLE)    // not granted
    assert_eq(dispatch(i, CallFrame([5, at(shared), 4, 0], CALL_SEND)), REFUSED_HANDLE)    // no such object
    assert_eq(other_ring.available(), 0)

@test("the idle task cannot be notified through a call")
idle_is_not_a_handle()
    val i = one_user()
    scheduler.tasks[0].base = IDLE_PRIORITY
    assert_eq(dispatch(i, CallFrame([0, 1, 0, 0], CALL_NOTIFY)), REFUSED_HANDLE)
    assert_eq(scheduler.tasks[0].note, 0)

@test("a send or receive through a buffer outside the task's map is refused and touches nothing")
buffers_are_refused()
    val i = one_user()
    for k in 0..<64
        kernel_bytes[k] = 0x5a
    assert_eq(dispatch(i, CallFrame([0, at(kernel_bytes), 8, 0], CALL_SEND)), REFUSED_BUFFER)
    assert_eq(ring.available(), 0)
    shared[0] = 1
    shared[1] = 2
    assert_eq(dispatch(i, CallFrame([0, at(shared), 2, 0], CALL_SEND)), 2)
    assert_eq(dispatch(i, CallFrame([0, at(kernel_bytes), 8, 0], CALL_RECEIVE)), REFUSED_BUFFER)
    assert_eq(dispatch(i, CallFrame([0, at(readable), 8, 0], CALL_RECEIVE)), REFUSED_BUFFER)
    assert_eq(dispatch(i, CallFrame([0, at(shared) + 60, 8, 0], CALL_RECEIVE)), REFUSED_BUFFER)
    assert_eq(ring.available(), 2)
    for k in 0..<64
        assert_eq(kernel_bytes[k], 0x5a)
    assert_eq(dispatch(i, CallFrame([0, at(shared) + 32, 8, 0], CALL_RECEIVE)), 2)
    assert_eq(shared[32], 1)
    assert_eq(shared[33], 2)

@test("the statistics are written only into a region the task may write, and only as many rows as are asked")
stats_are_checked()
    val i = one_user()
    assert_eq(dispatch(i, CallFrame([at(kernel_bytes), 1, 0, 0], CALL_TASK_STATS)), REFUSED_BUFFER)
    assert_eq(dispatch(i, CallFrame([at(shared), MAX_TASKS + 1, 0, 0], CALL_TASK_STATS)), REFUSED_ARGUMENT)
    var rows: [2]TaskStats = [NO_STATS; 2]
    // The task's stack is a region it may write, so a buffer there is filled.
    val on_stack = usize(&stack_user[32])
    assert_eq(dispatch(i, CallFrame([on_stack, 1, 0, 0], CALL_TASK_STATS)), 2)
    val row: *TaskStats = ptr_cast(on_stack)
    assert_eq(row.name, "privileged")
    rows[0] = *row
    assert_eq(rows[0].index, 0)
