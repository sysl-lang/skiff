module skiff.kernel
@tests

// Task control on the host: suspend, resume, priority changes and stops, over the recording port
// (kernel_tests.sysl). A host test runs no task, so a call that blocks or switches returns at once, and
// the test then makes the scheduler choose, as the switch would.

private body() -> never
    loop
        ()

private var stacks: [4][128]u32

// A task at `priority` on core 0 of `r`, on stack `n`.
private task_at(r: *Recorder, n: usize, priority: u8) -> Task = create(r, 0, stacks[n], &body, priority).unwrap()

// The switch the port was asked for: the scheduler's choice runs.
private switch_now(r: *Recorder)
    val _ = switch_context(r, 0)

private runs(r: *Recorder, t: Task) -> bool = current(r) == t

// `t`'s wait record.
private record(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// Whether `t` is in its priority's FIFO.
private queued(r: *Recorder, t: Task) -> bool = here(r).sched.queued(t.slot())

// The slots of `q`, best first, written as digits of slot + 1: "312".
private order(q: *WaitQueue) -> u32
    var digits: u32 = 0
    var at = q.first()
    while at != NONE
        digits = digits * 10 + u32(at) + 1
        at = waiter(at).next
    digits

@test("suspending the running task switches away from it, and resuming it brings it back")
suspend_running()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    assert(runs(&r, a), "a runs")
    val before = r.switches
    assert(suspend(&r, a).is_ok(), "suspended")
    assert_eq(r.switches, before + 1)
    assert(!queued(&r, a), "out of its FIFO")
    assert_eq(here(&r).sched.ready & 4, 0)
    switch_now(&r)
    assert(runs(&r, b), "b runs in its place")
    assert(state(&r, a) == Ok(TaskState.Ready), "still ready")
    assert(suspended(&r, a) == Ok(true), "and suspended")
    tick(&r)
    tick(&r)
    assert(runs(&r, b), "ticks do not bring it back")
    assert(resume(&r, a).is_ok(), "resumed")
    assert_eq(r.switches, before + 2)
    assert(suspended(&r, a) == Ok(false), "no longer suspended")
    switch_now(&r)
    assert(runs(&r, a), "it runs again")
    assert_eq(r.masked, 0)

@test("a suspended task that is not running asks for no switch, and its turn among equals is skipped")
suspend_ready()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 1)
    val d = task_at(&r, 2, 1)
    here(&r).sched.first()
    val before = r.switches
    assert(suspend(&r, b).is_ok(), "suspended")
    assert_eq(r.switches, before)
    assert(suspend(&r, b).is_ok(), "twice is once")
    tick(&r)
    switch_now(&r)
    assert(runs(&r, d), "the turn passes b by")
    tick(&r)
    switch_now(&r)
    assert(runs(&r, a), "and comes back round")
    assert(resume(&r, b).is_ok(), "resumed")
    assert_eq(r.switches, before + 2)
    tick(&r)
    switch_now(&r)
    assert(runs(&r, d), "behind the others: d first")
    tick(&r)
    switch_now(&r)
    assert(runs(&r, b), "then b")

@test("resuming a task that was never suspended does nothing")
resume_unsuspended()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    val before = r.switches
    assert(resume(&r, b).is_ok(), "accepted")
    assert(resume(&r, a).is_ok(), "the running task too")
    assert_eq(r.switches, before)
    assert_eq(here(&r).sched.heads[1], u16(a.slot()))
    assert_eq(here(&r).sched.tails[1], u16(b.slot()))
    assert(state(&r, b) == Ok(TaskState.Ready), "ready")

@test("a suspended sleeper wakes ready on its deadline but does not run until resumed")
suspended_sleeper()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    sleep(&r, 2)
    switch_now(&r)
    assert(suspend(&r, a).is_ok(), "suspended while it sleeps")
    for _ in 0..<3
        tick(&r)
    assert(state(&r, a) == Ok(TaskState.Ready), "its sleep ended")
    assert(!queued(&r, a), "but it is not runnable")
    switch_now(&r)
    assert(runs(&r, b), "b runs")
    val before = r.switches
    assert(resume(&r, a).is_ok(), "resumed")
    assert_eq(r.switches, before + 1)
    switch_now(&r)
    assert(runs(&r, a), "it runs")

@test("a suspended task's wait still times out, and it runs only once resumed, answering TimedOut")
suspended_wait_times_out()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, 3)
    switch_now(&r)
    assert(suspend(&r, w).is_ok(), "suspended while it waits")
    assert(state(&r, w) == Ok(TaskState.Blocked), "still waiting")
    for _ in 0..<3
        tick(&r)
    assert(record(w).outcome == Outcome.TimedOut, "the wait timed out")
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert(!queued(&r, w), "not runnable")
    switch_now(&r)
    assert(runs(&r, b), "b runs on")
    assert(resume(&r, w).is_ok(), "resumed")
    switch_now(&r)
    assert(runs(&r, w), "it runs")
    assert(wait_outcome(here(&r)) == Outcome.TimedOut, "and answers TimedOut")
    assert_eq(r.masked, 0)

@test("a suspended task's wait is still given, and the unit is its own when it is resumed")
suspended_wait_given()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, FOREVER)
    switch_now(&r)
    assert(suspend(&r, w).is_ok(), "suspended while it waits")
    val before = r.switches
    assert(s.give(&r), "given")
    assert_eq(s.count, 0)
    assert(record(w).outcome == Outcome.Given, "the unit is its")
    assert_eq(r.switches, before)
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert(!queued(&r, w), "not runnable")
    switch_now(&r)
    assert(runs(&r, b), "b runs on")
    assert(resume(&r, w).is_ok(), "resumed")
    switch_now(&r)
    assert(runs(&r, w), "it runs, given")

@test("resuming a waiting task that was suspended leaves it waiting, and the wake runs it")
resume_blocked()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, FOREVER)
    switch_now(&r)
    assert(suspend(&r, w).is_ok(), "suspended")
    val before = r.switches
    assert(resume(&r, w).is_ok(), "resumed")
    assert_eq(r.switches, before)
    assert(state(&r, w) == Ok(TaskState.Blocked), "still waiting")
    assert(record(w).outcome == Outcome.Waiting, "its wait goes on")
    assert(!queued(&r, w), "not runnable")
    switch_now(&r)
    assert(runs(&r, b), "b runs on")
    assert(s.give(&r), "given")
    assert_eq(r.switches, before + 1)
    switch_now(&r)
    assert(runs(&r, w), "the give runs it")

@test("a lowered running task gives way, and a raised ready task takes over")
priority_switches()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 3)
    val b = task_at(&r, 1, 2)
    here(&r).sched.first()
    val before = r.switches
    assert(set_priority(&r, a, 1).is_ok(), "lowered")
    assert_eq(r.switches, before + 1)
    assert(priority(&r, a) == Ok(1), "runs at 1")
    switch_now(&r)
    assert(runs(&r, b), "b takes over")
    assert(set_priority(&r, a, 5).is_ok(), "raised")
    assert_eq(r.switches, before + 2)
    switch_now(&r)
    assert(runs(&r, a), "a takes over")
    assert_eq(here(&r).sched.heads[5], u16(a.slot()))
    assert_eq(here(&r).sched.ready & 2, 0)
    assert(set_priority(&r, b, 4).is_ok(), "b raised, still below a")
    assert_eq(r.switches, before + 2)
    assert_eq(r.masked, 0)

@test("a waiting task whose priority changes moves in its object's queue, and is given first")
priority_resorts_waiter()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 3)
    val a = task_at(&r, 0, 3)
    val b = task_at(&r, 1, 2)
    val d = task_at(&r, 2, 2)
    val _ = task_at(&r, 3, 1)
    here(&r).sched.first()
    for _ in 0..<3
        val _ = s.take(&r, FOREVER)
        switch_now(&r)
    assert_eq(order(&s.w.queue), 123)
    assert(set_priority(&r, d, 4).is_ok(), "raised")
    assert_eq(order(&s.w.queue), 312)
    assert_eq(record(d).priority, 4)
    assert(set_priority(&r, a, 1).is_ok(), "lowered")
    assert_eq(order(&s.w.queue), 321)
    assert(s.give(&r), "given")
    assert(record(d).outcome == Outcome.Given, "to the raised waiter")
    assert(record(b).outcome == Outcome.Waiting, "not to the first come")
    assert_eq(r.masked, 0)

@test("a mutex holder keeps an inherited priority through changes of its base, and drops it with the mutex")
priority_keeps_boost()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val high = task_at(&r, 1, 3)
    switch_now(&r)
    val _ = m.lock(&r, FOREVER)
    switch_now(&r)
    assert(runs(&r, low), "the boosted owner")
    assert(priority(&r, low) == Ok(3), "boosted")
    assert(set_priority(&r, low, 2).is_ok(), "base raised below the boost")
    assert(priority(&r, low) == Ok(3), "the boost holds")
    assert(set_priority(&r, low, 1).is_ok(), "base lowered")
    assert(priority(&r, low) == Ok(3), "the boost still holds")
    assert(set_priority(&r, low, 5).is_ok(), "base raised above the boost")
    assert(priority(&r, low) == Ok(5), "the base wins")
    assert(set_priority(&r, low, 2).is_ok(), "base lowered again")
    assert(priority(&r, low) == Ok(3), "the boost is back")
    m.unlock(&r)
    assert(priority(&r, low) == Ok(2), "the base it was given last, once it holds no mutex")
    assert(m.holder() == high, "handed over")

@test("a boost lent under a higher base is kept for when the base drops")
boost_under_base()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val owner = task_at(&r, 0, 4)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val waiter2 = task_at(&r, 1, 2)
    assert(suspend(&r, owner).is_ok(), "the owner steps aside")
    switch_now(&r)
    assert(runs(&r, waiter2), "the waiter runs")
    assert(resume(&r, owner).is_ok(), "the owner is back")
    val _ = m.lock(&r, FOREVER)
    switch_now(&r)
    assert(priority(&r, owner) == Ok(4), "its base outranks the waiter")
    assert(set_priority(&r, owner, 1).is_ok(), "base dropped")
    assert(priority(&r, owner) == Ok(2), "it runs at the waiter's priority")
    m.unlock(&r)
    assert(priority(&r, owner) == Ok(1), "and at its base once it lets go")

@test("a stopped waiter leaves its object's queue, is handed nothing, and its timeout does nothing")
stop_waiter()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, 4)
    switch_now(&r)
    val before = r.switches
    assert(stop(&r, w).is_ok(), "stopped")
    assert_eq(r.switches, before)
    assert(state(&r, w) == Ok(TaskState.Stopped), "Stopped")
    assert_eq(s.w.queue.first(), NONE)
    assert(record(w).outcome != Outcome.Waiting, "its wait is over")
    assert(s.give(&r), "given")
    assert_eq(s.count, 1)
    for _ in 0..<6
        tick(&r)
    assert_eq(here(&r).sched.expiring, NONE)
    assert_eq(here(&r).sched.timeouts, NONE)
    assert(state(&r, w) == Ok(TaskState.Stopped), "still Stopped")
    assert(resume(&r, w).is_ok(), "a resume is accepted")
    assert(suspend(&r, w).is_ok(), "and a suspend")
    assert(stop(&r, w).is_ok(), "and a second stop")
    assert(set_priority(&r, w, 6).is_ok(), "and a priority")
    assert(state(&r, w) == Ok(TaskState.Stopped), "and it stays Stopped")
    assert_eq(here(&r).sched.ready & 0x40, 0)
    assert_eq(r.masked, 0)

@test("a stopped ready task and a stopped sleeper leave their lists")
stop_ready_and_sleeper()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 2)
    val b = task_at(&r, 1, 2)
    val d = task_at(&r, 2, 1)
    here(&r).sched.first()
    sleep(&r, 3)
    switch_now(&r)
    assert(runs(&r, b), "b runs")
    assert(stop(&r, a).is_ok(), "the sleeper stopped")
    assert_eq(here(&r).sched.timeouts, NONE)
    val before = r.switches
    assert(stop(&r, b).is_ok(), "the running task stops itself")
    assert_eq(r.switches, before + 1)
    assert_eq(here(&r).sched.ready & 4, 0)
    assert(here(&r).sched.free_slot() != Some(b.slot()), "its slot is not given out before the switch")
    switch_now(&r)
    assert(runs(&r, d), "d runs")
    for _ in 0..<5
        tick(&r)
    assert(runs(&r, d), "the sleeper never wakes")
    assert(state(&r, a) == Ok(TaskState.Stopped), "Stopped")

@test("a stopped mutex holder keeps its mutex, and its waiter times out")
stop_holder()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val high = task_at(&r, 1, 3)
    switch_now(&r)
    val _ = m.lock(&r, 2)
    switch_now(&r)
    assert(stop(&r, low).is_ok(), "the holder stopped")
    assert(m.holder() == low, "it keeps the mutex")
    tick(&r)
    tick(&r)
    switch_now(&r)
    assert(runs(&r, high), "the waiter runs")
    assert(wait_outcome(here(&r)) == Outcome.TimedOut, "having timed out")
    assert(m.holder() == low, "still the stopped task's")

@test("a stopped task keeps its slot until none is free, then the slot is reused and its handle is stale")
stop_slot_reused()
    var r = recorder(1, 0)
    val first = task_at(&r, 0, 1)
    here(&r).sched.first()
    var victim = first
    for k in 1..<option_tasks
        val t = create(&r, 0, stacks[1], &body, 1).unwrap()
        if k == 3 then victim = t
    assert(create(&r, 0, stacks[2], &body, 1) == Err(TaskError.Full), "full")
    assert(stop(&r, victim).is_ok(), "stopped")
    assert(state(&r, victim) == Ok(TaskState.Stopped), "its handle answers Stopped")
    val again = create(&r, 0, stacks[2], &body, 2).unwrap()
    assert_eq(again.slot(), victim.slot())
    assert(again.generation() != victim.generation(), "a new generation")
    assert(state(&r, victim) == Err(TaskError.Stale), "the stopped task's handle is stale")
    assert(stop(&r, victim) == Err(TaskError.Stale), "and stops nothing")
    assert(state(&r, again) == Ok(TaskState.Ready), "the new task is ready")
    assert(suspended(&r, again) == Ok(false), "not suspended")
    assert(priority(&r, again) == Ok(2), "at its own priority")

@test("a free slot is reused before a stopped task's")
free_before_stopped()
    var r = recorder(1, 0)
    val a = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 1)
    val d = task_at(&r, 2, 1)
    here(&r).sched.first()
    assert(stop(&r, b).is_ok(), "b stopped")
    assert(delete(&r, d).is_ok(), "d deleted")
    val again = task_at(&r, 3, 1)
    assert_eq(again.slot(), d.slot())
    assert(state(&r, b) == Ok(TaskState.Stopped), "b keeps its slot")
    assert(runs(&r, a), "a runs")

@test("a stopped task, deleted, frees its slot")
stop_then_delete()
    var r = recorder(1, 0)
    val _ = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    assert(stop(&r, b).is_ok(), "stopped")
    assert(delete(&r, b).is_ok(), "deleted")
    assert(state(&r, b) == Err(TaskError.Stale), "gone")
    assert_eq(here(&r).sched.free_slot(), Some(b.slot()))

@test("a suspended task stopped is Stopped, not suspended, and leaves no trace in the ready set")
stop_suspended()
    var r = recorder(1, 0)
    val _ = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 2)
    here(&r).sched.first()
    switch_now(&r)
    assert(runs(&r, b), "b runs")
    assert(suspend(&r, b).is_ok(), "suspended")
    switch_now(&r)
    assert(stop(&r, b).is_ok(), "stopped")
    assert(suspended(&r, b) == Ok(false), "not suspended")
    assert(resume(&r, b).is_ok(), "a resume")
    assert(state(&r, b) == Ok(TaskState.Stopped), "Stopped")
    assert_eq(here(&r).sched.ready & 4, 0)

@test("the idle task is neither suspended, resumed, given a priority nor stopped")
idle_refused()
    var r = recorder(1, 0)
    val _ = task_at(&r, 0, 1)
    val c = here(&r)
    val i = c.sched.free_slot().unwrap()
    c.sched.add_on(i, stacks[1], 0, IDLE_PRIORITY)
    val idle = c.sched.handle(0, i)
    assert(suspend(&r, idle) == Err(TaskError.Idle), "suspend")
    assert(resume(&r, idle) == Err(TaskError.Idle), "resume")
    assert(set_priority(&r, idle, 3) == Err(TaskError.Idle), "priority")
    assert(stop(&r, idle) == Err(TaskError.Idle), "stop")
    assert(state(&r, idle) == Ok(TaskState.Ready), "untouched")
    assert(c.sched.queued(i), "in its FIFO")

@test("a stale handle, the handle 0 and a core the machine lacks are refused by every control call")
stale_refused()
    var r = recorder(1, 0)
    val _ = task_at(&r, 0, 1)
    val b = task_at(&r, 1, 1)
    here(&r).sched.first()
    assert(delete(&r, b).is_ok(), "deleted")
    for t in [b, NO_TASK, task_handle(1, 1, 1)]
        assert(suspend(&r, t) == Err(TaskError.Stale), "suspend")
        assert(resume(&r, t) == Err(TaskError.Stale), "resume")
        assert(set_priority(&r, t, 3) == Err(TaskError.Stale), "priority")
        assert(stop(&r, t) == Err(TaskError.Stale), "stop")
    val again = task_at(&r, 1, 1)
    assert_eq(again.slot(), b.slot())
    assert(suspend(&r, b) == Err(TaskError.Stale), "stale after reuse")
    assert(suspended(&r, again) == Ok(false), "the new task untouched")
    assert(set_priority(&r, again, 0) == Err(TaskError.Priority), "0 is the idle task's")
    assert(set_priority(&r, again, 32) == Err(TaskError.Priority), "32 is out of range")
    assert(priority(&r, again) == Ok(1), "unchanged")
    assert_eq(r.masked, 0)
