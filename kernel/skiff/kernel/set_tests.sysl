module skiff.kernel
@tests

// Queue sets on the host, over the recording port (kernel_tests.sysl). A host test runs no task, so a
// select that blocks returns at once, with the task blocked; the test reads what its wait ended with,
// which is what the task answers when it runs again.

private qs_spin() -> never
    loop
        ()

private var qs_stacks: [3][128]u32

// A task at `priority` on core 0 of `r`, on stack `i`.
private qs_task(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, qs_stacks[i], &qs_spin, priority).unwrap()

// `t`'s wait record.
private qs_wait(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// ---- joining and leaving ----

@test("a semaphore in a set posts a notice naming it when given, and a select takes it")
qs_give_posts()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 4)
    assert(s.join(&r, &set) == Ok(0), "the first member is index 0")
    assert_eq(set.notices(&r), 0)
    assert(set.try_select(&r) == None, "nothing available, no notice")
    assert(s.give(&r), "given")
    assert_eq(set.notices(&r), 1)
    assert(set.try_select(&r) == Some(0), "the notice names the semaphore")
    assert(s.try_take(&r), "the try finds the unit")
    assert(set.try_select(&r) == None, "the notice was taken")
    assert_eq(r.masked, 0)

@test("a join answers the lowest free index, and a leave frees its index for the next join")
qs_lowest_index()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var a = Semaphore.new("a", 0, 1)
    var b = Semaphore.new("b", 0, 1)
    var c = Semaphore.new("c", 0, 1)
    var d = Semaphore.new("d", 0, 1)
    assert(a.join(&r, &set) == Ok(0), "a")
    assert(b.join(&r, &set) == Ok(1), "b")
    assert(c.join(&r, &set) == Ok(2), "c")
    assert_eq(set.size(&r), 3)
    assert(b.leave(&r) == Ok(()), "b leaves")
    assert_eq(set.size(&r), 2)
    assert(d.join(&r, &set) == Ok(1), "d takes b's index")
    assert(b.join(&r, &set) == Ok(3), "b joins again, after the others")

@test("an object in a set may not join a second, and stays in its first")
qs_second_set_refused()
    var r = recorder(1, 0)
    var first = QueueSet.new("first")
    var second = QueueSet.new("second")
    var s = Semaphore.new("s", 0, 1)
    assert(s.join(&r, &first) == Ok(0), "joined")
    assert(s.join(&r, &second) == Err(SetError.Joined), "refused")
    assert(s.join(&r, &first) == Err(SetError.Joined), "nor the same one twice")
    assert_eq(second.size(&r), 0)
    assert(s.give(&r), "given")
    assert(first.try_select(&r) == Some(0), "the first set hears of it")
    assert(second.try_select(&r) == None, "the second does not")
    assert_eq(r.masked, 0)

@test("a set holds 32 members, and refuses a 33rd without changing")
qs_full_set_refused()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var members = [Semaphore.new("m", 0, 1); 33]
    for i in 0..<32
        assert(members[i].join(&r, &set) == Ok(u8(i)), "joined")
    assert_eq(set.size(&r), 32)
    assert(members[32].join(&r, &set) == Err(SetError.Full), "the 33rd is refused")
    assert_eq(set.size(&r), 32)
    assert(members[32].give(&r), "given")
    assert_eq(set.notices(&r), 0)
    assert(members[31].give(&r), "the last member")
    assert(set.try_select(&r) == Some(31), "is heard")

@test("an object in no set may not leave one, nor leave twice")
qs_leave_not_joined()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    assert(s.leave(&r) == Err(SetError.NotJoined), "never joined")
    assert(s.join(&r, &set) == Ok(0), "joined")
    assert(s.leave(&r) == Ok(()), "left")
    assert(s.leave(&r) == Err(SetError.NotJoined), "left already")
    assert_eq(r.masked, 0)

@test("a leave withdraws the member's queued notice, and the set hears no more of it")
qs_leave_withdraws()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 4)
    assert(s.join(&r, &set) == Ok(0), "joined")
    assert(s.give(&r), "given")
    assert_eq(set.notices(&r), 1)
    assert(s.leave(&r) == Ok(()), "left")
    assert_eq(set.notices(&r), 0)
    assert(set.try_select(&r) == None, "no notice")
    assert(s.give(&r), "given again")
    assert(set.try_select(&r) == None, "still none")

@test("a leave from the middle of the notices keeps the others in order")
qs_leave_middle()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var a = Semaphore.new("a", 0, 1)
    var b = Semaphore.new("b", 0, 1)
    var c = Semaphore.new("c", 0, 1)
    assert(a.join(&r, &set).is_ok() && b.join(&r, &set).is_ok() && c.join(&r, &set).is_ok(), "joined")
    assert(c.give(&r) && a.give(&r) && b.give(&r), "given: c, a, b")
    assert(a.leave(&r) == Ok(()), "a leaves")
    assert(set.try_select(&r) == Some(2), "c first")
    assert(set.try_select(&r) == Some(1), "then b")
    assert(set.try_select(&r) == None, "and no more")

@test("a leave of the oldest notice makes the next the oldest, and of the only one empties the set")
qs_leave_head()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var a = Semaphore.new("a", 0, 1)
    var b = Semaphore.new("b", 0, 1)
    assert(a.join(&r, &set).is_ok() && b.join(&r, &set).is_ok(), "joined")
    assert(a.give(&r) && b.give(&r), "given")
    assert(a.leave(&r) == Ok(()), "the oldest leaves")
    assert(set.try_select(&r) == Some(1), "b is next")
    assert(b.try_take(&r) && b.give(&r), "taken and given again: b's notice is queued")
    assert_eq(set.notices(&r), 1)
    assert(b.leave(&r) == Ok(()), "the only one leaves")
    assert_eq(set.notices(&r), 0)
    assert(a.join(&r, &set) == Ok(0), "a joins again")
    assert(a.try_take(&r) && set.try_select(&r) == Some(0), "a still held its unit, so it was heard at the join")
    assert(a.give(&r), "given")
    assert(set.try_select(&r) == Some(0), "a set emptied by a leave takes notices again")

@test("joining while available posts a notice at once; joining while not posts none")
qs_join_available()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var full = Semaphore.new("full", 1, 1)
    var empty = Semaphore.new("empty", 0, 1)
    assert(empty.join(&r, &set) == Ok(0), "empty joins")
    assert_eq(set.notices(&r), 0)
    assert(full.join(&r, &set) == Ok(1), "full joins")
    assert(set.try_select(&r) == Some(1), "heard at once")
    assert(full.try_take(&r), "and taken")

@test("a member posts at most one notice however often it is given")
qs_one_notice_per_member()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 4)
    var t = Semaphore.new("t", 0, 4)
    assert(s.join(&r, &set).is_ok() && t.join(&r, &set).is_ok(), "joined")
    for _ in 0..<3
        assert(s.give(&r), "given")
    assert(t.give(&r), "t given")
    assert(s.give(&r), "s given a fourth time")
    assert_eq(set.notices(&r), 2)
    assert(set.try_select(&r) == Some(0), "s, once")
    assert(set.try_select(&r) == Some(1), "then t")
    assert(set.try_select(&r) == None, "no more")

@test("a take that leaves units posts the notice again, and one that takes the last posts none")
qs_take_reposts()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 4)
    assert(s.join(&r, &set).is_ok(), "joined")
    assert(s.give(&r) && s.give(&r), "two")
    assert(set.try_select(&r) == Some(0), "heard")
    assert(s.try_take(&r), "one taken, one left")
    assert(set.try_select(&r) == Some(0), "heard again, for the one left")
    assert(s.try_take(&r), "the last taken")
    assert(set.try_select(&r) == None, "nothing left, nothing heard")

@test("notices leave in the order their members became available")
qs_fifo()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var m = [Semaphore.new("m", 0, 1); 3]
    for i in 0..<3
        assert(m[i].join(&r, &set).is_ok(), "joined")
    assert(m[2].give(&r) && m[0].give(&r) && m[1].give(&r), "given: 2, 0, 1")
    assert(set.try_select(&r) == Some(2), "2")
    assert(m[2].give(&r) == false, "2 is full")
    assert(m[2].try_take(&r) && m[2].give(&r), "2 taken and given again: behind the others")
    assert(set.try_select(&r) == Some(0), "0")
    assert(set.try_select(&r) == Some(1), "1")
    assert(set.try_select(&r) == Some(2), "2 again")

@test("a notice is a hint: when another took the unit first, the try fails")
qs_hint()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    assert(s.join(&r, &set).is_ok(), "joined")
    assert(s.give(&r), "given")
    assert(s.try_take(&r), "another takes it first")
    assert(set.try_select(&r) == Some(0), "the notice is still there")
    assert(!s.try_take(&r), "but the unit is not")
    assert(set.try_select(&r) == None, "and nothing more")

@test("a give handed to a task waiting on the semaphore itself posts no notice")
qs_handover_posts_nothing()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    assert(s.join(&r, &set).is_ok(), "joined")
    val taker = qs_task(&r, 0, 2)
    val _ = qs_task(&r, 1, 1)
    here(&r).sched.first()
    assert(!s.take(&r, FOREVER), "the taker waits")
    assert(s.give(&r), "given to the taker")
    assert(qs_wait(taker).outcome == Outcome.Given, "handed over")
    assert_eq(set.notices(&r), 0)
    assert_eq(r.masked, 0)

@test("an object in .shared may join only a set in .shared")
qs_placement()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    val at = usize(&s)
    shared_bounds(at, at + sizeof(Semaphore))
    val refused = s.join(&r, &set)
    shared_bounds(0, 0)
    assert(refused == Err(SetError.Placement), "a set outside .shared is refused")
    assert_eq(set.size(&r), 0)
    assert(s.join(&r, &set) == Ok(0), "neither in .shared: joined")
    assert(s.leave(&r).is_ok(), "left")
    val low = if usize(&s) < usize(&set) then usize(&s) else usize(&set)
    val high = if usize(&s) < usize(&set) then usize(&set) + sizeof(QueueSet) else usize(&s) + sizeof(Semaphore)
    shared_bounds(low, high)
    val both = s.join(&r, &set)
    val given = s.give(&r)
    val heard = set.try_select(&r)
    shared_bounds(0, 0)
    assert(both == Ok(0), "both in .shared: joined")
    assert(given && heard == Some(0), "and heard through its place")

@test("a member names its set by place, and a set below .shared's start is reached through it")
qs_place_below()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    val start = usize(&set) + sizeof(QueueSet)
    shared_bounds(start, start)
    val joined = s.join(&r, &set)
    val place = s.link.place
    val given = s.give(&r)
    val heard = set.try_select(&r)
    shared_bounds(0, 0)
    assert(joined == Ok(0), "joined")
    assert_eq(place, 0 -% sizeof(QueueSet))
    assert(given && heard == Some(0), "heard")

// ---- selecting ----

@test("a select with no notice blocks, and a member becoming available hands it the notice")
qs_select_blocks()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var a = Semaphore.new("a", 0, 1)
    var b = Semaphore.new("b", 0, 1)
    assert(a.join(&r, &set).is_ok() && b.join(&r, &set).is_ok(), "joined")
    val selector = qs_task(&r, 0, 2)
    val _ = qs_task(&r, 1, 1)
    here(&r).sched.first()
    val before = r.switches
    assert(set.select(&r, FOREVER) == None, "nothing yet, so it waits")
    assert(state(&r, selector) == Ok(TaskState.Blocked), "blocked")
    assert_eq(r.switches, before + 1)
    val _ = switch_context(&r, 0)
    assert(b.give(&r), "b given")
    assert(qs_wait(selector).outcome == Outcome.Given, "handed the notice")
    assert_eq(qs_wait(selector).value, 1)
    assert(state(&r, selector) == Ok(TaskState.Ready), "ready")
    assert_eq(set.notices(&r), 0)
    assert(a.give(&r), "a given, with nobody waiting")
    assert(set.try_select(&r) == Some(0), "a's notice is queued")
    assert_eq(r.masked, 0)

@test("a notice goes to the best of several selectors, first come within a priority")
qs_best_selector()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 4)
    assert(s.join(&r, &set).is_ok(), "joined")
    val low = qs_task(&r, 0, 1)
    val high = qs_task(&r, 1, 2)
    val _ = qs_task(&r, 2, 1)
    here(&r).sched.first()
    assert(current(&r) == high, "high runs")
    assert(set.select(&r, FOREVER) == None, "high waits")
    val _ = switch_context(&r, 0)
    assert(current(&r) == low, "low runs")
    assert(set.select(&r, FOREVER) == None, "low waits")
    val _ = switch_context(&r, 0)
    assert(s.give(&r), "given")
    assert(qs_wait(high).outcome == Outcome.Given, "high has it")
    assert(qs_wait(low).outcome == Outcome.Waiting, "low still waits")
    assert(s.try_take(&r), "the unit")
    assert(s.give(&r), "another")
    assert(qs_wait(low).outcome == Outcome.Given, "low has the next")
    assert_eq(set.notices(&r), 0)
    assert(s.give(&r), "and another, with nobody waiting")
    assert_eq(set.notices(&r), 1)

@test("a timed select nobody posts to ends TimedOut, and a later post is queued")
qs_select_times_out()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    assert(s.join(&r, &set).is_ok(), "joined")
    val selector = qs_task(&r, 0, 2)
    val _ = qs_task(&r, 1, 1)
    here(&r).sched.first()
    assert(set.select(&r, 2) == None, "waits")
    val _ = switch_context(&r, 0)
    tick(&r)
    assert(qs_wait(selector).outcome == Outcome.Waiting, "still waiting after 1 tick")
    tick(&r)
    assert(qs_wait(selector).outcome == Outcome.TimedOut, "timed out on the second")
    assert(s.give(&r), "given")
    assert(qs_wait(selector).outcome == Outcome.TimedOut, "still timed out")
    assert(set.try_select(&r) == Some(0), "the notice is queued")

@test("a select with a timeout of 0 never waits, and an interrupt handler may take a notice")
qs_try_select()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    assert(s.join(&r, &set).is_ok(), "joined")
    assert(set.select(&r, 0) == None, "nothing, at once")
    assert(s.give(&r), "given from a handler")
    assert(set.select(&r, 0) == Some(0), "taken from a handler")
    assert_eq(r.switches, 0)
    assert_eq(r.masked, 0)

// ---- each kind of member ----

@test("a queue posts when a message is sent, again when a receive leaves more, never for a kept message")
qs_queue()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var q: Queue[u32, 3] = Queue.new("q")
    assert(q.join(&r, &set) == Ok(0), "joined")
    assert(q.try_send(&r, 1) && q.try_send(&r, 2), "two sent")
    assert(set.try_select(&r) == Some(0), "heard once")
    assert(set.try_select(&r) == None, "once")
    assert(q.try_receive(&r) == Some(1), "one received, one left")
    assert(set.try_select(&r) == Some(0), "heard again")
    assert(q.try_receive(&r) == Some(2), "the last")
    assert(set.try_select(&r) == None, "nothing left")
    val rx = qs_task(&r, 0, 2)
    val _ = qs_task(&r, 1, 1)
    here(&r).sched.first()
    assert(q.receive(&r, FOREVER) == None, "a receiver waits on the queue itself")
    assert(q.try_send(&r, 3), "sent to it")
    assert(qs_wait(rx).outcome == Outcome.Given, "kept for it")
    assert_eq(set.notices(&r), 0)
    assert_eq(r.masked, 0)

@test("a queue holding a message when it joins posts at once")
qs_queue_join_available()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var q: Queue[u32, 2] = Queue.new("q")
    assert(q.try_send(&r, 5), "sent before the join")
    assert(q.join(&r, &set) == Ok(0), "joined")
    assert(set.try_select(&r) == Some(0), "heard")
    assert(q.try_receive(&r) == Some(5), "received")

@test("event flags post when a set names bits, and not when a set names none, a clear or a wait")
qs_flags()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var f = Flags.new("f", 0)
    assert(f.join(&r, &set) == Ok(0), "joined")
    val _ = f.set(&r, 0)
    assert_eq(set.notices(&r), 0)
    val _ = f.set(&r, 0x5)
    assert(set.try_select(&r) == Some(0), "heard")
    assert(f.wait(&r, 0x2, false, false, 0) == None, "not the bit wanted, and the bits stay up")
    assert_eq(set.notices(&r), 0)
    assert(f.wait(&r, 0x1, false, false, 0) == Some(0x5), "a bit wanted, not cleared")
    assert_eq(set.notices(&r), 0)
    val _ = f.clear(&r, 0x5)
    assert_eq(set.notices(&r), 0)
    val _ = f.set(&r, 0x1)
    val _ = f.set(&r, 0x1)
    assert_eq(set.notices(&r), 1)
    assert(set.try_select(&r) == Some(0), "a set of a bit already up is heard too")
    assert_eq(r.masked, 0)

@test("event flags with a bit up when they join post at once, and with none, not")
qs_flags_join()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var up = Flags.new("up", 0x8)
    var down = Flags.new("down", 0)
    assert(down.join(&r, &set) == Ok(0), "down")
    assert(up.join(&r, &set) == Ok(1), "up")
    assert(set.try_select(&r) == Some(1), "up is heard")
    assert(set.try_select(&r) == None, "down is not")

@test("a stream posts once its trigger level is met, again when a read leaves the level, and when the level is lowered to what is there")
qs_stream()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s: StreamBuffer[8] = StreamBuffer.new("s", 3)
    var got: [8]u8 = [0; 8]
    assert(s.join(&r, &set) == Ok(0), "joined")
    val two: [2]u8 = [1, 2]
    assert_eq(s.try_send(&r, two[..]), 2)
    assert_eq(set.notices(&r), 0)
    assert_eq(s.try_send(&r, two[..]), 2)
    assert(set.try_select(&r) == Some(0), "4 bytes, past the level of 3")
    assert_eq(s.try_receive(&r, got[..<1]), 1)
    assert(set.try_select(&r) == Some(0), "3 left, the level still met")
    assert_eq(s.try_receive(&r, got[..<1]), 1)
    assert_eq(set.notices(&r), 0)
    assert(s.set_trigger(&r, 2), "the level lowered to the 2 there")
    assert(set.try_select(&r) == Some(0), "heard")
    assert(s.set_trigger(&r, 4), "raised")
    assert_eq(set.notices(&r), 0)
    assert_eq(r.masked, 0)

@test("a stream at its level when it joins posts at once, and one below it, not")
qs_stream_join()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var below: StreamBuffer[8] = StreamBuffer.new("below", 2)
    var at: StreamBuffer[8] = StreamBuffer.new("at", 2)
    val one: [1]u8 = [1]
    val two: [2]u8 = [1, 2]
    assert_eq(below.try_send(&r, one[..]), 1)
    assert_eq(at.try_send(&r, two[..]), 2)
    assert(below.join(&r, &set) == Ok(0), "below")
    assert(at.join(&r, &set) == Ok(1), "at")
    assert(set.try_select(&r) == Some(1), "at is heard")
    assert(set.try_select(&r) == None, "below is not")

@test("a message buffer posts for a message, again when a receive leaves another, not for the last")
qs_message_buffer()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var mb: MessageBuffer[32] = MessageBuffer.new("mb")
    var got: [8]u8 = [0; 8]
    assert(mb.join(&r, &set) == Ok(0), "joined")
    val m: [3]u8 = [7, 8, 9]
    assert(mb.try_send(&r, m[..]) && mb.try_send(&r, m[..<1]), "two messages")
    assert(set.try_select(&r) == Some(0), "heard once")
    assert(set.try_select(&r) == None, "once")
    assert_eq(mb.try_receive(&r, got[..]), 3)
    assert(set.try_select(&r) == Some(0), "the second is heard")
    assert_eq(mb.try_receive(&r, got[..]), 1)
    assert(set.try_select(&r) == None, "nothing left")
    assert(mb.leave(&r) == Ok(()), "left through the stream under it")
    assert(mb.leave(&r) == Err(SetError.NotJoined), "and only once")

@test("a channel posts when a buffer is sent through it, as the queue under it does")
qs_channel()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var pool: Pool[2, 16] = Pool.new("pool", 1)
    var ch: Channel[2] = Channel.new("ch")
    assert(ch.join(&r, &set) == Ok(0), "joined")
    val b = pool.try_take(&r).unwrap()
    assert(ch.try_send(&r, &pool, b).is_ok(), "sent")
    assert(set.try_select(&r) == Some(0), "heard")
    assert(ch.try_receive(&r, &pool).is_some(), "received")
    assert(set.try_select(&r) == None, "nothing left")
    assert(ch.join(&r, &set) == Err(SetError.Joined), "a second join refused")
    assert(ch.leave(&r) == Ok(()), "left")

@test("members of every kind share one set, each heard by its own index, in the order they became available")
qs_mixed()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    var s = Semaphore.new("s", 0, 1)
    var q: Queue[u32, 2] = Queue.new("q")
    var f = Flags.new("f", 0)
    var st: StreamBuffer[8] = StreamBuffer.new("st", 1)
    assert(s.join(&r, &set) == Ok(0) && q.join(&r, &set) == Ok(1) && f.join(&r, &set) == Ok(2) && st.join(&r, &set) == Ok(3), "joined")
    val one: [1]u8 = [1]
    assert_eq(st.try_send(&r, one[..]), 1)
    val _ = f.set(&r, 1)
    assert(q.try_send(&r, 4), "sent")
    assert(s.give(&r), "given")
    assert(set.try_select(&r) == Some(3), "the stream")
    assert(set.try_select(&r) == Some(2), "the flags")
    assert(set.try_select(&r) == Some(1), "the queue")
    assert(set.try_select(&r) == Some(0), "the semaphore")
    assert_eq(set.size(&r), 4)

@test("a select is traced as a take and a block on the set")
qs_traced()
    var r = recorder(1, 0)
    var set = QueueSet.new("set")
    val _ = qs_task(&r, 0, 2)
    val _ = qs_task(&r, 1, 1)
    here(&r).sched.first()
    r.events.start()
    assert(set.select(&r, 5) == None, "waits")
#if option_trace
    assert_eq(r.events.count(), 2)
    assert_eq(u8(r.events.event(0).kind), u8(TraceKind.Take))
    assert_eq(u8(r.events.event(1).kind), u8(TraceKind.Blocked))
    assert(r.events.event(1).object == TraceObject.Set && r.events.event(1).at == usize(&set.w), "the set")
#else
    assert_eq(r.events.count(), 0)
#endif
