module skiff.kernel

import sysl.sync.Lock

// Waiting: the one primitive every object waits through.
//
// A task waits on at most one thing at a time, so each task has one `Waiter` record, in `.shared` at
// `waiters[core][slot]`. An object keeps its waiters in a `WaitQueue`, linked through the records by
// index, never by pointer: highest priority first, first come first within a priority. Queueing a
// waiter, taking the best one and withdrawing any one are each a few steps, however many wait. A task's
// notification, which only its own task waits for, keeps room for that one waiter instead (`Waited`).
//
// A wait, under the object's lock: answer at once if the object can, else fill the record (`Waiting`),
// enqueue it, block the task on its core (and in its timeout list if the wait has a deadline), release
// the lock and switch. The task answers from the record's `outcome` when it runs again.
//
// A wake, under the object's lock: take the best waiter, set its outcome (`Given` when the object hands
// itself over, as a semaphore or a mutex does), and make the task ready: on the waker's own core at once,
// on another by a message to that core's inbox (inbox.sysl). Only a waiter still `Waiting`
// is ever taken, and a timeout also ends a wait only under the lock and only if it is still `Waiting`.
// So exactly one transition leaves `Waiting`: a timeout after a wake does nothing, and a wake after a
// timeout finds the waiter gone.

// How a wait ended. `Idle` is 0, which is what `.shared` holds once it is zeroed at start-up.
enum Outcome: u8
    Idle = 0        // no wait yet, or one withdrawn when its task was deleted
    Waiting = 1     // the wait is on
    Woken = 2       // the object woke the task, handing it nothing
    Given = 3       // the object handed itself over: a unit of a semaphore, a mutex
    TimedOut = 4    // the deadline came first

// One task's wait record. `prev` and `next` link it into the FIFO of its side and priority in an
// object's queue; `queued` says whether it is in one, so a record of zeros is in none.
struct Waiter
    task: Task          // whose record it is
    value: u32          // what the wait asks for, and then what it carries back
    prev: u16           // the waiter before it in its FIFO, which is circular: the head's is the tail
    next: u16           // the waiter after it in its FIFO: the tail's is the head
    priority: u8        // the task's effective priority when it was queued
    outcome: Outcome
    side: u8            // which of its object's two lists it waits in: a queue's senders or receivers
    queued: bool        // whether it is in a queue's FIFO
    mode: u8            // the terms of the wait, as its object reads them: a flags wait's

// The index of task `slot` of core `core`'s record: `core * option_tasks + slot`. At most 8 cores of
// 4096 slots, so it fits in a `u16` with NONE left over.
private[kernel] waiter_index(core: u32, slot: usize) -> u16 = u16(usize(core) * option_tasks + slot)

// How many sides an object's waiters may wait on. A queue's senders and receivers are its two; most
// objects use side 0 alone.
private[kernel] const SIDES: usize = 2

// An object's waiters, as the scheduler keeps its ready tasks: for each side, a FIFO per priority,
// circular through the records' `prev` and `next`, and a `u32` bitmap of the priorities whose FIFO has
// a waiter. Queueing, leaving and finding a side's best waiter are each a few steps whatever the number
// of waiters. A head is read only when its bit is set, so a queue of zeros is empty.
struct WaitQueue
    bits: [SIDES]u32
    heads: [SIDES][PRIORITIES]u16
    count: u16

// The highest priority set in `bits`, which is not 0.
private top(bits: u32) -> usize = usize(31 - bits.leading_zeros())

impl WaitQueue
    // The best waiter, or NONE when nobody waits: the head of the highest priority of either side, the
    // first side's on a tie. An object whose waiters all wait on one side asks this; one with two asks
    // `first_of`.
    first(*self) -> u16
        if self.bits[1] == 0 || (self.bits[0] != 0 && top(self.bits[0]) >= top(self.bits[1])) then self.first_of(0) else self.first_of(1)

    // The best waiter on side `side`, or NONE.
    first_of(*self, side: u8) -> u16
        val bits = self.bits[side]
        if bits == 0 then NONE else self.heads[side][top(bits)]

    // The waiter after `at`, which is queued here, on its side: the next of its priority, else the head
    // of the next priority down that has a waiter, else NONE. What a walk of the whole queue uses.
    after(*self, at: u16) -> u16
        val r = waiter(at)
        if r.next != self.heads[r.side][r.priority] then return r.next
        val below = self.bits[r.side] & ((1 << u32(r.priority)) - 1)
        if below == 0 then NONE else self.heads[r.side][top(below)]

    // Queue waiter `w` at the tail of its side's FIFO for its priority.
    insert(*self, w: u16)
        val r = waiter(w)
        val s = usize(r.side)
        val p = usize(r.priority)
        if self.bits[s] & (1 << u32(p)) == 0
            self.heads[s][p] = w
            r.prev = w
            r.next = w
            self.bits[s] |= 1 << u32(p)
        else
            val head = self.heads[s][p]
            val tail = waiter(head).prev
            r.prev = tail
            r.next = head
            waiter(tail).next = w
            waiter(head).prev = w
        r.queued = true
        self.count += 1

    // Take waiter `w`, which is queued here if it is queued at all, out of the queue, answering whether
    // it was in it.
    remove(*self, w: u16) -> bool
        val r = waiter(w)
        if !r.queued then return false
        val s = usize(r.side)
        val p = usize(r.priority)
        if r.next == w
            self.bits[s] &= ~(1 << u32(p))
        else
            waiter(r.prev).next = r.next
            waiter(r.next).prev = r.prev
            if self.heads[s][p] == w then self.heads[s][p] = r.next
        r.prev = NONE
        r.next = NONE
        r.queued = false
        self.count -= 1
        true

// What a wait is on, as the one wait primitive reaches it: a lock and the waiters it guards. Every
// object is a `Waitable`, with any number of waiters; a task's notification, which only its own task
// ever waits for, is a `LoneWaitable`, with one or none. A blocked task's `Tcb.on` names what it waits
// on, so that a timeout, a priority change or a delete can reach the waiters under the lock. The lock is
// each one's first field, so its address is the object's, which is what a trace names it by.
trait Waited
    // The lock its waiters are under.
    guard(*self) -> *KernelLock

    // Queue waiter `w`.
    enter(*self, w: u16)

    // Take waiter `w` out, if it is queued here, answering whether it was.
    leave(*self, w: u16) -> bool

    // The best waiter, or NONE when nobody waits.
    best(*self) -> u16

// What every object holds to be waited on: its lock and its waiters.
struct Waitable
    lock: KernelLock
    queue: WaitQueue

impl Waitable
    const new(name: string) -> Waitable = Waitable(KernelLock.new(name), WaitQueue([0; SIDES], [[NONE; PRIORITIES]; SIDES], 0))

impl Waited for Waitable
    guard(*self) -> *KernelLock = &self.lock
    enter(*self, w: u16)
        self.queue.insert(w)
    leave(*self, w: u16) -> bool = self.queue.remove(w)
    best(*self) -> u16 = self.queue.first()

// A lock and room for one waiter: what a task's notification holds, since only its own task waits on
// it, and a task waits on one thing at a time. A second waiter while one waits is the kernel's own
// error, and stops it. Of zeros it is unlocked and empty, as `.shared` starts.
struct LoneWaitable
    lock: KernelLock
    at: u16             // the waiter's index, while `held`
    held: bool          // whether a waiter is in it

impl Waited for LoneWaitable
    guard(*self) -> *KernelLock = &self.lock
    enter(*self, w: u16)
        if self.held then panic("skiff: a second waiter on an object only one task waits on")
        self.at = w
        self.held = true
        waiter(w).queued = true
    leave(*self, w: u16) -> bool
        if !self.held || self.at != w then return false
        self.held = false
        waiter(w).queued = false
        true
    best(*self) -> u16 = if self.held then self.at else NONE

// Whether a task of core `core` is another core's than `me`'s. With one core it never is.
private[kernel] another_core(core: u32, me: u32) -> bool = option_cores > 1 && core != me

// The running task of core `c` waits on `w`, whose lock the caller holds: fill its record with the
// wait's `side`, `mode` and `value`, queue it and block it, for `timeout` ticks or `FOREVER`. The caller
// then asks for a switch and releases the lock, which lets the switch happen, and reads the outcome with
// `wait_outcome` once the task runs again.
private[kernel] enqueue_running[W: Waited](c: *Core, w: *W, timeout: u32, side: u8, mode: u8, value: u32)
    val i = usize(c.sched.running)
    val r = waiter(waiter_index(c.id, i))
    r.task = c.sched.handle(c.id, i)
    r.priority = c.sched.tasks[i].priority
    r.outcome = Outcome.Waiting
    r.side = side
    r.mode = mode
    r.value = value
    w.enter(waiter_index(c.id, i))
    c.sched.block(w, timeout, ticks())

// How the running task's last wait ended.
private[kernel] wait_outcome(c: *Core) -> Outcome = waiter(waiter_index(c.id, usize(c.sched.running))).outcome

// What the running task's last wait carried back.
private[kernel] wait_value(c: *Core) -> u32 = waiter(waiter_index(c.id, usize(c.sched.running))).value

// Under `w`'s lock, end the wait of its best waiter with `outcome` and make that task ready, asking for
// a switch if it outranks the running one. Answers the task, or None when nobody waits.
private[kernel] wake_first[P: Port, W: Waited](p: *P, w: *W, outcome: Outcome) -> Option[Task]
    val at = w.best()
    if at == NONE then None else Some(wake_at(p, w, at, outcome))

// Under `w`'s lock, end the wait of waiter `at`, which is in `w`'s queue, with `outcome`, and make its
// task ready, asking for a switch if it outranks the running one. Answers the task.
private[kernel] wake_at[P: Port, W: Waited](p: *P, w: *W, at: u16, outcome: Outcome) -> Task = end_wait(p, w, at, outcome, MessageKind.Wake, IDLE_PRIORITY)

// `wake_at`, where a task of another core is told by a message of `kind` at `priority` to its core's
// inbox, which makes it ready there: the waker's core never touches another core's scheduler.
private[kernel] end_wait[P: Port, W: Waited](p: *P, w: *W, at: u16, outcome: Outcome, kind: MessageKind, priority: u8) -> Task
    val r = waiter(at)
    val c = here(p)
    val _ = w.leave(at)
    r.outcome = outcome
    if another_core(r.task.core(), c.id)
        post(p, kind, r.task, priority, null)
    else if c.sched.wake(r.task.slot())
        p.request_switch()
#if option_trace
    if !another_core(r.task.core(), c.id) then trace_task(p, TraceKind.Ready, TraceObject.Nothing, usize(w.guard()), r.task, 0)
#endif
    r.task

// End the waits that `tick` found expired, each under its object's lock: one still `Waiting` leaves the
// queue as `TimedOut` and its task is made ready; one a wake has already ended is left as it is. Answers
// whether a task made ready outranks the running one.
private[kernel] end_expired_waits[P: Port](p: *P, c: *Core) -> bool
    var outranks = false
    loop
        val state = p.mask()
        val i = c.sched.take_expiring()
        p.restore(state)
        if i == NONE then return outranks
        c.sched.tasks[usize(i)].on match
            Some(w) -> if time_out(p, c, w, usize(i)) then outranks = true
            None -> ()

// The timeout of task `i`'s wait on `w`.
private time_out[P: Port](p: *P, c: *Core, w: *Waited, i: usize) -> bool
    val at = waiter_index(c.id, i)
    var l = w.guard().on(p)
    l.acquire()
    var outranks = false
    if waiter(at).outcome == Outcome.Waiting
        val _ = w.leave(at)
        waiter(at).outcome = Outcome.TimedOut
        outranks = c.sched.wake(i)
#if option_trace
        trace_task(p, TraceKind.TimedOut, TraceObject.Nothing, usize(w.guard()), waiter(at).task, 0)
        trace_task(p, TraceKind.Ready, TraceObject.Nothing, usize(w.guard()), waiter(at).task, 0)
#endif
    l.release()
    outranks

// Withdraw task `i`'s wait, if it is waiting, before the task is deleted: its record leaves the object's
// queue, so no wake can find it.
private[kernel] withdraw[P: Port](p: *P, c: *Core, i: usize)
    if c.sched.tasks[i].state != TaskState.Blocked then return
    c.sched.tasks[i].on match
        Some(w) ->
            val at = waiter_index(c.id, i)
            var l = w.guard().on(p)
            l.acquire()
            if waiter(at).outcome == Outcome.Waiting
                val _ = w.leave(at)
                waiter(at).outcome = Outcome.Idle
            l.release()
        None -> ()

// Task `i` of core `c` inherits `priority` from a waiter on a mutex it holds: it keeps the boost, and
// runs at it, re-queued among its own object's waiters if it waits, while the boost is above its base.
// The caller holds no object's lock.
private[kernel] inherit[P: Port](p: *P, c: *Core, i: usize, priority: u8)
    val e = c.sched.inherit(i, priority)
    if e > c.sched.tasks[i].priority then reprioritize(p, c, i, e)

// Make `priority` the effective priority of task `i` of the running core, re-queueing it among its
// object's waiters, under that object's lock, if it is waiting. The caller holds no object's lock.
private[kernel] reprioritize[P: Port](p: *P, c: *Core, i: usize, priority: u8)
    c.sched.set_effective(i, priority)
    if c.sched.tasks[i].state != TaskState.Blocked then return
    c.sched.tasks[i].on match
        Some(w) ->
            val at = waiter_index(c.id, i)
            var l = w.guard().on(p)
            l.acquire()
            if waiter(at).outcome == Outcome.Waiting && w.leave(at)
                waiter(at).priority = priority
                w.enter(at)
            l.release()
        None -> ()
