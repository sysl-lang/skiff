module skiff.kernel
@tests

import sysl.sync.Atomic

// The kernel on the host, over a port that records what it is asked to write and how many switches it
// is asked for. Every boot test on a board checks the same banner through a real console.

private[kernel] struct Recorder
    bytes: [256]u8
    used: usize
    count: u32
    me: u32
    hz: u32
    switches: u32       // how many switches the kernel has asked for
    masked: u32         // how deep the kernel's masking is nested
    cleans: u32         // how many cleans the kernel asked for
    invalidates: u32    // how many invalidates
    cleaned_at: usize           // the address of the last clean's bytes
    cleaned_len: usize          // how many there were
    invalidated_at: usize       // the address of the last invalidate's bytes
    invalidated_len: usize      // how many there were
    pool: *Pool[2, 32]          // a pool to look at on each clean and invalidate (null: none)
    channel: *Channel[1]        // a channel to look at likewise (null: none)
    free_then: u32      // what `pool` had available at the last clean or invalidate
    waiting_then: u32   // what `channel` held at the last clean or invalidate
    guards: u32         // how many stacks the kernel guarded
    guarded: usize      // the base of the last one
    loads: u32          // how many maps the kernel loaded, empty ones among them
    loaded: usize       // how many regions the last one had
    unprivileged: bool  // the privilege the kernel last set
    unit: usize         // how many regions a map may take on its unit
    reserve: usize      // the bytes at the bottom of every stack its guard takes
    clock: u32          // the core's counter, moved by hand
    context_words: usize    // how many words the stack the last new context was laid on had
    watchdog_ticks: u32     // what the hardware watchdog was last started at (0: never)
    feeds: u32              // how many times it was fed
    watchdog_stops: u32     // how many times it was stopped
    masks: u32              // how many times the kernel masked, nested ones among them
    skip_limit: u32         // the most ticks a sleep with the tick stopped may span (0: the tick never stops)
    wake_after: u32         // how many ticks such a sleep lasts before an interrupt ends it (FOREVER: none comes)
    asked: u32              // the ticks the last such sleep was asked to span (0: none was)
    events: TraceRing[64]   // the events the kernel emitted, once a test starts it

// A hardware watchdog that counts what it is asked.
impl Watchdog for Recorder
    start_watchdog(*self, ticks: u32)
        self.watchdog_ticks = ticks

    feed_watchdog(*self)
        self.feeds += 1

    stop_watchdog(*self)
        self.watchdog_stops += 1

// The counter is whatever the test last set it to.
impl RunCounter for Recorder
    run_count(*self) -> u32 = self.clock

// A protection unit that records what it is asked. It holds a region whose base and size are multiples of
// 32 bytes, as PMSAv8 does, as the two words base and size.
impl Protection for Recorder
    guard(*self, base: usize, bytes: usize)
        self.guards += 1
        self.guarded = base

    reserved(*self, base: usize, bytes: usize) -> usize = self.reserve

impl Isolation for Recorder
    capacity(*self) -> usize = self.unit

    encode(*self, r: Region) -> Result[Slot, RegionError]
        if r.bytes == 0 then return Err(RegionError.Empty)
        if r.base % 32 != 0 || r.bytes % 32 != 0 then return Err(RegionError.Unaligned)
        Ok(Slot(u32(r.base & 0xffff_ffff), u32(r.bytes)))

    load(*self, map: []const Slot)
        self.loads += 1
        self.loaded = map.len

    privilege(*self, unprivileged: bool)
        self.unprivileged = unprivileged

// A data cache that records what it is asked and, at that step, how full the watched pool and channel
// are: what tells whether a buffer was cleaned before it could be seen and invalidated after it was taken.
// It keeps where the bytes were and how many, not the view: a port is lent the bytes for the call only.
impl Cache for Recorder
    clean(*self, bytes: []const u8)
        self.cleans += 1
        self.cleaned_at = usize(&bytes[0])
        self.cleaned_len = bytes.len
        self.look()

    invalidate(*self, bytes: []u8)
        self.invalidates += 1
        self.invalidated_at = usize(&bytes[0])
        self.invalidated_len = bytes.len
        self.look()

impl Recorder
    private look(*self)
        if self.pool != null then self.free_then = self.pool.available(self)
        if self.channel != null then self.waiting_then = self.channel.waiting(self)

// The recorder's tick is taken by hand: `idle` takes one, as a real core's sleep ends at its tick. A new
// task's context is only its stack's address, which is what the kernel keeps as its stack pointer.
impl Port for Recorder
    write(*self, bytes: []const u8)
        for b in bytes
            self.bytes[self.used] = b
            self.used += 1

    cores(*self) -> u32 = self.count

    core_id(*self) -> u32 = self.me

    start_ticks(*self, hz: u32)
        self.hz = hz

    idle(*self)
        tick(self)

    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize
        self.context_words = stack.len
        usize(&stack[0])

    request_switch(*self)
        self.switches += 1

    start_first(*self, sp: usize) -> never = panic("the host runs no task")

    mask(*self) -> u32
        self.masked += 1
        self.masks += 1
        self.masked - 1

    restore(*self, state: u32)
        self.masked = state

    // One core: the kernel never spins, so these are never asked.
    spin_lock(*self, word: *Atomic[u32]) = panic("one core never spins")
    spin_try_lock(*self, word: *Atomic[u32]) -> bool = panic("one core never spins")
    spin_unlock(*self, word: *Atomic[u32]) = panic("one core never spins")

    // A sleep with the tick stopped spans the ticks it was asked, or `wake_after` if an interrupt comes
    // sooner. The test moves the counter by hand.
    override tickless_limit(*self) -> u32 = self.skip_limit

    override sleep_ticks(*self, count: u32) -> u32
        self.asked = count
        if self.wake_after < count then self.wake_after else count

    override trace(*self, event: TraceEvent) = self.events.record(event)

// One core: the kernel has no other core to ring.
impl Doorbell for Recorder
    ring(*self, core: u32) = panic("one core never rings")
    clear(*self) = panic("one core never rings")

private[kernel] recorder(cores: u32, me: u32) -> Recorder = Recorder([0; 256], 0, cores, me, 0, 0, 0, 0, 0, 0, 0, 0, 0, null, null, 0, 0, 0, 0, 0, 0, false, 8, 0, 0, 0, 0, 0, 0, 0, 0, FOREVER, 0, TraceRing.new())

// Whether `r` recorded exactly `want`.
private[kernel] recorded(r: *Recorder, want: string) -> bool
    val w = want.bytes
    if r.used != w.len then return false
    for i in 0..<w.len
        if r.bytes[i] != w[i] then return false
    true

@test("a single-core boot prints the plain banner and answers 0")
boot_single_core()
    var r = recorder(1, 0)
    assert_eq(boot(&r), 0)
    assert(recorded(&r, "skiff: hello\n"), "the banner")

@test("a multi-core boot names the core it runs on")
boot_names_the_core()
    var r = recorder(2, 1)
    assert_eq(boot(&r), 0)
    assert(recorded(&r, "skiff: hello from core 1\n"), "the banner with the core")

@test("write_dec writes zero, one digit, and the largest u32")
dec_digits()
    var r = recorder(1, 0)
    write_dec(&r, 0)
    write_dec(&r, 7)
    write_dec(&r, 4294967295)
    assert(recorded(&r, "074294967295"), "decimal digits")

@test("write_hex writes eight digits whatever the value")
hex_digits()
    var r = recorder(1, 0)
    write_hex(&r, 0)
    write_hex(&r, 0x0000_8200)
    write_hex(&r, 0xdead_beef)
    assert(recorded(&r, "0x000000000x000082000xdeadbeef"), "hexadecimal digits")

@test("a deadline has come when it is now or past, and not before")
deadline_either_side()
    assert(expired(100, 100), "a deadline of now")
    assert(expired(100, 101), "a deadline one tick past")
    assert(!expired(101, 100), "a deadline one tick ahead")
    assert(!expired(0x7fff_ffff, 0), "a deadline 2^31 - 1 ticks ahead")

@test("a deadline compares across the counter's wrap")
deadline_across_wrap()
    // 0xffff_fffe + 7 wraps to 5: seven ticks ahead, then reached, then passed.
    assert(!expired(5, 0xffff_fffe), "a deadline past the wrap is still ahead")
    assert(!expired(5, 0xffff_ffff), "one tick before the wrap")
    assert(!expired(5, 4), "one tick before the deadline, after the wrap")
    assert(expired(5, 5), "the deadline, after the wrap")
    assert(expired(0xffff_ffff, 2), "a deadline before the wrap, seen after it")

private[kernel] fresh_core(id: u32, own: u32, seen: u32) -> Core = Core(id, Atomic(own), seen, false, EMPTY_SCHEDULER, [NO_MAP; option_tasks], false, 0, 0, 0, 0)

@test("a tick advances the time base unless another core's has since this core's last, whichever core it is")
a_tick_advances_time_unless_another_did()
    var time: Atomic[u32] = Atomic(0)
    var first = fresh_core(0, 0, 0)
    var second = fresh_core(1, 0, 0)
    first.tick(&time)
    assert_eq(time.load(), 1)
    // Core 1's last tick (none) saw 0, and core 0 has advanced it since: this period is taken.
    second.tick(&time)
    assert_eq(time.load(), 1)
    assert_eq(second.time_seen, 1)
    // Nobody has advanced it since core 1's last tick: core 1 does, without core 0.
    second.tick(&time)
    assert_eq(time.load(), 2)
    first.tick(&time)
    assert_eq(time.load(), 2)
    assert_eq(first.time_seen, 2)
    assert_eq(first.own_ticks(), 2)
    assert_eq(second.own_ticks(), 2)

@test("the time base wraps from the largest u32 to 0")
time_base_wraps()
    var time: Atomic[u32] = Atomic(0xffff_ffff)
    var first = fresh_core(0, 0xffff_ffff, 0xffff_ffff)
    first.tick(&time)
    assert_eq(time.load(), 0)
    assert_eq(first.own_ticks(), 0)
    assert_eq(first.time_seen, 0)

// The cores tests cannot set the time base near its wrap (it is the kernel's), so the wrap across several
// cores is played here, on `Core`s of the test's own over a time base of its own.
@test("the time base wraps from the largest u32 to 0 on whichever of three cores takes the period")
time_wraps_across_cores()
    var time: Atomic[u32] = Atomic(0xffff_fffe)
    var a = fresh_core(0, 7, 3)
    var b = fresh_core(1, 9, 3)
    var c = fresh_core(2, 1, 3)
    // Every core's view is stale: core 1 records the time base, then advances it.
    b.tick(&time)
    assert_eq(time.load(), 0xffff_fffe)
    b.tick(&time)
    assert_eq(time.load(), 0xffff_ffff)
    val deadline = time.load() +% 2
    a.tick(&time)
    c.tick(&time)
    b.tick(&time)
    assert_eq(time.load(), 0)
    assert(!expired(deadline, time.load()), "one period before the deadline, after the wrap")
    c.tick(&time)
    a.tick(&time)
    b.tick(&time)
    assert_eq(time.load(), 1)
    assert(expired(deadline, time.load()), "the deadline, after the wrap")

@test("with one core, here() is the one Core and never asks the machine")
here_on_one_core()
    var r = recorder(1, 5)
    assert_eq(option_cores, 1)
    val c = here(&r)
    assert_eq(c.id, 0)
    assert(c == here(&r), "the same Core every time")

@test("start announces the core ready and starts its tick at tick_hz")
start_announces_ready()
    var r = recorder(1, 0)
    assert(!ready(0), "not ready before start")
    start(&r)
    assert(ready(0), "ready after start")
    assert(!stopped(0), "not stopped")
    assert_eq(r.hz, option_tick_hz)

@test("await_tick idles until the core's next tick, which on core 0 moves the time base")
await_tick_counts()
    var r = recorder(1, 0)
    start(&r)
    assert_eq(await_tick(&r), 1)
    assert_eq(await_tick(&r), 2)
    assert_eq(ticks(), 2)
    assert_eq(here(&r).own_ticks(), 2)

@test("a fault is reported naming the core and its kind, and the core is seen stopped")
fault_reports_and_stops()
    var r = recorder(1, 0)
    start(&r)
    fault(&r, "BusFault")
    assert(recorded(&r, "skiff: core 0 fault BusFault\n"), "the fault report")
    assert(stopped(0), "stopped")
    assert(!ready(0), "no longer ready")
    assert(here(&r).stopped, "the Core says so")

@test("the shared tables are sized by the cores option: one core has a state and no inboxes")
shared_sizes()
    assert_eq(option_cores, 1)
    assert_eq(INBOX_CORES, 0)
    assert_eq(core_state(0), CORE_OFFLINE)

@test("the shared state is within bounds that hold it, and not within bounds that miss any of it")
shared_placement()
    val at = usize(time_base())
    val bytes = sizeof(Shared)
    assert(shared_within(at, at + bytes), "exactly its own bytes")
    assert(shared_within(at - 64, at + bytes + 64), "a larger section")
    assert(!shared_within(at + 1, at + bytes), "its first byte outside")
    assert(!shared_within(at, at + bytes - 1), "its last byte outside")
    assert(!shared_within(0, 0), "an empty section")
