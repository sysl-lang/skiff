module skiff.kernel

import sysl.sync.Lock

// Stream buffers and message buffers: bytes passed from writers to readers through a ring that is the
// object's own storage, so one in `.shared` carries bytes between cores with no pointer in it.
//
// A `StreamBuffer[N]` carries up to `N` bytes with no boundaries in them. A reader waits until at least
// the trigger level of bytes is there, so a reader of four-byte records is woken once a record, not
// once a byte; a send writes what fits and waits for room for the rest. A `MessageBuffer[N]` is built on
// one and carries whole messages: each lies behind a `MESSAGE_PREFIX` of its length, and is sent and
// received whole or not at all.
//
// Like a queue, each is a plain struct the application declares: laid into the image as constant data
// by `new`, or zeroed in `.shared` and filled in at run time. A zeroed one is empty with a trigger level
// of 1.
//
// Every wait takes a timeout in ticks: `FOREVER`, or 0 for "only what can be done now", which is what
// the `try_` forms are and what an interrupt handler may call. A reader whose timeout comes before the
// trigger level takes whatever is there.
//
// No byte is copied under the lock. A writer claims room under it, copies into the room with the lock
// let go, and takes it again to commit; a reader claims bytes, copies them out, and takes it again to
// give their room back. So every hold of the lock is a constant number of steps, whatever the length.
// Claims are made in ring order, and what they claimed becomes visible in the same order: the bytes
// written are committed, all at once, when the last writer copying commits, and the room read is given
// back when the last reader copying finishes. A reader sees committed bytes only, so it never reads a
// byte a writer has yet to copy, nor half of a message; a writer never writes over a byte a reader is
// still copying.
//
// Readers and writers wait in the one queue of waiters, each marked with its side; a writer's record
// holds the room it needs. Bytes are not kept for a woken task, as a queue keeps a message: a woken
// task takes the lock again and looks, and waits again for what its deadline leaves if another took
// the bytes or the room first. Each hold wakes one waiter at most: a commit the best reader if the
// trigger level is met, a returned room the best writer if the room it needs is there. A woken task's
// own claim wakes the next on its side, if what is left is still enough for it, so the wakes go on one
// per hold; a writer behind one that needs more room than there is waits its turn, so a long message is
// not starved by short ones.

// The side a waiter of a stream is on: its record's side.
private const READING: u8 = 0
private const WRITING: u8 = 1

// The bytes in front of every message in a message buffer: its length, least significant byte first.
const MESSAGE_PREFIX: usize = 4

// The ticks a wait of `timeout` with `deadline` has left: `FOREVER` for ever, else 0 once it is past.
private[kernel] ticks_left(timeout: u32, deadline: u32) -> u32
    if timeout == FOREVER then return FOREVER
    val now = ticks()
    if expired(deadline, now) then 0 else deadline -% now

// What a claim got: `n` bytes of the ring from index `at` (the room to write, or the bytes to read). A
// claim of none is `n` 0 and counts no copier. The claim, copy and commit steps are `private[skiff]`
// rather than `private[kernel]` so the cores tests (`skiff.cores`) can interleave them across cores.
private[skiff] struct Span
    at: usize
    n: usize

// A ring of up to `N` bytes. `N` is at least 1.
struct StreamBuffer[const N: usize]
    w: Waitable
    bytes: [N]u8
    head: usize         // the oldest byte's index whose room is not yet given back
    len: usize          // the committed bytes from `head`, those being read among them
    reading: usize      // the bytes from `head` that readers have claimed and are copying out
    readers: usize      // the readers copying
    writing: usize      // the room past the committed bytes that writers have claimed and are filling
    writers: usize      // the writers copying
    trigger: usize      // the bytes a waiting reader needs; 0 reads as 1
    link: SetLink       // the queue set it has joined, if any

impl[const N: usize] StreamBuffer[N]
    // An empty stream called `name`, whose readers wait for `trigger` bytes (0 means 1, and a level
    // above `N` means `N`).
    const new(name: string, trigger: usize) -> StreamBuffer[N]
        var bytes: [N]u8
        StreamBuffer(Waitable.new(name), bytes, 0, 0, 0, 0, 0, 0, trigger, SetLink.none())

    // Join queue set `set`: from now on the set hears of the stream whenever it holds its trigger level
    // of bytes, at once if it does now. Answers its index in the set. Refused if it is in a set already,
    // if the set is full, or if it lies in `.shared` and the set does not.
    join[P: Port](*self, p: *P, set: *QueueSet) -> Result[u8, SetError]
        var l = self.w.lock.on(p)
        l.acquire()
        val joined = self.link.join(p, set, usize(self), sizeof(StreamBuffer[N]), self.readable() >= self.level())
        l.release()
        joined

    // Leave the queue set it joined, withdrawing its notice there. Refused if it is in none.
    leave[P: Port](*self, p: *P) -> Result[unit, SetError]
        var l = self.w.lock.on(p)
        l.acquire()
        val left = self.link.leave(p)
        l.release()
        left

    // Write as much of `data` as fits, waiting up to `timeout` ticks for room for the rest. Answers how
    // many bytes were written, from 0 to all of them. Only a task may wait; with a timeout of 0 nothing
    // waits.
    send[P: Port](*self, p: *P, data: []const u8, timeout: u32) -> usize
#if option_trace
        trace_running(p, TraceKind.Send, TraceObject.Stream, usize(&self.w), timeout)
#endif
        val deadline = ticks() +% timeout
        var sent: usize = 0
        var last = false
        loop
            var l = self.w.lock.on(p)
            l.acquire()
            val room = self.claim_write(p, data.len - sent)
            if room.n > 0
                // Room given back while this copy ran woke nobody (this writer was not waiting), so
                // after the commit it looks again, under a new hold, before it may wait.
                l.release()
                self.write_at(room.at, data[sent..<sent + room.n])
                l.acquire()
                self.commit_write(p)
                sent += room.n
                l.release()
                if sent == data.len then return sent
                continue
            val left = ticks_left(timeout, deadline)
            if sent == data.len || last || left == 0
                l.release()
                return sent
            val c = running_core(p)
            enqueue_running(c, &self.w, left, WRITING, 0, 1)
#if option_trace
            trace_running(p, TraceKind.Blocked, TraceObject.Stream, usize(&self.w), left)
#endif
            p.request_switch()
            l.release()
            wait_outcome(c) match
                Outcome.Woken -> ()
                Outcome.TimedOut -> last = true
                _ -> return sent

    // Write as much of `data` as fits, without waiting. An interrupt handler may call it.
    try_send[P: Port](*self, p: *P, data: []const u8) -> usize = self.send(p, data, 0)

    // Read up to `buf.len` bytes into `buf`, waiting up to `timeout` ticks for the trigger level. Answers
    // how many were read: once the level is reached, as many as are there and fit; if the timeout comes
    // first, whatever is there, which may be none. Only a task may wait; with a timeout of 0 nothing
    // waits, and whatever is there is read whatever the level.
    receive[P: Port](*self, p: *P, buf: []u8, timeout: u32) -> usize
        if buf.len == 0 then return 0
#if option_trace
        trace_running(p, TraceKind.Receive, TraceObject.Stream, usize(&self.w), timeout)
#endif
        val deadline = ticks() +% timeout
        var last = false
        loop
            var l = self.w.lock.on(p)
            l.acquire()
            val left = ticks_left(timeout, deadline)
            if self.readable() >= self.level() || last || left == 0
                val got = self.claim_read(p, buf.len)
                if got.n == 0
                    l.release()
                    return 0
                l.release()
                self.read_at(got.at, buf[..<got.n])
                l.acquire()
                self.release_read(p)
                l.release()
                return got.n
            val c = running_core(p)
            enqueue_running(c, &self.w, left, READING, 0, 0)
#if option_trace
            trace_running(p, TraceKind.Blocked, TraceObject.Stream, usize(&self.w), left)
#endif
            p.request_switch()
            l.release()
            wait_outcome(c) match
                Outcome.Woken -> ()
                Outcome.TimedOut -> last = true
                _ -> return 0

    // Read whatever is there and fits in `buf`, without waiting. An interrupt handler may call it.
    try_receive[P: Port](*self, p: *P, buf: []u8) -> usize = self.receive(p, buf, 0)

    // Set the trigger level (0 means 1). Answers false, changing nothing, for a level above `N`. A
    // reader already waiting is woken if the new level is met.
    set_trigger[P: Port](*self, p: *P, level: usize) -> bool
        if level > N then return false
        var l = self.w.lock.on(p)
        l.acquire()
        self.trigger = level
        self.wake_reader(p)
        l.release()
        true

    // Empty the ring. Answers false, changing nothing, while a task waits to read or write or anyone is
    // copying in or out.
    reset[P: Port](*self, p: *P) -> bool
        var l = self.w.lock.on(p)
        l.acquire()
        val idle = self.w.queue.count == 0 && self.readers == 0 && self.writers == 0
        if idle
            self.head = 0
            self.len = 0
        l.release()
        idle

    // The committed bytes there to read, those other readers are copying out not among them.
    available[P: Port](*self, p: *P) -> usize
        var l = self.w.lock.on(p)
        l.acquire()
        val n = self.readable()
        l.release()
        n

    // The bytes there is room for, the room writers are filling not among them.
    space[P: Port](*self, p: *P) -> usize
        var l = self.w.lock.on(p)
        l.acquire()
        val n = self.room()
        l.release()
        n

    // How many bytes it holds at most.
    capacity(*self) -> usize = N

    // The bytes a waiting reader needs.
    private[kernel] level(*self) -> usize = if self.trigger == 0 then 1 else if self.trigger > N then N else self.trigger

    // Under the lock: the committed bytes no reader has claimed.
    private[kernel] readable(*self) -> usize = self.len - self.reading

    // Under the lock: the room no writer has claimed.
    private[kernel] room(*self) -> usize = N - self.len - self.writing

    // Index `i` of the ring, for `i` below 2N.
    private[kernel] at(*self, i: usize) -> usize = if i >= N then i - N else i

    // Under the lock: claim the room for up to `want` bytes behind every byte written or being written,
    // counting a writer copying if there is any. Wakes the next writer if the room left is enough for it.
    private[skiff] claim_write[P: Port](*self, p: *P, want: usize) -> Span
        val room = self.room()
        val n = if want < room then want else room
        if n == 0 then return Span(0, 0)
        val claimed = Span(self.at(self.head + self.len + self.writing), n)
        self.writing += n
        self.writers += 1
        self.wake_writer(p)
        claimed

    // With the lock let go: copy `data` into the ring from index `from`, room this caller claimed.
    // `data` is never the ring's own storage.
    @disjoint(data)
    private[skiff] write_at(*self, from: usize, data: []const u8)
        for i in 0..<data.len
            self.bytes[self.at(from + i)] = data[i]

    // Under the lock: a writer's copy is done. The last writer copying commits every byte claimed for
    // writing, and wakes the reader if the trigger level is met; the set it joined hears of it then, once
    // the bytes are in.
    private[skiff] commit_write[P: Port](*self, p: *P)
        self.writers -= 1
        if self.writers > 0 || self.writing == 0 then return
        self.len += self.writing
        self.writing = 0
        self.wake_reader(p)

    // Under the lock: claim up to `want` of the oldest committed bytes no reader has claimed, counting a
    // reader copying if there are any. Wakes the next reader, and tells the set, if what is left still
    // meets the trigger level.
    private[skiff] claim_read[P: Port](*self, p: *P, want: usize) -> Span
        val there = self.readable()
        val n = if want < there then want else there
        if n == 0 then return Span(0, 0)
        val claimed = Span(self.at(self.head + self.reading), n)
        self.reading += n
        self.readers += 1
        self.wake_reader(p)
        claimed

    // With the lock let go: copy the bytes from index `from`, which this caller claimed, into `buf`.
    // `buf` is never the ring's own storage.
    @disjoint(buf)
    private[skiff] read_at(*self, from: usize, buf: []u8)
        for i in 0..<buf.len
            buf[i] = self.bytes[self.at(from + i)]

    // Under the lock: a reader's copy is done. The last reader copying gives back the room of every byte
    // claimed for reading, and wakes the writer that room is enough for.
    private[skiff] release_read[P: Port](*self, p: *P)
        self.readers -= 1
        if self.readers > 0 || self.reading == 0 then return
        self.head = self.at(self.head + self.reading)
        self.len -= self.reading
        self.reading = 0
        self.wake_writer(p)

    // Under the lock: byte `k` from the oldest no reader has claimed, which is there.
    private[kernel] peek(*self, k: usize) -> u8 = self.bytes[self.at(self.head + self.reading + k)]

    // Under the lock: if the trigger level is met, wake the best reader and tell the set it joined.
    private[kernel] wake_reader[P: Port](*self, p: *P)
        if self.readable() < self.level() then return
        val r = self.w.queue.first_of(READING)
        if r != NONE
            val _ = wake_at(p, &self.w, r, Outcome.Woken)
        self.link.notify(p)

    // Under the lock: wake the best writer if the room it needs is there. One wake: the writer's own
    // claim, when it runs, wakes the next.
    private[kernel] wake_writer[P: Port](*self, p: *P)
        val s = self.w.queue.first_of(WRITING)
        if s != NONE && usize(waiter(s).value) <= self.room()
            val _ = wake_at(p, &self.w, s, Outcome.Woken)

// Whole messages through a stream of `N` bytes. Each takes `MESSAGE_PREFIX` bytes more than its own
// length, so the longest that can ever be sent is `N - MESSAGE_PREFIX`. A message is never empty: a
// receive's 0 means there was none. A message's room is claimed whole and its length and bytes are
// committed together, so a reader finds whole messages only.
struct MessageBuffer[const N: usize]
    s: StreamBuffer[N]

impl[const N: usize] MessageBuffer[N]
    // An empty message buffer called `name`.
    const new(name: string) -> MessageBuffer[N] = MessageBuffer(StreamBuffer.new(name, 1))

    // Send `message` whole, waiting up to `timeout` ticks for room for all of it. Answers whether it was
    // sent; an empty message, or one longer than the buffer could ever hold, is refused at once. Only a
    // task may wait; with a timeout of 0 nothing waits.
    send[P: Port](*self, p: *P, message: []const u8, timeout: u32) -> bool
        val need = message.len + MESSAGE_PREFIX
        if message.len == 0 || need > N then return false
#if option_trace
        trace_running(p, TraceKind.Send, TraceObject.Stream, usize(&self.s.w), timeout)
#endif
        val deadline = ticks() +% timeout
        var last = false
        loop
            var l = self.s.w.lock.on(p)
            l.acquire()
            val room = self.claim(p, message.len)
            if room.n > 0
                l.release()
                self.write_message(room, message)
                l.acquire()
                self.s.commit_write(p)
                l.release()
                return true
            val left = ticks_left(timeout, deadline)
            if last || left == 0
                l.release()
                return false
            val c = running_core(p)
            enqueue_running(c, &self.s.w, left, WRITING, 0, u32(need))
#if option_trace
            trace_running(p, TraceKind.Blocked, TraceObject.Stream, usize(&self.s.w), left)
#endif
            p.request_switch()
            l.release()
            wait_outcome(c) match
                Outcome.Woken -> ()
                Outcome.TimedOut -> last = true
                _ -> return false

    // Send `message` whole if there is room now, without waiting. An interrupt handler may call it.
    try_send[P: Port](*self, p: *P, message: []const u8) -> bool = self.send(p, message, 0)

    // Receive the oldest message into `buf`, waiting up to `timeout` ticks for one. Answers its length,
    // or 0 if the timeout came first or `buf` is too short for it, which leaves it to be received. Only
    // a task may wait; with a timeout of 0 nothing waits.
    receive[P: Port](*self, p: *P, buf: []u8, timeout: u32) -> usize
#if option_trace
        trace_running(p, TraceKind.Receive, TraceObject.Stream, usize(&self.s.w), timeout)
#endif
        val deadline = ticks() +% timeout
        var last = false
        loop
            var l = self.s.w.lock.on(p)
            l.acquire()
            val left = ticks_left(timeout, deadline)
            if self.s.readable() > 0 || last || left == 0
                val got = self.claim_oldest(p, buf.len)
                if got.n == 0
                    l.release()
                    return 0
                l.release()
                self.s.read_at(got.at + MESSAGE_PREFIX, buf[..<got.n - MESSAGE_PREFIX])
                l.acquire()
                self.s.release_read(p)
                l.release()
                return got.n - MESSAGE_PREFIX
            val c = running_core(p)
            enqueue_running(c, &self.s.w, left, READING, 0, 0)
#if option_trace
            trace_running(p, TraceKind.Blocked, TraceObject.Stream, usize(&self.s.w), left)
#endif
            p.request_switch()
            l.release()
            wait_outcome(c) match
                Outcome.Woken -> ()
                Outcome.TimedOut -> last = true
                _ -> return 0

    // Receive the oldest message into `buf` if there is one, without waiting. An interrupt handler may
    // call it.
    try_receive[P: Port](*self, p: *P, buf: []u8) -> usize = self.receive(p, buf, 0)

    // The oldest message's length, 0 if there is none.
    next_length[P: Port](*self, p: *P) -> usize
        var l = self.s.w.lock.on(p)
        l.acquire()
        val n = self.length()
        l.release()
        n

    // The longest message there is room for now.
    space[P: Port](*self, p: *P) -> usize
        val free = self.s.space(p)
        if free > MESSAGE_PREFIX then free - MESSAGE_PREFIX else 0

    // Empty the buffer. Answers false, changing nothing, while a task waits to send or receive or anyone
    // is copying in or out.
    reset[P: Port](*self, p: *P) -> bool = self.s.reset(p)

    // Join queue set `set`, as the stream under it does: the set hears of the buffer whenever it holds a
    // message. Answers its index in the set.
    join[P: Port](*self, p: *P, set: *QueueSet) -> Result[u8, SetError] = self.s.join(p, set)

    // Leave the queue set it joined. Refused if it is in none.
    leave[P: Port](*self, p: *P) -> Result[unit, SetError] = self.s.leave(p)

    // Under the lock: claim the room for a message of `length` bytes and its prefix, all of it or none.
    private[skiff] claim[P: Port](*self, p: *P, length: usize) -> Span
        val need = length + MESSAGE_PREFIX
        if self.s.room() < need then return Span(0, 0)
        self.s.claim_write(p, need)

    // With the lock let go: write `message` behind its length into `room`, claimed for it.
    @disjoint(message)
    private[skiff] write_message(*self, room: Span, message: []const u8)
        val n = message.len
        val prefix: [MESSAGE_PREFIX]u8 = [u8(n & 0xff), u8((n >> 8) & 0xff), u8((n >> 16) & 0xff), u8((n >> 24) & 0xff)]
        self.s.write_at(room.at, prefix[..])
        self.s.write_at(room.at + MESSAGE_PREFIX, message)

    // Under the lock: the oldest unclaimed message's length, from its prefix; 0 if there is none.
    private[kernel] length(*self) -> usize
        if self.s.readable() == 0 then return 0
        var n: usize = 0
        for k in 0..<MESSAGE_PREFIX
            n = n | (usize(self.s.peek(k)) << (8 * k))
        n

    // Under the lock: claim the oldest unclaimed message, prefix and all, if it fits in `room` bytes.
    // Answers none if there is none or it does not fit.
    private[skiff] claim_oldest[P: Port](*self, p: *P, room: usize) -> Span
        val n = self.length()
        if n == 0 || n > room then return Span(0, 0)
        self.s.claim_read(p, n + MESSAGE_PREFIX)
