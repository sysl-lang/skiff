module skiff.kernel
@tests

// The two mutex options on the host: recursive locking and the immediate priority ceiling, alone and
// with inheritance and `set_priority`, over the recording port (kernel_tests.sysl). A call that blocks
// returns at once, with the task blocked; the test then makes the scheduler choose, as the switch would.

private body() -> never
    loop
        ()

private var stacks: [5][128]u32

// A task at `priority` on core 0 of `r`.
private task_at(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, stacks[i], &body, priority).unwrap()

// The switch the port was asked for: the scheduler's choice runs.
private switch_now(r: *Recorder)
    val _ = switch_context(r, 0)

private runs(r: *Recorder, t: Task) -> bool = current(r) == t

// `t`'s effective priority.
private priority_of(r: *Recorder, t: Task) -> u8 = here(r).sched.tasks[t.slot()].priority

// How many mutexes `t` holds.
private held_by(r: *Recorder, t: Task) -> u8 = here(r).sched.tasks[t.slot()].held

// Why a lock was refused; a lock that was had fails the test.
private why(res: Result[unit, MutexError]) -> MutexError = res match
    Ok(_) -> panic("the lock was had")
    Err(e) -> e

@test("a recursive mutex is held until it is unlocked once for each lock, and counts once as held")
recursive_counts()
    var r = recorder(1, 0)
    var m = Mutex.recursive("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    for _ in 0..<3
        assert(m.lock(&r, FOREVER), "taken again")
    assert_eq(m.depth(), 3)
    assert_eq(held_by(&r, low), 1)
    m.unlock(&r)
    m.unlock(&r)
    assert(m.holder() == low, "still held after two of three unlocks")
    assert_eq(m.depth(), 1)
    assert_eq(held_by(&r, low), 1)
    m.unlock(&r)
    assert(m.holder() == NO_TASK, "free at the last unlock")
    assert_eq(m.depth(), 0)
    assert_eq(held_by(&r, low), 0)
    assert(m.lock(&r, 0), "free again, so taken")
    assert_eq(m.depth(), 1)
    m.unlock(&r)
    assert_eq(r.masked, 0)

@test("unlocking a recursive mutex once more than it was locked is an unlock by a non-holder", should_trap: "a task unlocked a mutex it does not hold")
recursive_over_unlock()
    var r = recorder(1, 0)
    var m = Mutex.recursive("m")
    val _ = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = m.lock(&r, FOREVER)
    m.unlock(&r)
    m.unlock(&r)
    m.unlock(&r)

@test("a task that does not hold a recursive mutex may not unlock it", should_trap: "a task unlocked a mutex it does not hold")
recursive_not_held()
    var r = recorder(1, 0)
    var m = Mutex.recursive("m")
    val _ = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = m.lock(&r, FOREVER)
    val other = task_at(&r, 1, 3)
    switch_now(&r)
    assert(runs(&r, other), "the other task runs")
    m.unlock(&r)

@test("a recursive lock past MAX_LOCKS is refused, and the count stays")
recursive_depth()
    var r = recorder(1, 0)
    var m = Mutex.recursive("m")
    val _ = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    m.locks = MAX_LOCKS
    assert(why(m.enter(&r, FOREVER)) == MutexError.Depth, "refused at the limit")
    assert_eq(m.depth(), MAX_LOCKS)
    assert_eq(r.masked, 0)

@test("a recursive owner keeps an inherited priority until its last unlock, which hands the mutex over locked once")
recursive_inherits()
    var r = recorder(1, 0)
    var m = Mutex.recursive("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = m.lock(&r, FOREVER)
    val high = task_at(&r, 1, 3)
    switch_now(&r)
    assert(runs(&r, high), "the high task preempts")
    assert(why(m.enter(&r, FOREVER)) == MutexError.Unavailable, "held, so it waits")
    assert_eq(priority_of(&r, low), 3)
    switch_now(&r)
    assert(runs(&r, low), "the boosted owner")
    m.unlock(&r)
    assert(m.holder() == low, "one unlock of two keeps it")
    assert_eq(priority_of(&r, low), 3)
    m.unlock(&r)
    assert(m.holder() == high, "handed over")
    assert_eq(m.depth(), 1)
    assert_eq(priority_of(&r, low), 1)
    switch_now(&r)
    assert(runs(&r, high), "the new owner runs")
    val _ = m.lock(&r, FOREVER)
    assert_eq(m.depth(), 2)
    m.unlock(&r)
    m.unlock(&r)
    assert(m.holder() == NO_TASK, "free")
    assert_eq(r.masked, 0)

@test("a ceiling raises its holder at the lock and the holder drops back at the unlock")
ceiling_raises()
    var r = recorder(1, 0)
    var m = Mutex.with_ceiling("m", 4)
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    assert(m.lock(&r, FOREVER), "taken")
    assert_eq(priority_of(&r, low), 4)
    val mid = task_at(&r, 1, 3)
    assert(!here(&r).sched.preempted(), "a task below the ceiling does not preempt the holder")
    m.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    switch_now(&r)
    assert(runs(&r, mid), "now it does")
    assert_eq(r.masked, 0)

@test("a task above a ceiling may not lock it; at the ceiling it may, and a ceiling outside 1 to 31 refuses every lock")
ceiling_refused()
    var r = recorder(1, 0)
    var m = Mutex.with_ceiling("m", 3)
    var wild = Mutex.with_ceiling("wild", 32)
    val high = task_at(&r, 0, 5)
    here(&r).sched.first()
    assert(why(m.enter(&r, FOREVER)) == MutexError.Ceiling, "refused above the ceiling")
    assert(!m.lock(&r, 0), "and through lock")
    assert(m.holder() == NO_TASK, "not taken")
    assert_eq(held_by(&r, high), 0)
    assert_eq(priority_of(&r, high), 5)
    assert(why(wild.enter(&r, FOREVER)) == MutexError.Ceiling, "no task may lock a ceiling of 32")
    assert(set_priority(&r, high, 3).is_ok(), "lowered to the ceiling")
    assert(m.lock(&r, FOREVER), "at the ceiling it is taken")
    m.unlock(&r)
    assert_eq(priority_of(&r, high), 3)
    assert_eq(r.masked, 0)

@test("nested ceilings unlocked in any order leave the highest ceiling still held")
ceilings_out_of_order()
    var r = recorder(1, 0)
    var a = Mutex.with_ceiling("a", 5)
    var b = Mutex.with_ceiling("b", 3)
    var c = Mutex.with_ceiling("c", 5)
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = b.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 3)
    val _ = a.lock(&r, FOREVER)
    val _ = c.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 5)
    a.unlock(&r)
    assert_eq(priority_of(&r, low), 5)
    b.unlock(&r)
    assert_eq(priority_of(&r, low), 5)
    c.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    val _ = a.lock(&r, FOREVER)
    val _ = b.lock(&r, FOREVER)
    a.unlock(&r)
    assert_eq(priority_of(&r, low), 3)
    b.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    assert_eq(here(&r).sched.tasks[low.slot()].ceiling_bits, 0)
    assert_eq(r.masked, 0)

@test("a recursive ceiling counts once: the ceiling stays until the last unlock")
recursive_ceiling()
    var r = recorder(1, 0)
    var m = Mutex.recursive_with_ceiling("m", 4)
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = m.lock(&r, FOREVER)
    assert_eq(here(&r).sched.tasks[low.slot()].ceilings[4], 1)
    m.unlock(&r)
    assert_eq(priority_of(&r, low), 4)
    m.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    assert_eq(here(&r).sched.tasks[low.slot()].ceilings[4], 0)

@test("a boost above a ceiling raises the holder past it, and it runs at the higher until it holds no mutex")
ceiling_then_boost()
    var r = recorder(1, 0)
    var ceiled = Mutex.with_ceiling("ceiled", 2)
    var plain = Mutex.new("plain")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = ceiled.lock(&r, FOREVER)
    val _ = plain.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 2)
    val high = task_at(&r, 1, 4)
    switch_now(&r)
    assert(runs(&r, high), "the high task preempts")
    val _ = plain.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 4)
    switch_now(&r)
    assert(runs(&r, low), "the boosted owner")
    ceiled.unlock(&r)
    assert_eq(priority_of(&r, low), 4)
    plain.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    assert(plain.holder() == high, "handed over")
    assert_eq(r.masked, 0)

@test("a boost below a ceiling changes nothing, and the ceiling ends with the mutex")
ceiling_over_boost()
    var r = recorder(1, 0)
    var m = Mutex.with_ceiling("m", 4)
    var s = Semaphore.new("s", 0, 1)
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = s.take(&r, FOREVER)
    val mid = task_at(&r, 1, 2)
    switch_now(&r)
    assert(runs(&r, mid), "the holder waits, so the middle task runs")
    assert(!m.lock(&r, FOREVER), "and waits on the mutex")
    assert_eq(priority_of(&r, low), 4)
    val giver = task_at(&r, 2, 1)
    switch_now(&r)
    assert(runs(&r, giver), "only the giver is left")
    val _ = s.give(&r)
    switch_now(&r)
    assert(runs(&r, low), "the holder runs at its ceiling")
    m.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    assert(m.holder() == mid, "handed to the waiter")
    assert_eq(priority_of(&r, mid), 4)
    assert_eq(held_by(&r, mid), 1)
    switch_now(&r)
    assert(runs(&r, mid), "the heir runs at the ceiling")
    m.unlock(&r)
    assert_eq(priority_of(&r, mid), 2)
    assert_eq(r.masked, 0)

@test("set_priority of a ceiling's holder changes its base under the ceiling, and the base shows once it lets go")
ceiling_set_priority()
    var r = recorder(1, 0)
    var m = Mutex.with_ceiling("m", 3)
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    assert(set_priority(&r, low, 2).is_ok(), "raised below the ceiling")
    assert_eq(priority_of(&r, low), 3)
    assert(set_priority(&r, low, 5).is_ok(), "raised above the ceiling while held")
    assert_eq(priority_of(&r, low), 5)
    assert(set_priority(&r, low, 2).is_ok(), "lowered again")
    assert_eq(priority_of(&r, low), 3)
    m.unlock(&r)
    assert_eq(priority_of(&r, low), 2)
    assert_eq(r.masked, 0)
