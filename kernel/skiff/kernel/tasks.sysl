module skiff.kernel

// Tasks: a fixed table of them, each with its own stack and a priority, run by a preemptive scheduler.
//
// The highest-priority task that is ready runs. Tasks of equal priority take turns, one tick each: on
// every tick the scheduler asks for a switch if another task of the running one's priority is ready.
// A task that is blocked — sleeping, waiting on a semaphore, a mutex, a queue or flags (sync.sysl), or
// waiting for a notification (notify.sysl) —
// is not ready until what it waits for happens or its timeout's tick comes. A suspended task is not
// chosen, ready or not, until it is resumed (control.sysl). An idle task, at the lowest priority, runs
// when nothing else is ready.
//
// The kernel never touches a register itself. A `Port`, which the arch package provides, builds a
// task's first stack frame and performs the switch. The switch hands the running task's stack pointer
// to `switch_context`, which saves it, chooses the next task and answers that one's stack pointer.

// What the kernel needs from the processor to run tasks.
trait Port
    // Lay out `stack` so that the first switch to it starts `entry`, and answer the stack pointer to
    // keep for the task.
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize

    // Ask for a switch, to happen as soon as no interrupt handler is running.
    request_switch(*self)

    // Run the task whose stack pointer is `sp`. The caller's stack is never returned to.
    start_first(*self, sp: usize) -> never

    // Hold off every interrupt that may use the kernel, answering what `restore` needs to put things
    // back as they were. It nests: an inner pair restores what the outer one masked.
    mask(*self) -> u32

    restore(*self, state: u32)

    // Wait for an interrupt; the idle task's whole body.
    idle(*self)

// What the kernel needs from a memory protection unit. Before a task runs, the kernel names its stack,
// and the unit makes the memory just below what the task may use fault on any access, so that a task
// overflowing its stack is stopped at the edge instead of writing over whatever lies beneath.
trait Protection
    // Guard the bottom of the stack at `base`, `bytes` long, for the task about to run.
    guard(*self, base: usize, bytes: usize)

    // How many bytes at the bottom of the stack at `base`, `bytes` long, its task can never use: the
    // guard and anything below it. A stack's high-water mark is measured above them.
    reserved(*self, base: usize, bytes: usize) -> usize

// How many tasks the table holds, the idle task included.
const MAX_TASKS: usize = 56

// The idle task's priority; every other task's must be higher.
const IDLE_PRIORITY: u8 = 0

// A timeout that never comes. Any other timeout is a number of ticks, and 0 means "do not wait".
const FOREVER: u32 = 0xffff_ffff

enum TaskState
    Ready
    Blocked
    Stopped             // for good: it faulted or was stopped, and never runs again

struct Task
    name: string
    stack: usize        // the address of the bottom of its stack
    stack_bytes: usize
    sp: usize           // saved while the task is not running
    priority: u8        // what the scheduler compares: the higher of `base` and `boost`
    base: u8            // the priority it was given
    boost: u8           // the highest priority inherited from a mutex waiter while it holds a mutex
    state: TaskState
    on: usize           // the address of what a blocked task waits on; 0 while it only sleeps
    timed: bool         // whether a blocked task's wait ends at `wake`
    wake: u32           // the tick a timed wait ends on
    timed_out: bool     // whether its last wait ended at `wake` rather than by being woken
    held: u8            // mutexes it holds
    want: u32           // the flags a task blocked on a `Flags` waits for
    want_all: bool      // …all of them, rather than any
    got: u32            // the flags that ended its wait
    note: u32           // its notification value (notify.sysl)
    noted: bool         // whether a notification is pending: sent and not yet waited for
    suspended: bool     // never chosen, whatever its state, until resumed (control.sysl)
    run_time: u64       // counts spent running (stats.sysl)
    user: bool          // whether it runs unprivileged, under a map of its own (isolation.sysl)
    calling: bool       // whether an unprivileged task is inside a kernel call, running privileged (calls.sysl)

// An unused row of the table.
val NO_TASK: Task = Task("", 0, 0, 0, 0, 0, 0, TaskState.Ready, 0, false, 0, false, 0, 0, false, 0, 0, false, false, 0, false, false)

// The table and the choices made over it. It holds no hardware state, so the host tests drive one
// directly; the kernel keeps one of its own, `scheduler`.
struct Scheduler
    tasks: [MAX_TASKS]Task
    count: usize
    running: usize

    // Add a task, ready to run, whose saved stack pointer is `sp`. Answers its index: the first
    // stopped row other than the running task's, which is reused, or else a new row at the end. The
    // running task's row is never reused, since the switch away from a task that has just stopped
    // itself still saves its stack pointer there.
    add(*self, sp: usize, priority: u8) -> usize
        var at = self.count
        for i in 0..<self.count
            if at == self.count && i != self.running && self.tasks[i].state == TaskState.Stopped then at = i
        if at == MAX_TASKS then panic("skiff: the task table is full")
        var t = NO_TASK
        t.sp = sp
        t.priority = priority
        t.base = priority
        self.tasks[at] = t
        if at == self.count then self.count += 1
        at

    // Whether task `i` may be chosen: ready, and not suspended.
    runnable(*self, i: usize) -> bool = self.tasks[i].state == TaskState.Ready && !self.tasks[i].suspended

    // The task that should run now: the highest-priority runnable one, and among several of that
    // priority, the first after the running task in table order, so that they take turns. Answers the
    // running task itself when nothing else qualifies, even if it is not runnable; with an idle task in
    // the table that cannot happen.
    choose(*self) -> usize
        var best = self.running
        var found = false
        for step in 1..self.count
            val i = (self.running + step) % self.count
            if self.runnable(i) && (!found || self.tasks[i].priority > self.tasks[best].priority)
                best = i
                found = true
        best

    // Start: choose the first task and answer its stack pointer.
    first(*self) -> usize
        self.running = self.count - 1
        self.running = self.choose()
        self.tasks[self.running].sp

    // The switch: save the running task's stack pointer, choose the next and answer its.
    switch(*self, sp: usize) -> usize
        self.tasks[self.running].sp = sp
        self.running = self.choose()
        self.tasks[self.running].sp

    // The running task blocks from tick `now` on `on` (0 for nothing: a sleep), until it is woken or,
    // unless `timeout` is `FOREVER`, until tick `now + timeout`.
    block(*self, now: u32, on: usize, timeout: u32)
        val t = &self.tasks[self.running]
        t.state = TaskState.Blocked
        t.on = on
        t.timed = timeout != FOREVER
        t.wake = now + timeout
        t.timed_out = false

    // The running task sleeps from tick `now` until tick `now + ticks`.
    sleep(*self, now: u32, ticks: u32) = self.block(now, 0, ticks)

    // The highest-priority task blocked on `on`, the first in table order among equals.
    waiter(*self, on: usize) -> Option[usize]
        var best: Option[usize] = None
        for i in 0..<self.count
            if self.blocked_on(i, on)
                best = best match
                    Some(b) -> if self.tasks[i].priority > self.tasks[b].priority then Some(i) else Some(b)
                    None -> Some(i)
        best

    // Whether task `i` is blocked on `on`.
    blocked_on(*self, i: usize, on: usize) -> bool
        self.tasks[i].state == TaskState.Blocked && self.tasks[i].on == on && on != 0

    // Stop task `i` for good. It is never chosen again, and since a stopped task is blocked on
    // nothing, no object wakes it or hands it anything. If it is the running task, a switch is wanted.
    stop(*self, i: usize)
        val t = &self.tasks[i]
        t.state = TaskState.Stopped
        t.on = 0
        t.timed = false
        t.suspended = false

    stop_running(*self) = self.stop(self.running)

    // Make blocked task `i` ready: what it waited for has happened.
    wake(*self, i: usize)
        val t = &self.tasks[i]
        t.state = TaskState.Ready
        t.on = 0
        t.timed_out = false

    // Whether task `i` should preempt the running one: it is runnable and of higher priority.
    outranks_running(*self, i: usize) -> bool
        self.runnable(i) && self.tasks[i].priority > self.tasks[self.running].priority

    // Whether some runnable task outranks the running one.
    preempted(*self) -> bool
        for i in 0..<self.count
            if self.outranks_running(i) then return true
        false

    // Task `owner` holds something a task of `priority` waits for: it runs at that priority at least,
    // so that no task between the two can keep it from finishing.
    inherit(*self, owner: usize, priority: u8)
        val t = &self.tasks[owner]
        if t.boost < priority then t.boost = priority
        if t.priority < priority then t.priority = priority

    // Task `i` takes or gives up a mutex. It keeps any inherited priority until it holds none, so it
    // never drops below a task still waiting on one of them.
    took_mutex(*self, i: usize) = self.tasks[i].held += 1

    gave_mutex(*self, i: usize)
        val t = &self.tasks[i]
        t.held -= 1
        if t.held == 0
            t.boost = 0
            t.priority = t.base

    // Give task `i` the priority `p`. An inherited priority higher than `p` stays until the task holds
    // no mutex, as it would have under the old one.
    set_priority(*self, i: usize, p: u8)
        val t = &self.tasks[i]
        t.base = p
        t.priority = if t.boost > p then t.boost else p

    // Tick `now` has come: end every timed wait due by it, and answer whether a switch is wanted. One
    // is when a runnable task outranks the running one, when the running one is no longer runnable, or
    // when another runnable task shares its priority and it is that task's turn. A suspended task's
    // wait ends here too, and it stays suspended.
    tick(*self, now: u32) -> bool
        for i in 0..<self.count
            val t = &self.tasks[i]
            if t.state == TaskState.Blocked && t.timed && i32(now - t.wake) >= 0
                t.state = TaskState.Ready
                t.timed_out = t.on != 0
                t.on = 0
        if !self.runnable(self.running) then return true
        val priority = self.tasks[self.running].priority
        for i in 0..<self.count
            if i != self.running && self.runnable(i) && self.tasks[i].priority >= priority
                return true
        false

// An empty table.
empty_scheduler() -> Scheduler = Scheduler([NO_TASK; MAX_TASKS], 0, 0)

// Written as a constructor over constant data, not through `empty_scheduler`, so that it is laid into
// the image as data: a bare-metal image never runs initializers.
private[kernel] var scheduler: Scheduler = Scheduler([NO_TASK; MAX_TASKS], 0, 0)

// The port, once `run` has started the tasks; until then a tick switches nothing and nothing blocks.
private[kernel] var port: Option[*Port] = None

// The memory protection, if `protect` has named one: every task's stack is guarded while it runs.
private[kernel] var protection: Option[*Protection] = None

// Add a task called `name` that starts at `entry` on `stack`, with `priority` above `IDLE_PRIORITY`.
// Tasks are added before `run`, or by a running task, which reuses the row of a stopped task if there
// is one (see `Scheduler.add`) and switches to the new task at once if it outranks the caller. The
// stack must not be one a task that is not stopped still runs on.
spawn(p: *Port, stack: []u32, entry: *extern() -> never, priority: u8, name: string)
    if priority == IDLE_PRIORITY then panic("skiff: a task's priority must be above the idle task's")
    val state = enter()
    val i = add_task(p, stack, entry, priority, name)
    if scheduler.outranks_running(i) then request_switch()
    leave(state)

private[kernel] add_task(p: *Port, stack: []u32, entry: *extern() -> never, priority: u8, name: string) -> usize
    paint(stack)
    val i = scheduler.add(p.new_context(stack, entry), priority)
    val t = &scheduler.tasks[i]
    t.name = name
    t.stack = usize(&stack[0])
    t.stack_bytes = stack.len * 4
    i

// Guard every task's stack with `pr` from `run` on. Called before `run`.
protect(pr: *Protection)
    protection = Some(pr)

// Start the tasks, adding the idle task on `idle_stack`. Never returns. Interrupts are masked from
// here until the first task runs, which starts with them unmasked.
run(p: *Port, idle_stack: []u32) -> never
    val _ = add_task(p, idle_stack, &idle_task, IDLE_PRIORITY, "idle")
    val _ = p.mask()
    port = Some(p)
    val sp = scheduler.first()
    guard_running()
    isolate_running()
    start_counting()
    p.start_first(sp)

// Guard the running task's stack, if there is protection.
private guard_running()
    protection match
        Some(pr) ->
            val t = scheduler.tasks[scheduler.running]
            pr.guard(t.stack, t.stack_bytes)
        None -> ()

private idle_task() -> never
    loop
        port match
            Some(p) -> p.idle()
            None -> ()

// Called by the port's switch with the running task's stack pointer; answers the next task's, with its
// stack guarded and, for an unprivileged task, its map loaded. The task switched away from is charged
// for its run time first.
switch_context(sp: usize) -> usize
    charge()
    val next = scheduler.switch(sp)
    guard_running()
    isolate_running()
    next

// What a fault handler needs to know about the task that was running.
struct TaskInfo
    index: usize
    name: string
    stack: usize        // the bottom of its stack
    stack_bytes: usize

// The running task.
running_task() -> TaskInfo
    val t = scheduler.tasks[scheduler.running]
    TaskInfo(scheduler.running, t.name, t.stack, t.stack_bytes)

// Stop the running task for good, from a fault handler: it is never chosen again, and a switch is asked
// for, which happens as soon as the handler returns.
stop_running()
    scheduler.stop_running()
    request_switch()

// Whether task `i` has been stopped.
stopped(i: usize) -> bool = scheduler.tasks[i].state == TaskState.Stopped

// Hold off the interrupts that use the kernel, from a task or from an interrupt handler. Before `run`
// there are no tasks to protect and nothing is masked.
private[kernel] enter() -> u32 = port match
    Some(p) -> p.mask()
    None -> 0

private[kernel] leave(state: u32)
    port match
        Some(p) -> p.restore(state)
        None -> ()

// Whether `run` has started the tasks.
private[kernel] started() -> bool = port match
    Some(_) -> true
    None -> false

// Ask for a switch, if tasks are running.
private[kernel] request_switch()
    port match
        Some(p) -> p.request_switch()
        None -> ()

// Wake blocked task `i`, switching to it as soon as allowed if it outranks the running task.
private[kernel] wake_task(i: usize)
    scheduler.wake(i)
    if scheduler.outranks_running(i) then request_switch()

// Block the running task on `on` for up to `timeout` ticks and switch away. The caller has called
// `enter`, and `state` is what it answered; this leaves. Answers once the task runs again: true if it
// was woken, false if the timeout came first.
private[kernel] wait(state: u32, on: usize, timeout: u32) -> bool
    if !started() then panic("skiff: a wait before the tasks run")
    scheduler.block(ticks(), on, timeout)
    request_switch()
    leave(state)
    !scheduler.tasks[scheduler.running].timed_out

// The running task gives up the processor to the next ready task of its priority, if there is one.
yield_now()
    val state = enter()
    request_switch()
    leave(state)

// The running task sleeps for `count` ticks, or for good with `FOREVER`.
sleep(count: u32)
    val state = enter()
    val _ = wait(state, 0, count)

// The running task sleeps until tick `tick`, and does not sleep at all if that tick has come. Ticks
// compare modulo 2^32, so `tick` may be up to 2^31 - 1 ticks ahead.
sleep_until(tick: u32)
    val left = i32(tick - ticks())
    if left > 0 then sleep(u32(left))

// The running task stops for good: what a task with no more to do ends in, since a task never returns.
sleep_forever() -> never
    loop
        sleep(FOREVER)

// After a tick: charge the running task, and ask the port for a switch if the scheduler wants one.
private[kernel] reschedule()
    if !started() then return
    charge()
    if scheduler.tick(ticks()) then request_switch()
