module skiff.kernel

// Tickless idle (DESIGN "Tickless idle").
//
// A core whose only runnable task is its idle task need not take a tick until something can happen: the
// soonest deadline among its sleepers and timed waits (the timer service's wait among them), or the last
// tick its watch can go without being looked at. The idle task's step (`rest`) asks the port to stop the
// periodic tick and sleep until then; on waking, at that tick or earlier by any interrupt, the kernel
// takes every tick period that ended during the sleep at once (`take_ticks`), so the core's own count,
// the time base, the deadlines, the statistics and the watch come out as if each tick had been taken. A
// port that cannot stop its tick answers a limit of 0, and the idle task sleeps tick by tick as before.

// One step of the running core's idle task: take part in a stop of the whole machine (stop.sysl), or
// sleep, through as many ticks as nothing needs, or until the next interrupt. The idle task's body is
// `loop kernel.rest(p)`.
rest[P: Port](p: *P)
    val c = here(p)
    val state = p.mask()
    val step = take_part(p, c)
    if step == STEP_DONE
        p.restore(state)
        if end_expired_waits(p, c) then p.request_switch()
        return
    val count = if step == STEP_WAIT then 0 else skippable(p, c)
    if count < 2
        p.restore(state)
        p.idle()
        return
    val from = c.own_ticks()
#if option_trace
    trace_running(p, TraceKind.Sleep, TraceObject.Nothing, 0, count)
#endif
    val slept = p.sleep_ticks(count)
#if option_trace
    trace_running(p, TraceKind.Wake, TraceObject.Nothing, 0, slept)
#endif
    if slept > 0
        take_ticks(p, c, slept)
        c.skipped = c.skipped +% slept
        supervise_skipped(p, from, slept)
    p.restore(state)
    if end_expired_waits(p, c) then p.request_switch()

// How many ticks the running core may sleep through from now, with its interrupts masked: 0 unless its
// idle task is all it has to run and its port can stop its tick; else the fewest of the port's limit, the
// ticks to its soonest deadline, and what its watch allows. Fewer than 2 is no reason to stop the tick.
private[kernel] skippable[P: Port](p: *P, c: *Core) -> u32
    val limit = p.tickless_limit()
    if limit < 2 then return 0
    val reach = idle_reach(p, c)
    if reach < limit then reach else limit

// How many of the running core's ticks it has slept through with its tick stopped, taken at once on
// waking. Each is also one of its own ticks (`own_ticks`).
skipped_ticks[P: Port](p: *P) -> u32 = here(p).skipped
