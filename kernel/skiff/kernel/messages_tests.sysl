module skiff.kernel
@tests

// Queues, event flags and task notifications on the host, over the recording port (kernel_tests.sysl).
// A host test runs no task, so a call that blocks returns at once, with the task blocked and the switch
// asked for; the test then makes the scheduler choose, as the switch would, and does what the woken
// task does when it runs again.

private spin() -> never
    loop
        ()

private var task_stacks: [5][64]u32

// A task at `priority` on core 0 of `r`, on stack `i`.
private make_task(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, task_stacks[i], &spin, priority).unwrap()

// The switch the port was asked for: the scheduler's choice runs.
private choose(r: *Recorder)
    val _ = switch_context(r, 0)

// Whether `t` is the running task.
private is_running(r: *Recorder, t: Task) -> bool = current(r) == t

// `t`'s wait record.
private wait_of(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// `t`'s notification.
private note(t: Task) -> *Note = note_of(t.core(), t.slot())

// ---- queues ----

@test("a queue is first in first out, round its slots, and refuses a send when full and a receive when empty")
queue_fifo()
    var r = recorder(1, 0)
    var q: Queue[u32, 3] = Queue.new("q")
    assert(q.try_receive(&r) == None, "empty")
    assert(q.try_send(&r, 1), "1")
    assert(q.try_send(&r, 2), "2")
    assert(q.try_send(&r, 3), "3")
    assert(!q.try_send(&r, 4), "full")
    assert(!q.send(&r, 4, 0), "a timeout of 0 never waits")
    assert_eq(q.waiting(&r), 3)
    assert_eq(q.capacity(), 3)
    assert(q.try_receive(&r) == Some(1), "the oldest")
    assert(q.try_send(&r, 4), "room again, in the slot after the newest")
    for want in 2u32..4
        assert(q.receive(&r, 0) == Some(want), "in order")
    assert(q.try_receive(&r) == None, "empty again")
    assert_eq(q.waiting(&r), 0)
    assert_eq(r.masked, 0)

@test("a queue carries a struct, and an interrupt handler's try forms work with no task running")
queue_struct_from_handler()
    var r = recorder(1, 0)
    var q: Queue[Waiter, 1] = Queue.new("q")
    assert(q.try_send(&r, Waiter(Task(5), 3, Outcome.Given, 9, 1, 77)), "sent")
    assert(!q.try_send(&r, Waiter(Task(6), 0, Outcome.Idle, 0, 0, 0)), "full")
    q.try_receive(&r) match
        Some(m) ->
            assert(m.task == Task(5) && m.priority == 3 && m.outcome == Outcome.Given, "the fields")
            assert(m.next == 9 && m.mode == 1 && m.value == 77, "every field")
        None -> assert(false, "received")
    assert(q.try_receive(&r).is_none(), "empty")
    assert_eq(r.switches, 0)

@test("a receive on an empty queue blocks; a send hands the message to it, out of every other receive's reach")
queue_receive_blocks()
    var r = recorder(1, 0)
    var q: Queue[u32, 2] = Queue.new("q")
    val rx = make_task(&r, 0, 2)
    val low = make_task(&r, 1, 1)
    here(&r).sched.first()
    val before = r.switches
    assert(q.receive(&r, FOREVER) == None, "nothing yet, so the task waits")
    assert(state(&r, rx) == Ok(TaskState.Blocked), "blocked")
    assert(wait_of(rx).outcome == Outcome.Waiting, "waiting")
    assert_eq(r.switches, before + 1)
    choose(&r)
    assert(is_running(&r, low), "the low task runs")
    assert(q.try_send(&r, 7), "sent")
    assert(wait_of(rx).outcome == Outcome.Given, "handed over")
    assert(state(&r, rx) == Ok(TaskState.Ready), "ready")
    assert_eq(q.waiting(&r), 0)
    assert(q.try_receive(&r) == None, "the message is kept for the woken receiver")
    assert(q.try_send(&r, 8), "a second")
    assert(!q.try_send(&r, 9), "full: the kept message holds its slot")
    assert(q.try_receive(&r) == Some(7), "an unkept message is there to take: the oldest leaves first")
    choose(&r)
    assert(is_running(&r, rx), "the woken receiver runs")
    assert_eq(q.take_kept(&r), 8)
    assert_eq(q.count, 0)
    assert_eq(q.kept_messages, 0)
    assert_eq(r.masked, 0)

@test("a send to a full queue blocks; a receive keeps the freed slot for it")
queue_send_blocks()
    var r = recorder(1, 0)
    var q: Queue[u32, 1] = Queue.new("q")
    val tx = make_task(&r, 0, 2)
    val low = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(q.send(&r, 1, FOREVER), "room for one")
    assert(!q.send(&r, 2, FOREVER), "full, so the task waits")
    assert(wait_of(tx).outcome == Outcome.Waiting, "waiting")
    choose(&r)
    assert(is_running(&r, low), "the low task runs")
    assert(!q.try_send(&r, 9), "full")
    assert(q.try_receive(&r) == Some(1), "received")
    assert(wait_of(tx).outcome == Outcome.Given, "the slot is the sender's")
    assert(!q.try_send(&r, 9), "the kept slot is out of reach")
    assert(q.try_receive(&r) == None, "and holds nothing yet")
    choose(&r)
    assert(is_running(&r, tx), "the woken sender runs")
    q.fill_kept(&r, 2)
    assert(q.try_receive(&r) == Some(2), "its message")
    assert_eq(q.kept_slots, 0)
    assert_eq(r.masked, 0)

@test("the best receiver is handed the first message: highest priority, then first come")
queue_receiver_order()
    var r = recorder(1, 0)
    var q: Queue[u32, 4] = Queue.new("q")
    val first2 = make_task(&r, 0, 2)
    val high = make_task(&r, 1, 3)
    val second2 = make_task(&r, 2, 2)
    val _ = make_task(&r, 3, 1)
    here(&r).sched.first()
    for _ in 0..<3
        val _ = q.receive(&r, FOREVER)
        choose(&r)
    assert(q.try_send(&r, 10), "one")
    assert(wait_of(high).outcome == Outcome.Given, "the highest first")
    assert(wait_of(first2).outcome == Outcome.Waiting, "the others wait")
    assert(q.try_send(&r, 11), "two")
    assert(wait_of(first2).outcome == Outcome.Given, "then the first of priority 2")
    assert(wait_of(second2).outcome == Outcome.Waiting, "the second still waits")
    assert_eq(q.kept_messages, 2)

@test("senders and receivers wait in one queue, and each side's wake finds its own side")
queue_both_sides()
    var r = recorder(1, 0)
    var q: Queue[u32, 1] = Queue.new("q")
    val rx1 = make_task(&r, 0, 4)
    val rx2 = make_task(&r, 1, 3)
    val tx = make_task(&r, 2, 2)
    val _ = make_task(&r, 3, 1)
    here(&r).sched.first()
    // rx1 and rx2 wait to receive. tx's first send is kept for rx1, so its second finds the only slot
    // taken and waits: a receiver at the head of the waiters, a sender behind it.
    val _ = q.receive(&r, FOREVER)
    choose(&r)
    assert(is_running(&r, rx2), "rx2 runs while rx1 waits")
    val _ = q.receive(&r, FOREVER)
    choose(&r)
    assert(is_running(&r, tx), "tx runs while both wait")
    assert(q.send(&r, 1, FOREVER), "kept for rx1")
    assert(wait_of(rx1).outcome == Outcome.Given, "rx1 has it")
    assert(!q.send(&r, 2, FOREVER), "full, so tx waits")
    assert_eq(q.w.queue.count, 2)
    assert_eq(q.w.queue.first(), waiter_index(0, rx2.slot()))
    choose(&r)
    assert(is_running(&r, rx1), "rx1 runs")
    assert_eq(q.take_kept(&r), 1)
    assert(wait_of(tx).outcome == Outcome.Given, "the freed slot goes to the sender behind the receiver")
    assert(wait_of(rx2).outcome == Outcome.Waiting, "a receive wakes no receiver")
    assert_eq(q.kept_slots, 1)
    q.fill_kept(&r, 2)
    assert(wait_of(rx2).outcome == Outcome.Given, "the sender's message is kept for the receiver")
    assert_eq(q.take_kept(&r), 2)
    assert_eq(q.w.queue.count, 0)
    assert_eq(r.masked, 0)

@test("a timed receive nobody sends to ends TimedOut, and a later send stays in the queue")
queue_receive_times_out()
    var r = recorder(1, 0)
    var q: Queue[u32, 2] = Queue.new("q")
    val rx = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(q.receive(&r, 2) == None, "waits")
    choose(&r)
    tick(&r)
    assert(wait_of(rx).outcome == Outcome.Waiting, "still waiting after 1 tick")
    tick(&r)
    assert(wait_of(rx).outcome == Outcome.TimedOut, "timed out on the second")
    assert_eq(q.w.queue.first(), NONE)
    assert(q.try_send(&r, 5), "sent")
    assert_eq(q.kept_messages, 0)
    assert_eq(q.waiting(&r), 1)
    assert(wait_of(rx).outcome == Outcome.TimedOut, "still timed out")

@test("a timed send to a full queue ends TimedOut, and a later receive keeps no slot")
queue_send_times_out()
    var r = recorder(1, 0)
    var q: Queue[u32, 1] = Queue.new("q")
    val tx = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(q.try_send(&r, 1), "full now")
    assert(!q.send(&r, 2, 1), "waits")
    choose(&r)
    tick(&r)
    assert(wait_of(tx).outcome == Outcome.TimedOut, "timed out")
    assert(q.try_receive(&r) == Some(1), "received")
    assert_eq(q.kept_slots, 0)
    assert(q.try_send(&r, 3), "the slot is anyone's")

@test("a timeout after a queue's wake does nothing: the message stays kept for the receiver")
queue_timeout_after_wake()
    var r = recorder(1, 0)
    var q: Queue[u32, 2] = Queue.new("q")
    val rx = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    val _ = q.receive(&r, 1)
    choose(&r)
    // The deadline's tick finds the wait expired, and a send ends it before the tick's timeout does.
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    assert(q.try_send(&r, 4), "the wake")
    val _ = end_expired_waits(&r, c)
    assert(wait_of(rx).outcome == Outcome.Given, "the wake's outcome stands")
    assert_eq(q.kept_messages, 1)
    assert(state(&r, rx) == Ok(TaskState.Ready), "ready")
    assert_eq(c.sched.heads[2], u16(rx.slot()))
    assert_eq(c.sched.tails[2], u16(rx.slot()))
    assert_eq(r.masked, 0)

@test("deleting a waiting sender withdraws it, and a receive then keeps no slot")
queue_delete_withdraws()
    var r = recorder(1, 0)
    var q: Queue[u32, 1] = Queue.new("q")
    val tx = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(q.try_send(&r, 1), "full now")
    val _ = q.send(&r, 2, FOREVER)
    choose(&r)
    assert(delete(&r, tx).is_ok(), "deleted")
    assert_eq(q.w.queue.first(), NONE)
    assert(q.try_receive(&r) == Some(1), "received")
    assert_eq(q.kept_slots, 0)

// ---- event flags ----

@test("a wait for any bit is satisfied by one, a wait for all only by every one, and clear on exit clears what it named")
flags_terms()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0b0101)
    assert(f.wait(&r, 0b0011, false, false, 0) == Some(0b0101), "any of 0b0011")
    assert(f.wait(&r, 0b0011, true, false, 0) == None, "not all of 0b0011")
    assert(f.wait(&r, 0b0101, true, true, 0) == Some(0b0101), "all of 0b0101, cleared")
    assert_eq(f.get(&r), 0)
    assert_eq(f.set(&r, 0b1100), 0b1100)
    assert_eq(f.clear(&r, 0b0100), 0b1100)
    assert_eq(f.get(&r), 0b1000)
    assert(f.wait(&r, 0b1000, false, true, 0) == Some(0b1000), "any, cleared")
    assert_eq(f.get(&r), 0)
    assert(f.wait(&r, 0, true, false, FOREVER) == None, "a wait for no bits answers at once")
    assert_eq(r.masked, 0)

@test("a wait for all with only some bits set keeps waiting; the last bit wakes it and its bits are cleared")
flags_wait_all()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val w = make_task(&r, 0, 2)
    val low = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(f.wait(&r, 0b011, true, true, FOREVER) == None, "waits")
    assert(wait_of(w).outcome == Outcome.Waiting, "waiting")
    choose(&r)
    assert(is_running(&r, low), "the low task runs")
    assert_eq(f.set(&r, 0b001), 0b001)
    assert(wait_of(w).outcome == Outcome.Waiting, "one of two bits is not all")
    assert_eq(f.set(&r, 0b100), 0b101)
    assert(wait_of(w).outcome == Outcome.Waiting, "a bit it did not name")
    val before = r.switches
    assert_eq(f.set(&r, 0b010), 0b100)
    assert(wait_of(w).outcome == Outcome.Woken, "all of them")
    assert_eq(wait_of(w).value, 0b111)
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert_eq(r.switches, before + 1)
    choose(&r)
    assert(is_running(&r, w), "it runs")
    assert_eq(wait_value(here(&r)), 0b111)
    assert_eq(r.masked, 0)

@test("one set wakes every waiter it satisfies, in priority order, and clears only what the woken asked to")
flags_wake_many()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val clearing = make_task(&r, 0, 2)
    val keeping = make_task(&r, 1, 3)
    val both = make_task(&r, 2, 4)
    val other = make_task(&r, 3, 2)
    val _ = make_task(&r, 4, 1)
    here(&r).sched.first()
    val _ = f.wait(&r, 0b11, true, true, FOREVER)
    choose(&r)
    val _ = f.wait(&r, 0b01, false, false, FOREVER)
    choose(&r)
    val _ = f.wait(&r, 0b01, false, true, FOREVER)
    choose(&r)
    val _ = f.wait(&r, 0b10, false, false, FOREVER)
    choose(&r)
    assert_eq(f.set(&r, 0b01), 0b00)
    assert(wait_of(clearing).outcome == Outcome.Woken, "any of 0b01, clearing")
    assert(wait_of(keeping).outcome == Outcome.Woken, "any of 0b01: woken too, by the same set")
    assert_eq(wait_of(clearing).value, 0b01)
    assert_eq(wait_of(keeping).value, 0b01)
    assert(wait_of(both).outcome == Outcome.Waiting, "all of 0b11 waits")
    assert(wait_of(other).outcome == Outcome.Waiting, "0b10 waits")
    assert_eq(f.w.queue.count, 2)
    assert_eq(f.set(&r, 0b11), 0b00)
    assert(wait_of(both).outcome == Outcome.Woken, "all of 0b11")
    assert(wait_of(other).outcome == Outcome.Woken, "0b10")

@test("a timed flags wait ends TimedOut, and a set after it wakes nobody")
flags_times_out()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val w = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(f.wait(&r, 0b1, false, true, 2) == None, "waits")
    choose(&r)
    tick(&r)
    tick(&r)
    assert(wait_of(w).outcome == Outcome.TimedOut, "timed out")
    assert_eq(f.set(&r, 0b1), 0b1)
    assert(wait_of(w).outcome == Outcome.TimedOut, "still timed out")
    assert_eq(f.get(&r), 0b1)

@test("a timeout after a flags wake does nothing: the wait stays Woken with its bits")
flags_timeout_after_wake()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val w = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    val _ = f.wait(&r, 0b10, false, false, 1)
    choose(&r)
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    val _ = f.set(&r, 0b10)
    val _ = end_expired_waits(&r, c)
    assert(wait_of(w).outcome == Outcome.Woken, "the wake's outcome stands")
    assert_eq(wait_of(w).value, 0b10)
    assert_eq(c.sched.expiring, NONE)
    assert_eq(r.masked, 0)

// ---- task notifications ----

@test("a notification posted before the wait is answered at once, and clear on exit clears it")
notify_before_wait()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    here(&r).sched.first()
    assert(notify(&r, t, 42, Action.Overwrite) == Ok(true), "sent")
    assert(note(t).pending, "pending")
    assert(notify_wait(&r, 0xffff_ffff, 0xffff_ffff, FOREVER) == Some(42), "answered at once, clear on entry not applied")
    assert(!note(t).pending, "taken")
    assert_eq(note(t).value, 0)
    assert(state(&r, t) == Ok(TaskState.Ready), "never blocked")
    assert(notify_wait(&r, 0, 0, 0) == None, "nothing pending")
    assert_eq(r.masked, 0)

@test("the actions: set bits, increment, overwrite, and no overwrite refused while one is pending")
notify_actions()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    here(&r).sched.first()
    assert(notify(&r, t, 0b0101, Action.SetBits) == Ok(true), "set")
    assert(notify(&r, t, 0b0011, Action.SetBits) == Ok(true), "set more")
    assert_eq(note(t).value, 0b0111)
    assert(notify(&r, t, 99, Action.NoOverwrite) == Ok(false), "pending: refused")
    assert_eq(note(t).value, 0b0111)
    assert(notify_give(&r, t) == Ok(true), "give")
    assert_eq(note(t).value, 8)
    assert(notify(&r, t, 1000, Action.Overwrite) == Ok(true), "overwrite")
    assert_eq(note(t).value, 1000)
    assert(notify_wait(&r, 0, 0xff, 0) == Some(1000), "taken, low byte cleared")
    assert_eq(note(t).value, 1000 & ~0xff)
    assert(notify(&r, t, 7, Action.NoOverwrite) == Ok(true), "nothing pending: written")
    assert_eq(note(t).value, 7)

@test("clear on entry clears bits only when no notification is pending")
notify_clear_on_entry()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    here(&r).sched.first()
    assert(notify(&r, t, 0b111, Action.SetBits) == Ok(true), "set")
    assert(notify_wait(&r, 0, 0, 0) == Some(0b111), "taken, nothing cleared")
    assert(notify_wait(&r, 0b001, 0, 0) == None, "nothing pending: the entry's bits are cleared")
    assert_eq(note(t).value, 0b110)

@test("a wait for a notification blocks, and a notification wakes the task, which takes it when it runs")
notify_wakes()
    var r = recorder(1, 0)
    val w = make_task(&r, 0, 2)
    val low = make_task(&r, 1, 1)
    here(&r).sched.first()
    val before = r.switches
    assert(notify_wait(&r, 0, 0xffff_ffff, FOREVER) == None, "waits")
    assert(state(&r, w) == Ok(TaskState.Blocked), "blocked")
    assert_eq(r.switches, before + 1)
    choose(&r)
    assert(is_running(&r, low), "the low task runs")
    assert(notify(&r, w, 5, Action.SetBits) == Ok(true), "sent")
    assert(wait_of(w).outcome == Outcome.Woken, "woken")
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    choose(&r)
    assert(is_running(&r, w), "the woken task runs")
    assert(notify_wait(&r, 0, 0xffff_ffff, 0) == Some(5), "its value")
    assert_eq(note(w).value, 0)
    assert_eq(r.masked, 0)

@test("a take counts down, or clears with clear, and a timed take nobody gives answers 0 when it times out")
notify_take_counts()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    for _ in 0..<3
        assert(notify_give(&r, t) == Ok(true), "give")
    assert_eq(notify_take(&r, false, 0), 3)
    assert_eq(notify_take(&r, false, 0), 2)
    assert_eq(notify_take(&r, true, 0), 1)
    assert_eq(note(t).value, 0)
    assert_eq(notify_take(&r, false, 0), 0)
    assert_eq(notify_take(&r, false, 2), 0)
    assert(state(&r, t) == Ok(TaskState.Blocked), "waits while the value is 0")
    choose(&r)
    tick(&r)
    tick(&r)
    assert(wait_of(t).outcome == Outcome.TimedOut, "timed out")
    assert(notify_give(&r, t) == Ok(true), "a give after the timeout")
    assert(wait_of(t).outcome == Outcome.TimedOut, "wakes nothing")
    assert_eq(note(t).value, 1)

@test("a timed wait for a notification times out, leaving the value as the entry left it")
notify_wait_times_out()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    assert(notify(&r, t, 0b11, Action.SetBits) == Ok(true), "set")
    val _ = notify_wait(&r, 0, 0, 0)
    assert(notify_wait(&r, 0b01, 0, 1) == None, "waits")
    choose(&r)
    tick(&r)
    assert(wait_of(t).outcome == Outcome.TimedOut, "timed out")
    assert_eq(note(t).value, 0b10)
    assert(!note(t).pending, "nothing pending")

@test("a timeout after a notification's wake does nothing")
notify_timeout_after_wake()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    val _ = notify_take(&r, false, 1)
    choose(&r)
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    assert(notify_give(&r, t) == Ok(true), "the wake")
    val _ = end_expired_waits(&r, c)
    assert(wait_of(t).outcome == Outcome.Woken, "the wake's outcome stands")
    assert_eq(note(t).value, 1)
    assert_eq(c.sched.expiring, NONE)

@test("a stale handle is refused: once its task is deleted, and once the slot is reused")
notify_stale()
    var r = recorder(1, 0)
    val t = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    assert(notify(&r, t, 1, Action.Overwrite) == Ok(true), "a live task")
    assert(delete(&r, t).is_ok(), "deleted")
    assert(notify(&r, t, 1, Action.Overwrite) == Err(TaskError.Stale), "deleted: refused")
    assert(notify_give(&r, t) == Err(TaskError.Stale), "a give too")
    val again = make_task(&r, 2, 3)
    assert_eq(again.slot(), t.slot())
    assert(notify(&r, t, 1, Action.Overwrite) == Err(TaskError.Stale), "the slot reused: still refused")
    assert(!note(again).pending, "the new task starts with nothing pending")
    assert_eq(note(again).value, 0)
    assert(notify(&r, again, 1, Action.Overwrite) == Ok(true), "the new handle is good")
    assert(notify(&r, NO_TASK, 1, Action.Overwrite) == Err(TaskError.Stale), "no task")
    assert(notify(&r, task_handle(1, 0, 1), 1, Action.Overwrite) == Err(TaskError.Stale), "no such core")
    assert(notify(&r, task_handle(0, 4095, 1), 1, Action.Overwrite) == Err(TaskError.Stale), "no such slot")
    assert_eq(r.masked, 0)

@test("deleting a task waiting for a notification withdraws its wait")
notify_delete_withdraws()
    var r = recorder(1, 0)
    val w = make_task(&r, 0, 2)
    val _ = make_task(&r, 1, 1)
    here(&r).sched.first()
    val _ = notify_wait(&r, 0, 0, FOREVER)
    choose(&r)
    assert(delete(&r, w).is_ok(), "deleted")
    assert_eq(note(w).w.queue.count, 0)
    assert(wait_of(w).outcome == Outcome.Idle, "withdrawn")
    assert(notify(&r, w, 1, Action.SetBits) == Err(TaskError.Stale), "refused")
