module skiff.kernel
@tests

import sysl.sync.Atomic

// Tickless idle on the host, over the recording port (kernel_tests.sysl), whose sleep with the tick
// stopped spans what it was asked, or `wake_after` ticks when an interrupt comes sooner. No task runs: a
// test makes a task wait as the running one, switches to the idle task, and takes the idle task's step
// (`rest`) by hand. Every check is against what the same ticks taken one by one would have done.

private body() -> never
    loop
        ()

private var tickless_stacks: [4][128]u32

private tickless_task(r: *Recorder, n: usize, priority: u8) -> Task = create(r, 0, tickless_stacks[n], &body, priority).unwrap()

// The idle task, in a free slot, as `run` adds it.
private tickless_idle(r: *Recorder) -> Task
    val c = here(r)
    val i = c.sched.free_slot().unwrap()
    c.sched.add_on(i, tickless_stacks[3], 0, IDLE_PRIORITY)
    c.sched.handle(0, i)

// The switch the kernel asked for: its choice runs.
private tickless_switch(r: *Recorder)
    val _ = switch_context(r, 0)

// A recorder of one core whose tick may stop for up to `limit` ticks.
private tickless_port(limit: u32) -> Recorder
    var r = recorder(1, 0)
    r.skip_limit = limit
    r

@test("a sleep with the tick stopped is asked for exactly the ticks to the soonest deadline, and each is taken")
tickless_skipped_ticks_credited()
    var r = tickless_port(50)
    val sleeper = tickless_task(&r, 0, 2)
    val other = tickless_task(&r, 1, 3)
    val idle = tickless_idle(&r)
    here(&r).sched.first()
    // Both sleep, the later deadline first; the idle task runs.
    sleep(&r, 15)
    tickless_switch(&r)
    sleep(&r, 10)
    tickless_switch(&r)
    assert(current(&r) == idle, "the idle task runs")
    rest(&r)
    assert_eq(r.asked, 10)
    assert_eq(ticks(), 10)
    assert_eq(here(&r).own_ticks(), 10)
    assert_eq(skipped_ticks(&r), 10)
    assert(state(&r, sleeper) == Ok(TaskState.Ready), "the sleeper woke on the tick its deadline came")
    assert(state(&r, other) == Ok(TaskState.Sleeping), "the later one sleeps on")
    assert(r.switches > 0, "a switch was asked for the sleeper")
    // The sleeper outranks the idle task: no sleep while it is ready.
    val asked = r.asked
    rest(&r)
    assert_eq(r.asked, asked)
    assert_eq(ticks(), 11)
    assert_eq(skipped_ticks(&r), 10)
    assert_eq(r.masked, 0)

@test("a tick that cannot stop, a limit under 2, or a deadline a tick away leaves the idle task sleeping tick by tick")
tickless_falls_back_to_ticks()
    var r = tickless_port(0)
    val sleeper = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    sleep(&r, 20)
    tickless_switch(&r)
    rest(&r)
    assert_eq(r.asked, 0)
    assert_eq(ticks(), 1)
    r.skip_limit = 1
    rest(&r)
    assert_eq(r.asked, 0)
    assert_eq(ticks(), 2)
    r.skip_limit = 50
    rest(&r)
    assert_eq(r.asked, 18)
    assert_eq(ticks(), 20)
    assert(state(&r, sleeper) == Ok(TaskState.Ready), "woken at 20")
    tickless_switch(&r)
    sleep(&r, 1)
    tickless_switch(&r)
    r.asked = 0
    rest(&r)
    assert_eq(r.asked, 0)
    assert_eq(ticks(), 21)
    assert_eq(skipped_ticks(&r), 18)

@test("the port's limit bounds a sleep, and the next sleep goes on to the deadline")
tickless_limit_bounds_sleep()
    var r = tickless_port(7)
    val sleeper = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    sleep(&r, 16)
    tickless_switch(&r)
    rest(&r)
    assert_eq(r.asked, 7)
    rest(&r)
    assert_eq(r.asked, 7)
    assert(state(&r, sleeper) == Ok(TaskState.Sleeping), "two short of its deadline")
    rest(&r)
    assert_eq(r.asked, 2)
    assert_eq(ticks(), 16)
    assert(state(&r, sleeper) == Ok(TaskState.Ready), "woken at 16")

@test("a sleep an interrupt ends early takes only the ticks that passed, and the next one sleeps the rest")
tickless_early_wake()
    var r = tickless_port(50)
    val sleeper = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    sleep(&r, 10)
    tickless_switch(&r)
    r.wake_after = 3
    rest(&r)
    assert_eq(r.asked, 10)
    assert_eq(ticks(), 3)
    assert_eq(here(&r).own_ticks(), 3)
    assert(state(&r, sleeper) == Ok(TaskState.Sleeping), "three ticks of ten")
    // An interrupt arriving inside the first period takes no tick at all.
    r.wake_after = 0
    rest(&r)
    assert_eq(ticks(), 3)
    r.wake_after = FOREVER
    rest(&r)
    assert_eq(r.asked, 7)
    assert_eq(ticks(), 10)
    assert_eq(skipped_ticks(&r), 10)
    assert(state(&r, sleeper) == Ok(TaskState.Ready), "woken at 10")

private var tickless_units = Semaphore.new("units", 0, 1)

@test("a timed wait times out on its deadline's tick after a sleep, and an interrupt's give before it ends the wait")
tickless_timed_wait_fires()
    var r = tickless_port(50)
    val waiter_task = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    assert(!tickless_units.take(&r, 7), "the take waits")
    assert(state(&r, waiter_task) == Ok(TaskState.Blocked), "blocked")
    tickless_switch(&r)
    rest(&r)
    assert_eq(r.asked, 7)
    assert_eq(ticks(), 7)
    assert(state(&r, waiter_task) == Ok(TaskState.Ready), "woken on tick 7")
    assert(waiter(waiter_index(0, waiter_task.slot())).outcome == Outcome.TimedOut, "by its timeout")
    // Again, with the give an interrupt makes after 4 of 9 ticks.
    tickless_switch(&r)
    assert(!tickless_units.take(&r, 9), "the take waits")
    tickless_switch(&r)
    r.wake_after = 4
    rest(&r)
    assert_eq(ticks(), 11)
    assert(state(&r, waiter_task) == Ok(TaskState.Blocked), "still waiting at 11")
    assert(tickless_units.give(&r), "the interrupt gives")
    assert(state(&r, waiter_task) == Ok(TaskState.Ready), "given at 11")
    assert(waiter(waiter_index(0, waiter_task.slot())).outcome == Outcome.Given, "by the give")
    assert_eq(r.masked, 0)

private var tickless_timer: Timer
private var tickless_dues: [4]u32
private var tickless_calls: usize = 0

private tickless_fired(t: *Timer, due: u32)
    tickless_dues[tickless_calls] = due
    tickless_calls += 1

@test("the timer service's wait bounds a sleep, and a periodic timer is called on each due tick across sleeps")
tickless_timer_fires()
    var r = tickless_port(50)
    val service = tickless_task(&r, 0, 3)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    assert(create_timer(&r, &tickless_timer, "t", 6, true, &tickless_fired).is_ok(), "created")
    assert(tickless_timer.start(&r, 0).is_ok(), "started")
    for n in 1u32..3
        serve_once(&r)
        assert(state(&r, service) == Ok(TaskState.Blocked), "waiting for the expiry")
        tickless_switch(&r)
        rest(&r)
        assert_eq(r.asked, 6)
        assert_eq(ticks(), 6 * n)
        assert(state(&r, service) == Ok(TaskState.Ready), "woken on the due tick")
        tickless_switch(&r)
    timer_turn(&r)
    assert_eq(tickless_calls, 3)
    assert_eq(tickless_dues[0], 6)
    assert_eq(tickless_dues[1], 12)
    assert_eq(tickless_dues[2], 18)

@test("a sleep ends on the last tick the watch is fed on, the next on the last before its bite, and the bite comes on the tick it would have")
tickless_watchdog_bounds_sleep()
    var r = tickless_port(100)
    val watched = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    arm_watchdog(&r, 20)
    assert(watch(&r, watched, 6).is_ok(), "watched")
    assert(check_in(&r), "checked in at 0")
    sleep(&r, FOREVER)
    tickless_switch(&r)
    rest(&r)
    assert_eq(r.asked, 6)
    assert_eq(watch_here(&r).fed, 6)
    assert_eq(r.feeds, 1)
    // Overdue from tick 7: fed on 6, it bites on tick 27, so the sleep ends on 26.
    rest(&r)
    assert_eq(r.asked, 20)
    assert_eq(here(&r).own_ticks(), 26)
    assert_eq(watch_here(&r).fed, 6)
    assert_eq(r.feeds, 1)
    assert(!supervise(&r), "no bite on 26")
    tick(&r)
    assert(supervise(&r), "the bite on 27")
    assert(bitten(&r), "bitten")

@test("a sleep an interrupt ends early feeds the watch as the ticks it spanned would have")
tickless_watchdog_early_wake()
    var r = tickless_port(100)
    val watched = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    arm_watchdog(&r, 20)
    assert(watch(&r, watched, 6).is_ok(), "watched")
    sleep(&r, FOREVER)
    tickless_switch(&r)
    r.wake_after = 4
    rest(&r)
    assert_eq(r.asked, 6)
    assert_eq(watch_here(&r).fed, 4)
    // A sleep that ran past its end (a late wake, 9 ticks from 4) feeds the watch on the last tick it would
    // have been fed on, 6, and no later.
    supervise_skipped(&r, 4, 9)
    assert_eq(watch_here(&r).fed, 6)
    assert_eq(r.feeds, 2)

@test("the idle task is charged the counts it slept through")
tickless_charges_idle()
    var r = tickless_port(50)
    val _ = tickless_task(&r, 0, 2)
    val _ = tickless_idle(&r)
    here(&r).sched.first()
    sleep(&r, 10)
    tickless_switch(&r)
    val before = here(&r).idle_time
    r.clock = r.clock + 5000
    rest(&r)
    assert_eq(here(&r).idle_time - before, 5000)

@test("taking several ticks at once brings the time base on by what the other cores have not, never back")
tickless_take_several()
    var time: Atomic[u32] = Atomic(100)
    var a = fresh_core(0, 0, 100)
    var b = fresh_core(1, 0, 100)
    // Alone: all ten.
    a.take(&time, 10)
    assert_eq(time.load(), 110)
    assert_eq(a.own_ticks(), 10)
    // Core 1 slept the same ten periods: they are taken already.
    b.take(&time, 10)
    assert_eq(time.load(), 110)
    assert_eq(b.time_seen, 110)
    // Core 0 ticked 3 of the next 5 periods while core 1 slept them: core 1 brings the last 2.
    for _ in 0..<3 do a.tick(&time)
    assert_eq(time.load(), 113)
    b.take(&time, 5)
    assert_eq(time.load(), 115)
    // Core 0's next tick sees the time base moved, so the period is not counted twice.
    a.tick(&time)
    assert_eq(time.load(), 115)
    // A view far behind takes nothing: the time base never moves back or leaps.
    var c = fresh_core(2, 0, 3)
    c.take(&time, 20)
    assert_eq(time.load(), 115)
    assert_eq(c.time_seen, 115)
    // Across the wrap.
    var w: Atomic[u32] = Atomic(0xffff_fffd)
    var d = fresh_core(3, 0, 0xffff_fffd)
    d.take(&w, 5)
    assert_eq(w.load(), 2)
