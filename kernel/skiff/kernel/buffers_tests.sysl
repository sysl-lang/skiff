module skiff.kernel
@tests

// Buffer pools and channels on the host, over the recording port (kernel_tests.sysl), whose data cache
// records each clean and invalidate. A host test runs no task, so a call that blocks returns at once,
// with the task blocked and the switch asked for; the test then makes the scheduler choose, as the
// switch would, and does what the woken task does when it runs again.

private idle_body() -> never
    loop
        ()

private var buffer_stacks: [3][64]u32

// A task at `priority` on core 0 of `r`, on stack `i`.
private buffer_task(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, buffer_stacks[i], &idle_body, priority).unwrap()

// The switch the port was asked for: the scheduler's choice runs.
private run_next(r: *Recorder)
    val _ = switch_context(r, 0)

// `t`'s wait record.
private record_of(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// The address of a view's first byte.
private address(bytes: []const u8) -> usize = usize(&bytes[0])

@test("a pool hands out each buffer once, answers None when empty, and has every buffer back at the end")
pool_takes_and_gives()
    var r = recorder(1, 0)
    var pool: Pool[3, 16] = Pool.new("pool", 1)
    assert_eq(pool.available(&r), 3)
    val a = pool.try_take(&r).unwrap()
    val b = pool.try_take(&r).unwrap()
    val c = pool.take(&r, FOREVER).unwrap()
    assert(a.index() != b.index() && b.index() != c.index() && a.index() != c.index(), "three buffers")
    assert(a.pool() == 1 && a.generation() != 0, "the pool's id and a generation")
    assert(pool.try_take(&r) == None, "empty")
    assert(pool.take(&r, 0) == None, "a timeout of 0 never waits")
    assert_eq(pool.available(&r), 0)
    assert(pool.give(&r, b) == Ok(()), "b back")
    assert_eq(pool.available(&r), 1)
    val again = pool.try_take(&r).unwrap()
    assert_eq(again.index(), b.index())
    assert(again != b, "a new generation")
    for x in [a, c, again]
        assert(pool.give(&r, x) == Ok(()), "back")
    assert_eq(pool.available(&r), 3)
    assert_eq(pool.capacity(), 3)
    assert_eq(pool.size(), 16)
    assert_eq(r.masked, 0)

@test("each buffer starts on a cache line and fills whole lines")
pool_buffers_on_lines()
    var r = recorder(1, 0)
    var pool: Pool[3, 5] = Pool.new("pool", 1)
    val a = pool.try_take(&r).unwrap()
    val b = pool.try_take(&r).unwrap()
    val x = pool.bytes(&r, a).unwrap()
    val y = pool.bytes(&r, b).unwrap()
    assert_eq(x.len, 5)
    assert_eq(address(x) % option_cache_line, 0)
    assert_eq(address(y) % option_cache_line, 0)
    assert(address(y) - address(x) >= option_cache_line, "no line shared")
    assert_eq(sizeof(Block[5]), option_cache_line)

@test("a pool of no buffers is refused", should_trap: "a pool holds 1 to 4096 buffers")
pool_of_none()
    var pool: Pool[0, 4] = Pool.new("none", 1)
    assert_eq(pool.capacity(), 0)

@test("a handle given back, of another pool, past the pool's end, or the empty one, is refused everywhere")
pool_refuses_stale_and_foreign()
    var r = recorder(1, 0)
    var pool: Pool[2, 8] = Pool.new("pool", 1)
    var other: Pool[2, 8] = Pool.new("other", 2)
    val b = pool.try_take(&r).unwrap()
    val o = other.try_take(&r).unwrap()
    assert_eq(b.index(), o.index())
    assert_eq(b.generation(), o.generation())
    assert(pool.bytes(&r, o) == Err(BufferError.Stale), "another pool's handle, same index and generation")
    assert(pool.give(&r, o) == Err(BufferError.Stale), "and not given back to the wrong pool")
    assert(pool.bytes(&r, NO_BUFFER) == Err(BufferError.Stale), "the empty handle")
    assert(pool.bytes(&r, buffer_handle(1, 3, b.generation())) == Err(BufferError.Stale), "past the end")
    assert(pool.bytes(&r, buffer_handle(1, b.index(), b.generation() + 1)) == Err(BufferError.Stale), "a generation not issued")
    assert(pool.bytes(&r, b).is_ok(), "its own")
    assert(pool.give(&r, b) == Ok(()), "given back")
    assert(pool.bytes(&r, b) == Err(BufferError.Stale), "a use after giving")
    assert_eq(pool.available(&r), 2)
    assert(other.give(&r, o) == Ok(()), "the other's own")
    assert_eq(other.available(&r), 2)

@test("a buffer given twice is refused the second time, back to the pool or through a channel")
buffer_given_twice()
    var r = recorder(1, 0)
    var pool: Pool[2, 8] = Pool.new("pool", 1)
    var ch: Channel[2] = Channel.new("ch")
    val b = pool.try_take(&r).unwrap()
    assert(pool.give(&r, b) == Ok(()), "once")
    assert(pool.give(&r, b) == Err(BufferError.Stale), "twice")
    assert_eq(pool.available(&r), 2)
    val c = pool.try_take(&r).unwrap()
    assert_eq(c.index(), b.index())
    assert(pool.give(&r, b) == Err(BufferError.Stale), "the old handle is not the new holder's")
    assert(ch.try_send(&r, &pool, c) == Ok(()), "sent once")
    assert(ch.try_send(&r, &pool, c) == Err(BufferError.Stale), "sent twice")
    assert(pool.give(&r, c) == Err(BufferError.Stale), "given back after sending")
    assert_eq(ch.waiting(&r), 1)
    val got = ch.try_receive(&r, &pool).unwrap()
    assert(pool.give(&r, got) == Ok(()), "the receiver gives it back")
    assert_eq(pool.available(&r), 2)
    assert_eq(r.masked, 0)

@test("a buffer round-trips through a channel without a copy: the same bytes, and the sender's handle refused")
channel_round_trip()
    var r = recorder(1, 0)
    var pool: Pool[2, 8] = Pool.new("pool", 1)
    var ch: Channel[2] = Channel.new("ch")
    val b = pool.try_take(&r).unwrap()
    val bytes = pool.bytes(&r, b).unwrap()
    for i in 0..<bytes.len
        bytes[i] = u8(i + 40)
    assert(ch.try_send(&r, &pool, b) == Ok(()), "sent")
    assert(pool.bytes(&r, b) == Err(BufferError.Stale), "the sender no longer has it")
    val got = ch.try_receive(&r, &pool).unwrap()
    assert(got != b, "the handle the send issued")
    assert_eq(got.index(), b.index())
    val seen = pool.bytes(&r, got).unwrap()
    assert_eq(address(seen), address(bytes))
    for i in 0..<seen.len
        assert_eq(seen[i], u8(i + 40))
    assert(ch.try_receive(&r, &pool) == None, "empty")
    assert(pool.give(&r, got) == Ok(()), "back")
    assert_eq(pool.available(&r), 2)

@test("a send to a full channel answers Full and leaves the buffer the sender's, under the handle it had")
channel_full()
    var r = recorder(1, 0)
    var pool: Pool[3, 8] = Pool.new("pool", 1)
    var ch: Channel[2] = Channel.new("ch")
    val tx = buffer_task(&r, 0, 2)
    val _ = buffer_task(&r, 1, 1)
    here(&r).sched.first()
    val a = pool.try_take(&r).unwrap()
    val b = pool.try_take(&r).unwrap()
    val c = pool.try_take(&r).unwrap()
    assert(ch.try_send(&r, &pool, a) == Ok(()), "a")
    assert(ch.send(&r, &pool, b, 0) == Ok(()), "b")
    assert(ch.try_send(&r, &pool, c) == Err(BufferError.Full), "full")
    assert(pool.bytes(&r, c).is_ok(), "c is still the sender's")
    assert(ch.send(&r, &pool, c, 1) == Err(BufferError.Full), "a timed send waits")
    run_next(&r)
    tick(&r)
    assert(record_of(tx).outcome == Outcome.TimedOut, "and times out")
    assert(pool.bytes(&r, c).is_ok(), "still the sender's")
    assert_eq(ch.waiting(&r), 2)
    for _ in 0..<2
        assert(pool.give(&r, ch.try_receive(&r, &pool).unwrap()) == Ok(()), "received and given back")
    assert(pool.give(&r, c) == Ok(()), "c given back")
    assert_eq(pool.available(&r), 3)
    assert_eq(r.masked, 0)

@test("a take from an empty pool blocks; a give back keeps the buffer for the taker, out of every other take's reach")
pool_take_blocks()
    var r = recorder(1, 0)
    var pool: Pool[1, 8] = Pool.new("pool", 1)
    val taker = buffer_task(&r, 0, 2)
    val low = buffer_task(&r, 1, 1)
    here(&r).sched.first()
    val b = pool.try_take(&r).unwrap()
    val before = r.switches
    assert(pool.take(&r, FOREVER) == None, "nothing yet, so the task waits")
    assert(state(&r, taker) == Ok(TaskState.Blocked), "blocked")
    assert_eq(r.switches, before + 1)
    run_next(&r)
    assert(current(&r) == low, "the low task runs")
    assert(pool.give(&r, b) == Ok(()), "given back")
    assert(record_of(taker).outcome == Outcome.Given, "handed over")
    assert(state(&r, taker) == Ok(TaskState.Ready), "ready")
    assert_eq(pool.available(&r), 0)
    assert(pool.try_take(&r) == None, "the buffer is kept for the woken taker")
    run_next(&r)
    assert(current(&r) == taker, "the woken taker runs")
    val mine = pool.take_kept(&r)
    assert_eq(mine.index(), b.index())
    assert(pool.bytes(&r, mine).is_ok(), "its own")
    assert(pool.give(&r, b) == Err(BufferError.Stale), "the old holder's handle")
    assert_eq(pool.kept, 0)
    assert(pool.give(&r, mine) == Ok(()), "back")
    assert_eq(pool.available(&r), 1)
    assert_eq(r.masked, 0)

@test("a timed take from an empty pool ends TimedOut, and a later give back goes to the pool")
pool_take_times_out()
    var r = recorder(1, 0)
    var pool: Pool[1, 8] = Pool.new("pool", 1)
    val taker = buffer_task(&r, 0, 2)
    val _ = buffer_task(&r, 1, 1)
    here(&r).sched.first()
    val b = pool.try_take(&r).unwrap()
    assert(pool.take(&r, 2) == None, "waits")
    run_next(&r)
    tick(&r)
    assert(record_of(taker).outcome == Outcome.Waiting, "still waiting after 1 tick")
    tick(&r)
    assert(record_of(taker).outcome == Outcome.TimedOut, "timed out on the second")
    assert(pool.give(&r, b) == Ok(()), "given back")
    assert_eq(pool.kept, 0)
    assert_eq(pool.available(&r), 1)

@test("a give back that lands between the deadline's tick and the timeout wins: the buffer stays kept for the taker")
pool_give_beats_timeout()
    var r = recorder(1, 0)
    var pool: Pool[1, 8] = Pool.new("pool", 1)
    val taker = buffer_task(&r, 0, 2)
    val _ = buffer_task(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    val b = pool.try_take(&r).unwrap()
    val _ = pool.take(&r, 1)
    run_next(&r)
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    assert(pool.give(&r, b) == Ok(()), "the give")
    val _ = end_expired_waits(&r, c)
    assert(record_of(taker).outcome == Outcome.Given, "the give's outcome stands")
    assert_eq(pool.kept, 1)
    assert(state(&r, taker) == Ok(TaskState.Ready), "ready")
    run_next(&r)
    assert(pool.give(&r, pool.take_kept(&r)) == Ok(()), "taken when it runs, and given back")
    assert_eq(pool.available(&r), 1)

@test("a receive on an empty channel blocks; a send hands the buffer to it, and a timeout after the send does nothing")
channel_send_beats_timeout()
    var r = recorder(1, 0)
    var pool: Pool[2, 8] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    val rx = buffer_task(&r, 0, 2)
    val _ = buffer_task(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    assert(ch.receive(&r, &pool, 1) == None, "waits")
    run_next(&r)
    val b = pool.try_take(&r).unwrap()
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    assert(ch.try_send(&r, &pool, b) == Ok(()), "the send")
    val _ = end_expired_waits(&r, c)
    assert(record_of(rx).outcome == Outcome.Given, "the send's outcome stands")
    assert(ch.try_receive(&r, &pool) == None, "kept for the woken receiver")
    run_next(&r)
    val got = ch.taken(&r, &pool, ch.q.take_kept(&r))
    assert_eq(got.index(), b.index())
    assert(pool.give(&r, got) == Ok(()), "back")
    assert_eq(pool.available(&r), 2)

@test("a timed receive nobody sends to ends TimedOut, and a later send stays in the channel")
channel_receive_times_out()
    var r = recorder(1, 0)
    var pool: Pool[1, 8] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    val rx = buffer_task(&r, 0, 2)
    val _ = buffer_task(&r, 1, 1)
    here(&r).sched.first()
    assert(ch.receive(&r, &pool, 1) == None, "waits")
    run_next(&r)
    tick(&r)
    assert(record_of(rx).outcome == Outcome.TimedOut, "timed out")
    assert(ch.try_send(&r, &pool, pool.try_take(&r).unwrap()) == Ok(()), "sent")
    assert_eq(ch.waiting(&r), 1)
    assert(pool.give(&r, ch.try_receive(&r, &pool).unwrap()) == Ok(()), "received and back")
    assert_eq(pool.available(&r), 1)

@test("a receive told another pool than its buffers' stops the kernel", should_trap: "a channel received with another pool than its buffers'")
channel_wrong_pool()
    var r = recorder(1, 0)
    var pool: Pool[2, 32] = Pool.new("pool", 1)
    var other: Pool[2, 32] = Pool.new("other", 2)
    var ch: Channel[1] = Channel.new("ch")
    assert(ch.try_send(&r, &pool, pool.try_take(&r).unwrap()) == Ok(()), "sent")
    val _ = ch.try_receive(&r, &other)

@test("the cache: a take invalidates once the buffer is out of the pool, a send cleans before the channel has it, a receive invalidates once it has left, a give back cleans before the pool has it")
cache_steps()
    var r = recorder(1, 0)
    var pool: Pool[2, 32] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    r.pool = &pool
    r.channel = &ch
    val b = pool.try_take(&r).unwrap()
    val bytes = pool.bytes(&r, b).unwrap()
    assert_eq(r.invalidates, 1)
    assert_eq(r.free_then, 1)
    assert(address(r.invalidated) == address(bytes) && r.invalidated.len == 32, "the buffer's bytes, all of them")
    assert_eq(r.cleans, 0)
    bytes[0] = 7
    assert(ch.try_send(&r, &pool, b) == Ok(()), "sent")
    assert_eq(r.cleans, 1)
    assert_eq(r.waiting_then, 0)
    assert(address(r.cleaned) == address(bytes) && r.cleaned.len == 32, "the buffer's bytes")
    assert_eq(r.invalidates, 1)
    val got = ch.try_receive(&r, &pool).unwrap()
    assert_eq(r.invalidates, 2)
    assert_eq(r.waiting_then, 0)
    assert(address(r.invalidated) == address(bytes), "the same bytes")
    assert_eq(r.cleans, 1)
    assert(pool.give(&r, got) == Ok(()), "back")
    assert_eq(r.cleans, 2)
    assert_eq(r.free_then, 1)
    assert_eq(pool.available(&r), 2)
    assert(pool.give(&r, got) == Err(BufferError.Stale), "refused")
    assert(ch.try_send(&r, &pool, got) == Err(BufferError.Stale), "refused")
    assert(r.cleans == 2 && r.invalidates == 2, "a refused handle is neither cleaned nor invalidated")
