module skiff.kernel
@tests

// Waits on the host: the wait queue, the outcome rule, semaphores and mutexes, over the recording port
// (kernel_tests.sysl). A host test runs no task, so a call that blocks returns at once, with the task
// blocked and the switch asked for; the test then makes the scheduler choose, as the switch would.

private idle_body() -> never
    loop
        ()

private var stacks: [4][64]u32

// A task at `priority` on core 0 of `r`.
private task_at(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, stacks[i], &idle_body, priority).unwrap()

// The switch the port was asked for: the scheduler's choice runs.
private switch_now(r: *Recorder)
    val _ = switch_context(r, 0)

// The task the core runs.
private running(r: *Recorder) -> Task = current(r)

// Whether `t` is the running task.
private runs(r: *Recorder, t: Task) -> bool = running(r) == t

// `t`'s wait record.
private record(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// `t`'s effective priority.
private priority_of(r: *Recorder, t: Task) -> u8 = here(r).sched.tasks[t.slot()].priority

// The slots of `q`, best first, written as digits of slot + 1: "312".
private order(q: *WaitQueue) -> u32
    var digits: u32 = 0
    var at = q.first()
    while at != NONE
        digits = digits * 10 + u32(at) + 1
        at = waiter(at).next
    digits

// Queue record `w` at `priority` by hand.
private queue_at(q: *WaitQueue, w: u16, priority: u8)
    waiter(w).priority = priority
    q.insert(w)

@test("waiters queue by priority, first come within a priority")
queue_order()
    var q = WaitQueue(NONE, 0)
    queue_at(&q, 0, 1)
    queue_at(&q, 1, 3)
    queue_at(&q, 2, 2)
    queue_at(&q, 3, 3)
    queue_at(&q, 4, 1)
    assert_eq(order(&q), 24315)
    assert_eq(q.count, 5)
    assert_eq(q.first(), 1)

@test("a waiter leaves the queue from anywhere, and a queue of zeros is empty")
queue_remove()
    var zeros = WaitQueue(0, 0)
    assert_eq(zeros.first(), NONE)
    assert(!zeros.remove(0), "nothing to remove")
    var q = WaitQueue(NONE, 0)
    queue_at(&q, 0, 2)
    queue_at(&q, 1, 2)
    queue_at(&q, 2, 2)
    assert(q.remove(1), "the middle one")
    assert_eq(order(&q), 13)
    assert(q.remove(0), "the head")
    assert_eq(order(&q), 3)
    assert(!q.remove(0), "not twice")
    assert(q.remove(2), "the last")
    assert_eq(q.first(), NONE)
    assert_eq(q.count, 0)

@test("a take with a unit answers at once; without one it blocks the task and asks for a switch")
take_blocks()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 1, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    here(&r).sched.first()
    assert(s.take(&r, FOREVER), "the unit")
    assert_eq(s.count, 0)
    val before = r.switches
    assert(!s.take(&r, FOREVER), "no unit, so the task waits")
    assert(state(&r, w) == Ok(TaskState.Blocked), "blocked")
    assert(record(w).outcome == Outcome.Waiting, "waiting")
    assert_eq(s.w.queue.first(), waiter_index(0, w.slot()))
    assert_eq(r.switches, before + 1)
    assert_eq(r.masked, 0)
    switch_now(&r)
    assert(!runs(&r, w), "the blocked task does not run")

@test("a give hands the unit to the waiter, which runs at once if it outranks the running task")
give_hands_over()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 3)
    val w = task_at(&r, 0, 2)
    val low = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, FOREVER)
    switch_now(&r)
    assert(runs(&r, low), "the low task runs while the other waits")
    val before = r.switches
    assert(s.give(&r), "given")
    assert_eq(s.count, 0)
    assert(record(w).outcome == Outcome.Given, "handed over")
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert_eq(r.switches, before + 1)
    switch_now(&r)
    assert(runs(&r, w), "the woken task runs")
    assert(wait_outcome(here(&r)) == Outcome.Given, "and answers from its record")
    assert_eq(r.masked, 0)

@test("a semaphore counts up to its max and down to 0")
semaphore_counts()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 2)
    assert(s.give(&r), "1")
    assert(s.give(&r), "2")
    assert(!s.give(&r), "refused at the max")
    assert_eq(s.available(&r), 2)
    assert(s.try_take(&r), "1 left")
    assert(s.try_take(&r), "0 left")
    assert(!s.try_take(&r), "none")
    assert(!s.take(&r, 0), "a timeout of 0 never waits")
    assert_eq(s.available(&r), 0)
    var binary = Semaphore.new("b", 1, 1)
    assert(!binary.give(&r), "a binary semaphore holds one")
    assert(binary.try_take(&r), "taken")
    assert_eq(r.masked, 0)

@test("the best waiter is given the unit: highest priority, then first come")
give_order()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 3)
    val first2 = task_at(&r, 0, 2)
    val high = task_at(&r, 1, 3)
    val second2 = task_at(&r, 2, 2)
    val _ = task_at(&r, 3, 1)
    here(&r).sched.first()
    for _ in 0..<3
        val _ = s.take(&r, FOREVER)
        switch_now(&r)
    assert_eq(order(&s.w.queue), u32(high.slot() + 1) * 100 + u32(first2.slot() + 1) * 10 + u32(second2.slot() + 1))
    val _ = s.give(&r)
    assert(record(high).outcome == Outcome.Given, "the highest first")
    val _ = s.give(&r)
    assert(record(first2).outcome == Outcome.Given, "then the first of priority 2")
    assert(record(second2).outcome == Outcome.Waiting, "the second still waits")

@test("a timed take that nobody gives ends TimedOut on the deadline's tick, and the unit stays")
take_times_out()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, 3)
    switch_now(&r)
    tick(&r)
    tick(&r)
    assert(record(w).outcome == Outcome.Waiting, "still waiting after 2 ticks")
    val before = r.switches
    tick(&r)
    assert(record(w).outcome == Outcome.TimedOut, "timed out on the third")
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert_eq(s.w.queue.first(), NONE)
    assert(r.switches > before, "a switch to the higher task")
    switch_now(&r)
    assert(runs(&r, w), "it runs")
    assert(wait_outcome(here(&r)) == Outcome.TimedOut, "and answers from its record")
    assert_eq(r.masked, 0)

@test("a wake after a timeout finds nothing: the give goes to the count")
wake_after_timeout()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, 1)
    switch_now(&r)
    tick(&r)
    assert(record(w).outcome == Outcome.TimedOut, "timed out")
    assert(s.give(&r), "given")
    assert_eq(s.count, 1)
    assert(record(w).outcome == Outcome.TimedOut, "still timed out")

@test("a timeout after a wake does nothing: the wait stays Given and the task is ready once")
timeout_after_wake()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    val c = here(&r)
    c.sched.first()
    val _ = s.take(&r, 1)
    switch_now(&r)
    // The deadline's tick finds the wait expired, and a wake ends it before the tick's timeout does.
    c.tick(time_base())
    val _ = c.sched.tick(ticks())
    assert(s.give(&r), "the wake")
    val _ = end_expired_waits(&r, c)
    assert(record(w).outcome == Outcome.Given, "the wake's outcome stands")
    assert_eq(s.count, 0)
    assert(state(&r, w) == Ok(TaskState.Ready), "ready")
    assert_eq(c.sched.heads[2], u16(w.slot()))
    assert_eq(c.sched.tails[2], u16(w.slot()))
    assert_eq(c.sched.expiring, NONE)
    assert_eq(r.masked, 0)

@test("a waiter whose priority changes moves in its queue")
waiter_reinserted()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 3)
    val a = task_at(&r, 0, 3)
    val b = task_at(&r, 1, 2)
    val d = task_at(&r, 2, 2)
    val _ = task_at(&r, 3, 1)
    val c = here(&r)
    c.sched.first()
    for _ in 0..<3
        val _ = s.take(&r, FOREVER)
        switch_now(&r)
    assert_eq(order(&s.w.queue), 123)
    reprioritize(&r, c, d.slot(), 4)
    assert_eq(order(&s.w.queue), 312)
    assert_eq(record(d).priority, 4)
    assert_eq(priority_of(&r, d), 4)
    reprioritize(&r, c, a.slot(), 1)
    assert_eq(order(&s.w.queue), 321)
    assert_eq(r.masked, 0)

@test("deleting a waiting task withdraws its wait")
delete_withdraws()
    var r = recorder(1, 0)
    var s = Semaphore.new("s", 0, 1)
    val w = task_at(&r, 0, 2)
    val _ = task_at(&r, 1, 1)
    here(&r).sched.first()
    val _ = s.take(&r, 5)
    switch_now(&r)
    assert(delete(&r, w).is_ok(), "deleted")
    assert_eq(s.w.queue.first(), NONE)
    assert(s.give(&r), "given")
    assert_eq(s.count, 1)
    for _ in 0..<6
        tick(&r)
    assert_eq(here(&r).sched.expiring, NONE)

@test("an owner inherits a higher waiter's priority, and drops it with the mutex")
mutex_inherits()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    assert(m.lock(&r, FOREVER), "free, so taken")
    assert(m.holder() == low, "the low task holds it")
    val high = task_at(&r, 1, 3)
    switch_now(&r)
    assert(runs(&r, high), "the high task preempts")
    assert(!m.lock(&r, FOREVER), "held, so the high task waits")
    assert_eq(priority_of(&r, low), 3)
    switch_now(&r)
    assert(runs(&r, low), "the owner runs at the waiter's priority")
    val before = r.switches
    m.unlock(&r)
    assert(m.holder() == high, "handed to the waiter")
    assert(record(high).outcome == Outcome.Given, "given")
    assert_eq(priority_of(&r, low), 1)
    assert(r.switches > before, "a switch to the new owner")
    switch_now(&r)
    assert(runs(&r, high), "it runs")
    m.unlock(&r)
    assert(m.holder() == NO_TASK, "free")
    assert_eq(r.masked, 0)

@test("an owner keeps an inherited priority until it holds no mutex")
boost_kept_while_holding()
    var r = recorder(1, 0)
    var first = Mutex.new("first")
    var second = Mutex.new("second")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = first.lock(&r, FOREVER)
    val _ = second.lock(&r, FOREVER)
    val high = task_at(&r, 1, 3)
    switch_now(&r)
    val _ = first.lock(&r, FOREVER)
    switch_now(&r)
    assert(runs(&r, low), "the boosted owner")
    second.unlock(&r)
    assert_eq(priority_of(&r, low), 3)
    first.unlock(&r)
    assert_eq(priority_of(&r, low), 1)
    assert(first.holder() == high, "handed over")

@test("a lower waiter does not lower the owner, and a new owner inherits from who still waits")
inherit_from_the_rest()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val low = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val mid = task_at(&r, 1, 2)
    switch_now(&r)
    val _ = m.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 2)
    val high = task_at(&r, 2, 3)
    switch_now(&r)
    assert(runs(&r, high), "the high task")
    val _ = m.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 3)
    switch_now(&r)
    m.unlock(&r)
    assert(m.holder() == high, "the best waiter first")
    assert_eq(priority_of(&r, high), 3)
    assert_eq(priority_of(&r, low), 1)
    assert_eq(priority_of(&r, mid), 2)

@test("a boosted owner waiting elsewhere moves up that queue, one level only")
boost_reaches_one_level()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    var s = Semaphore.new("s", 0, 1)
    val low = task_at(&r, 0, 1)
    val other = task_at(&r, 1, 2)
    val _ = task_at(&r, 2, 1)
    here(&r).sched.first()
    switch_now(&r)
    assert(runs(&r, other), "the priority-2 task first")
    val _ = s.take(&r, FOREVER)
    switch_now(&r)
    assert(runs(&r, low), "then the low task")
    val _ = m.lock(&r, FOREVER)
    val _ = s.take(&r, FOREVER)
    assert_eq(order(&s.w.queue), u32(other.slot() + 1) * 10 + u32(low.slot() + 1))
    val high = task_at(&r, 3, 3)
    switch_now(&r)
    assert(runs(&r, high), "the high task")
    val _ = m.lock(&r, FOREVER)
    assert_eq(priority_of(&r, low), 3)
    assert_eq(order(&s.w.queue), u32(low.slot() + 1) * 10 + u32(other.slot() + 1))
    assert_eq(r.masked, 0)

@test("a task may not lock a mutex it already holds", should_trap: "a task locked a mutex it already holds")
mutex_twice()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val _ = task_at(&r, 0, 1)
    here(&r).sched.first()
    val _ = m.lock(&r, FOREVER)
    val _ = m.lock(&r, FOREVER)

@test("a task may not unlock a mutex it does not hold", should_trap: "a task unlocked a mutex it does not hold")
mutex_not_held()
    var r = recorder(1, 0)
    var m = Mutex.new("m")
    val _ = task_at(&r, 0, 1)
    here(&r).sched.first()
    m.unlock(&r)

@test("the shared bounds hold the wait records, and nothing before they are given")
placement_bounds()
    val at = usize(waiter(0))
    assert(!in_shared(at, sizeof(Waiter)), "no bounds yet")
    shared_bounds(at, at + sizeof(Waiter))
    assert(in_shared(at, sizeof(Waiter)), "inside")
    assert(!in_shared(at + 1, sizeof(Waiter)), "one byte past the end")
    assert(!in_shared(at - 1, sizeof(Waiter)), "one byte before the start")
