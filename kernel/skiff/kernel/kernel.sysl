module skiff.kernel

import sysl.sync.Atomic

// How one core interrupts another: the chip's doorbell. Ringing core `core`'s raises an interrupt on that
// core, whose handler calls `kernel.answer_doorbell`; a ring while one is still pending may be merged
// with it, since the handler drains everything there is. Only a machine with more than one core is asked.
trait Doorbell
    ring(*self, core: u32)

    // Clear the running core's doorbell, so that the next ring raises its interrupt again. The drain clears
    // it before it reads any inbox: a message posted while the drain runs then rings once more.
    clear(*self)

// The running core's data cache, as far as a buffer handed between owners needs it: a buffer is cleaned
// before it is given and invalidated after it is taken (DESIGN "Channels and the buffer pool"). Every
// buffer starts on a cache line and fills whole lines, so neither touches bytes outside it. A core with
// no data cache does nothing for either.
trait Cache
    // Write the core's dirty lines over `bytes` back to memory, so another owner reads what was written.
    clean(*self, bytes: []const u8)

    // Drop the core's lines over `bytes`, so the next read of them comes from memory.
    invalidate(*self, bytes: []u8)

// The running core's guard on the stack of the task it runs (DESIGN "Protection"). A core with no means
// to guard a stack guards nothing and reserves nothing.
trait Protection
    // Guard the stack at `base`, `bytes` long, of the task the core is about to run: an access below its
    // reserve faults from now on.
    guard(*self, base: usize, bytes: usize)

    // The bytes at the bottom of the stack at `base`, `bytes` long, that its task can never use: the
    // guard and whatever lies below it.
    reserved(*self, base: usize, bytes: usize) -> usize

// The running core's memory protection unit, as unprivileged tasks run under it (DESIGN "Protection").
// A core with no unit has a capacity of 0, and no unprivileged task is created on it.
trait Isolation
    // How many regions one task's map may take on this unit, its stack among them.
    capacity(*self) -> usize

    // How the unit holds `r`, or why it cannot hold exactly `r`. Called when a task is created.
    encode(*self, r: Region) -> Result[Slot, RegionError]

    // Hold `map` for the task the core is about to run: an unprivileged task's map, or an empty one
    // after an unprivileged task, so that a privileged one reaches memory through the default map.
    @borrows(map)
    load(*self, map: []const Slot)

    // Run thread mode unprivileged, or privileged, from the return to the task about to run.
    privilege(*self, unprivileged: bool)

// The running core's own free-running counter, which the kernel charges each task's run time in (DESIGN
// "Statistics"). It counts up by one per unit of time, at whatever rate the chip has, and wraps at 2^32.
// The kernel only takes the difference of two readings on one core, so the counter needs no particular
// start, and each core may have its own at a rate of its own; but two readings on a core must come less
// than 2^32 counts apart, and every tick takes one, so a counter that wraps no more than once a tick is
// enough.
trait RunCounter
    run_count(*self) -> u32

// The kernel's view of the processor and the machine under it. An arch package, a chip package and a
// board program together implement it; the kernel itself knows nothing about the hardware beyond what
// this trait says.
trait Port: Doorbell + Cache + Protection + Isolation + RunCounter
    // Write `bytes` to this core's console, waiting for room as long as it takes.
    @borrows(bytes)
    write(*self, bytes: []const u8)

    // How many cores the machine has: 1 on a single-core machine.
    cores(*self) -> u32

    // The number of the core running this call, from 0.
    core_id(*self) -> u32

    // Start this core's periodic tick at `hz` a second. Each tick calls `kernel.tick` on this core.
    start_ticks(*self, hz: u32)

    // Sleep until an interrupt has been taken on this core. It may return at once if one is pending.
    idle(*self)

    // Lay out `stack` so that the first switch to it starts `entry`, and answer the stack pointer the
    // kernel keeps for the task until then.
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize

    // Ask for a switch on this core, to happen as soon as no interrupt handler is running and the
    // kernel's interrupts are not masked. The switch hands the running task's stack pointer to
    // `kernel.switch_context` and resumes the task whose stack pointer it answers.
    request_switch(*self)

    // Run the task whose stack pointer is `sp`, with the kernel's interrupts unmasked. The caller's
    // stack is never returned to.
    start_first(*self, sp: usize) -> never

    // Hold off every interrupt on this core that may use the kernel, answering what `restore` needs to
    // put things back as they were. It nests: an inner pair restores what the outer one masked.
    mask(*self) -> u32

    restore(*self, state: u32)

    // Take the chip's lock whose word is `word`, waiting for the other cores as long as it takes; the
    // kernel's interrupts on this core are already masked. Everything the last holder wrote is visible
    // once it returns. Only a machine with more than one core is asked.
    spin_lock(*self, word: *Atomic[u32])

    // Take that lock if no other core holds it, answering whether it did.
    spin_try_lock(*self, word: *Atomic[u32]) -> bool

    // Let it go, publishing everything written under it to the next holder.
    spin_unlock(*self, word: *Atomic[u32])

// Bring the kernel up on `p`: greet on this core's console. On a machine with more than one core the
// greeting names the core. Answers the status the machine should stop with: 0 for success.
boot[P: Port](p: *P) -> i32
    p.write("skiff: hello".bytes)
    if p.cores() > 1
        p.write(" from core ".bytes)
        write_dec(p, p.core_id())
    p.write("\n".bytes)
    0
