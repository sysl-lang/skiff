module skiff.kernel

import sysl.sync.Atomic

// The kernel's view of the processor and the machine under it. An arch package, a chip package and a
// board program together implement it; the kernel itself knows nothing about the hardware beyond what
// this trait says.
trait Port
    // Write `bytes` to this core's console, waiting for room as long as it takes.
    write(*self, bytes: []const u8)

    // How many cores the machine has: 1 on a single-core machine.
    cores(*self) -> u32

    // The number of the core running this call, from 0.
    core_id(*self) -> u32

    // Start this core's periodic tick at `hz` a second. Each tick calls `kernel.tick` on this core.
    start_ticks(*self, hz: u32)

    // Sleep until an interrupt has been taken on this core. It may return at once if one is pending.
    idle(*self)

    // Lay out `stack` so that the first switch to it starts `entry`, and answer the stack pointer the
    // kernel keeps for the task until then.
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize

    // Ask for a switch on this core, to happen as soon as no interrupt handler is running and the
    // kernel's interrupts are not masked. The switch hands the running task's stack pointer to
    // `kernel.switch_context` and resumes the task whose stack pointer it answers.
    request_switch(*self)

    // Run the task whose stack pointer is `sp`, with the kernel's interrupts unmasked. The caller's
    // stack is never returned to.
    start_first(*self, sp: usize) -> never

    // Hold off every interrupt on this core that may use the kernel, answering what `restore` needs to
    // put things back as they were. It nests: an inner pair restores what the outer one masked.
    mask(*self) -> u32

    restore(*self, state: u32)

    // Take the chip's lock whose word is `word`, waiting for the other cores as long as it takes; the
    // kernel's interrupts on this core are already masked. Everything the last holder wrote is visible
    // once it returns. Only a machine with more than one core is asked.
    spin_lock(*self, word: *Atomic[u32])

    // Take that lock if no other core holds it, answering whether it did.
    spin_try_lock(*self, word: *Atomic[u32]) -> bool

    // Let it go, publishing everything written under it to the next holder.
    spin_unlock(*self, word: *Atomic[u32])

// Bring the kernel up on `p`: greet on this core's console. On a machine with more than one core the
// greeting names the core. Answers the status the machine should stop with: 0 for success.
boot[P: Port](p: *P) -> i32
    p.write("skiff: hello".bytes)
    if p.cores() > 1
        p.write(" from core ".bytes)
        write_dec(p, p.core_id())
    p.write("\n".bytes)
    0
