module skiff.kernel

// The kernel's view of the machine under it. An arch package, a chip package and a board program
// together implement it; the kernel itself knows nothing about the hardware beyond what this trait says.
trait Machine
    // Write `bytes` to this core's console, waiting for room as long as it takes.
    write(*self, bytes: []const u8)

    // How many cores run the kernel: 1 on a single-core machine.
    cores(*self) -> u32

    // The number of the core running this call, from 0.
    core(*self) -> u32

// Bring the kernel up on `m`: greet on this core's console. On a machine with more than one core the
// greeting names the core. Answers the status the machine should stop with: 0 for success.
boot[M: Machine](m: *M) -> i32
    m.write("skiff: hello".bytes)
    if m.cores() > 1
        m.write(" from core ".bytes)
        write_dec(m, m.core())
    m.write("\n".bytes)
    0
