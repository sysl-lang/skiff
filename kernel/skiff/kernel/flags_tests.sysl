module skiff.kernel
@tests

// Event flags' walk on the host: a set looks at one waiter per hold of the lock, and what happens on the
// flags between its steps. A host test runs no task, so a wait returns at once with its task blocked; the
// test then makes the scheduler choose, as the switch would. `start_set` is a set's masked part and `step`
// one step of its walk, so a test can act between them as another core or an interrupt handler would.

private spin() -> never
    loop
        ()

private var bound_stacks: [6][128]u32

// A task at `priority` on core 0 of `r`, on stack `i`.
private flags_bound_task(r: *Recorder, i: usize, priority: u8) -> Task = create(r, 0, bound_stacks[i], &spin, priority).unwrap()

// The running task waits on `f` for ever, and the scheduler chooses the next.
private flags_bound_wait(r: *Recorder, f: *Flags, wanted: u32, all: bool, clear: bool)
    assert(f.wait(r, wanted, all, clear, FOREVER) == None, "waits")
    val _ = switch_context(r, 0)

// `t`'s wait record.
private flags_bound_record(t: Task) -> *Waiter = waiter(waiter_index(t.core(), t.slot()))

// How many of `f`'s waiters wait on `side`.
private flags_bound_on_side(f: *Flags, side: u8) -> u32
    var n: u32 = 0
    var at = f.w.queue.first_of(side)
    while at != NONE
        n += 1
        at = f.w.queue.after(at)
    n

@test("a set looks at one waiter per hold of the lock: N waiters it does not satisfy take N + 2 holds")
flags_bound_one_waiter_a_hold()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val _ = flags_bound_task(&r, 0, 5)
    val _ = flags_bound_task(&r, 1, 4)
    val _ = flags_bound_task(&r, 2, 3)
    val _ = flags_bound_task(&r, 3, 2)
    val _ = flags_bound_task(&r, 4, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b10, false, false)
    flags_bound_wait(&r, &f, 0b100, false, false)
    flags_bound_wait(&r, &f, 0b11, true, false)
    flags_bound_wait(&r, &f, 0b1000, false, false)
    val before = r.masks
    assert_eq(f.set(&r, 0b1), 0b1)
    assert_eq(r.masks - before, 6)
    assert_eq(f.w.queue.count, 4)
    assert(!f.walking, "the walk is over")
    assert_eq(flags_bound_on_side(&f, f.joining), 4)
    assert_eq(flags_bound_on_side(&f, f.joining ^ 1), 0)
    assert_eq(r.masked, 0)

@test("each step of a walk ends one wait or passes one waiter, best first, and the walk ends with none left")
flags_bound_step_by_step()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val high = flags_bound_task(&r, 0, 4)
    val middle = flags_bound_task(&r, 1, 3)
    val low = flags_bound_task(&r, 2, 2)
    val _ = flags_bound_task(&r, 3, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b1, false, false)
    flags_bound_wait(&r, &f, 0b10, false, false)
    flags_bound_wait(&r, &f, 0b1, false, false)
    assert(f.start_set(&r, 0b1) == None, "a walk begins")
    assert_eq(r.masked, 0)
    val source = f.joining ^ 1
    assert_eq(flags_bound_on_side(&f, source), 3)
    assert(f.step(&r) == None, "first step")
    assert(flags_bound_record(high).outcome == Outcome.Woken, "the best waiter first")
    assert(flags_bound_record(middle).outcome == Outcome.Waiting, "not yet looked at")
    assert_eq(flags_bound_on_side(&f, source), 2)
    assert(f.step(&r) == None, "second step")
    assert(flags_bound_record(middle).outcome == Outcome.Waiting, "not satisfied: passed")
    assert_eq(flags_bound_on_side(&f, source), 1)
    assert_eq(flags_bound_on_side(&f, f.joining), 1)
    assert(f.step(&r) == None, "third step")
    assert(flags_bound_record(low).outcome == Outcome.Woken, "satisfied")
    assert(f.step(&r) == Some(0b1), "the walk ends")
    assert(f.step(&r) == Some(0b1), "no walk: the bits")
    assert_eq(r.masked, 0)

@test("a woken wait's bits are cleared as it is woken, and the walk still wakes every waiter the set satisfied")
flags_bound_clear_after_walk()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val first = flags_bound_task(&r, 0, 3)
    val second = flags_bound_task(&r, 1, 2)
    val _ = flags_bound_task(&r, 2, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b1, false, true)
    flags_bound_wait(&r, &f, 0b1, false, true)
    assert(f.start_set(&r, 0b11) == None, "a walk begins")
    assert(f.step(&r) == None, "first step")
    assert(flags_bound_record(first).outcome == Outcome.Woken, "first woken")
    assert_eq(f.get(&r), 0b10)
    assert(f.step(&r) == None, "second step")
    assert(flags_bound_record(second).outcome == Outcome.Woken, "second woken by the same set")
    assert_eq(flags_bound_record(second).value, 0b11)
    assert_eq(f.finish(&r), 0b10)
    assert_eq(f.get(&r), 0b10)

@test("a bit set during a walk survives the clearing of a waiter the walk wakes after it")
flags_bound_set_during_walk_kept()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val w = flags_bound_task(&r, 0, 2)
    val _ = flags_bound_task(&r, 1, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b1, false, true)
    assert(f.start_set(&r, 0b1) == None, "a walk begins")
    assert(f.start_set(&r, 0b1) == None, "a second set during it")
    assert(f.step(&r) == None, "the waiter's step")
    assert(flags_bound_record(w).outcome == Outcome.Woken, "woken")
    assert_eq(flags_bound_record(w).value, 0b1)
    assert_eq(f.get(&r), 0b1)
    assert_eq(f.finish(&r), 0b1)
    assert_eq(f.get(&r), 0b1)

@test("a set during a walk helps: it returns only once no walk is under way")
flags_bound_set_helps()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val first = flags_bound_task(&r, 0, 3)
    val second = flags_bound_task(&r, 1, 2)
    val _ = flags_bound_task(&r, 2, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b1, false, false)
    flags_bound_wait(&r, &f, 0b1, false, false)
    assert(f.start_set(&r, 0b1) == None, "a walk begins")
    assert_eq(f.set(&r, 0b10), 0b11)
    assert(!f.walking, "the second set finished the walk")
    assert(flags_bound_record(first).outcome == Outcome.Woken, "first")
    assert(flags_bound_record(second).outcome == Outcome.Woken, "second")
    assert(f.step(&r) == Some(0b11), "nothing left for the first set")

@test("a set during a walk has every waiter looked at again, those already passed among them")
flags_bound_set_during_walk_walks_again()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val w = flags_bound_task(&r, 0, 2)
    val _ = flags_bound_task(&r, 1, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b10, false, false)
    assert(f.start_set(&r, 0b1) == None, "a walk begins")
    assert(f.step(&r) == None, "the waiter is passed")
    assert(flags_bound_record(w).outcome == Outcome.Waiting, "0b1 does not satisfy it")
    assert(f.start_set(&r, 0b10) == None, "a walk is under way")
    assert_eq(f.finish(&r), 0b11)
    assert(flags_bound_record(w).outcome == Outcome.Woken, "the second walk woke it")
    assert_eq(flags_bound_record(w).value, 0b11)

@test("a clear during a walk comes after the set: the walk still wakes what the set satisfied")
flags_bound_clear_during_walk()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val first = flags_bound_task(&r, 0, 3)
    val second = flags_bound_task(&r, 1, 2)
    val _ = flags_bound_task(&r, 2, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b100, false, false)
    flags_bound_wait(&r, &f, 0b100, false, false)
    assert(f.start_set(&r, 0b100) == None, "a walk begins")
    assert(f.step(&r) == None, "first step")
    assert_eq(f.clear(&r, 0b100), 0b100)
    assert_eq(f.finish(&r), 0)
    assert(flags_bound_record(first).outcome == Outcome.Woken, "first")
    assert(flags_bound_record(second).outcome == Outcome.Woken, "second, after the clear")
    assert_eq(flags_bound_record(second).value, 0b100)

@test("a wait begun during a walk is not looked at by it, so a clear meanwhile is not undone for it")
flags_bound_wait_during_walk()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val early = flags_bound_task(&r, 0, 3)
    val late = flags_bound_task(&r, 1, 2)
    val _ = flags_bound_task(&r, 2, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b10, false, false)
    assert(f.start_set(&r, 0b100) == None, "a walk begins")
    assert_eq(f.clear(&r, 0b100), 0b100)
    assert(is_running_here(&r, late), "the late task runs")
    flags_bound_wait(&r, &f, 0b100, false, false)
    assert_eq(f.finish(&r), 0)
    assert(flags_bound_record(early).outcome == Outcome.Waiting, "0b100 is not 0b10")
    assert(flags_bound_record(late).outcome == Outcome.Waiting, "it began waiting after the set")
    assert_eq(f.set(&r, 0b100), 0b100)
    assert(flags_bound_record(late).outcome == Outcome.Woken, "the next set wakes it")
    assert(flags_bound_record(early).outcome == Outcome.Waiting, "still waiting")

@test("a wait that times out during a walk leaves it, and the walk goes on to the rest")
flags_bound_timeout_during_walk()
    var r = recorder(1, 0)
    var f = Flags.new("f", 0)
    val first = flags_bound_task(&r, 0, 3)
    val timed = flags_bound_task(&r, 1, 2)
    val _ = flags_bound_task(&r, 2, 1)
    here(&r).sched.first()
    flags_bound_wait(&r, &f, 0b10, false, false)
    assert(f.wait(&r, 0b10, false, false, 1) == None, "waits a tick")
    val _ = switch_context(&r, 0)
    assert(f.start_set(&r, 0b1) == None, "a walk begins")
    assert(f.step(&r) == None, "the first waiter is passed")
    tick(&r)
    assert(flags_bound_record(timed).outcome == Outcome.TimedOut, "timed out")
    assert_eq(f.w.queue.count, 1)
    assert_eq(f.finish(&r), 0b1)
    assert_eq(f.set(&r, 0b10), 0b11)
    assert(flags_bound_record(first).outcome == Outcome.Woken, "woken")
    assert(flags_bound_record(timed).outcome == Outcome.TimedOut, "still timed out")
    assert_eq(f.w.queue.count, 0)
    assert_eq(r.masked, 0)

// Whether `t` is the running task.
private is_running_here(r: *Recorder, t: Task) -> bool = current(r) == t
