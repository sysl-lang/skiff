module skiff.cores
@tests

import sysl.sync.{Atomic, Ordering}
import skiff.kernel
import skiff.kernel.{Cache, Doorbell, Isolation, Mutex, Port, Protection, Region, RegionError, RunCounter, Semaphore, Slot, Task, TraceEvent, TraceRing, Watchdog}

// A machine of `kernel.CORES` cores on the host, played one core at a time: `me` says which core is
// running, and a test changes it to act as another. Its doorbell rings nothing; it counts the rings each
// core was sent, and a test answers one by calling `kernel.answer_doorbell` as that core. No task ever
// runs: a call that blocks returns at once with its task blocked and a switch asked for, and the test
// then makes the scheduler choose (`switch_now`), as the switch would.
struct Machine
    me: u32
    rung: [kernel.CORES]u32        // how many times each core's doorbell was rung
    switches: [kernel.CORES]u32    // how many switches each core asked for
    masked: u32                     // how deep the running core's masking is nested
    pending: [kernel.CORES]bool    // whether each core's doorbell is raised: a ring raises it, `clear` lowers it
    late: *Semaphore                // given by core 0 as the running core's drain ends (null: nothing)
    cleans: [kernel.CORES]u32      // how many cleans each core asked of its cache
    invalidates: [kernel.CORES]u32 // how many invalidates
    clocks: [kernel.CORES]u32      // each core's own counter, moved by hand
    feeds: [kernel.CORES]u32       // how many times each core fed its hardware watchdog
    watchdog_stops: [kernel.CORES]u32  // how many times each core stopped it
    skip_limit: u32                 // the most ticks a sleep with the tick stopped may span (0: no core's tick stops)
    wake_after: u32                 // how many ticks such a sleep lasts before an interrupt ends it (FOREVER: none comes)
    ticking: u32                    // bit n: core n takes its tick each period another core sleeps through
    lag: u32                        // of those periods, how many last ones' ticks land after the sleeper wakes
    inside: [kernel.CORES]u32      // the cores whose idle step is taken while the sleeping core sleeps, in turn
    inside_count: usize             // how many of them there are
    inside_next: usize              // the next to take
    events: TraceRing[64]          // every core's events, in the order the cores emitted them, once started
    stop_min: u32                   // the fewest ticks a stop of the machine is worth (0: no deep state)
    stop_most: u32                  // the most ticks one may span
    stop_asked: u32                 // the ticks the last stop was asked to span (0: none was)
    stops_entered: u32              // how many stops were entered
    held_at_entry: u32              // bit n: core n was holding when the last stop was entered
    holding: u32                    // bit n: core n is inside its hold now
    holds: [kernel.CORES]u32       // how many times each core held
    woken: [kernel.CORES]bool      // a device interrupt is pending on the core, so its hold ends at once
    plays: [16]u32                  // what the other cores do while one holds, stops or idles (`play`)
    plays_count: usize              // how many there are
    plays_next: usize               // the next to play
    given: *Semaphore               // what a `PLAY_GIVE` gives (null: nothing)
    answering: bool                 // whether a rung core answers at once, inside the call that rang it
    watched: *Mutex                 // the mutex such a core's chosen task looks at (null: none)
    seen_running: [kernel.CORES]Task   // the task each answering core chose to run
    seen_holder: [kernel.CORES]Task    // the watched mutex's holder as that task saw it
    seen_depth: [kernel.CORES]u16      // and its depth

// Each core reads its own counter.
impl RunCounter for Machine
    run_count(*self) -> u32 = self.clocks[self.me]

// Each core's hardware watchdog counts what that core asks of it.
impl Watchdog for Machine
    start_watchdog(*self, ticks: u32) = ()

    feed_watchdog(*self)
        self.feeds[self.me] += 1

    stop_watchdog(*self)
        self.watchdog_stops[self.me] += 1

// A tick is taken by hand. A new task's context is only its stack's address. The chip's lock is a word
// that is never contended, since one core acts at a time: finding it taken is a lock left held.
impl Port for Machine
    write(*self, bytes: []const u8)
        for b in bytes
            if said_len[self.me] < SAID_BYTES
                said[self.me][said_len[self.me]] = b
                said_len[self.me] += 1

    cores(*self) -> u32 = u32(kernel.CORES)
    core_id(*self) -> u32 = self.me
    start_ticks(*self, hz: u32) = ()
    // An idle core wakes on its tick, unless the test has plays left: then they are what happens first.
    idle(*self)
        val sleeper = self.me
        if self.plays_next < self.plays_count then self.run_plays() else kernel.tick(self)
        self.me = sleeper
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = usize(&stack[0])

    request_switch(*self)
        self.switches[self.me] += 1

    start_first(*self, sp: usize) -> never = panic("the host runs no task")

    mask(*self) -> u32
        self.masked += 1
        self.masked - 1

    restore(*self, state: u32)
        self.masked = state
        if state == 0 && self.late != null
            // The outermost restore is a drain's last act: what core 0 gives now lands in a ring the drain
            // has already read.
            val s = self.late
            val core = self.me
            self.late = null
            self.me = 0
            val _ = s.give(self)
            self.me = core

    spin_lock(*self, word: *Atomic[u32])
        if word.swap(1, Ordering.Acquire) != 0 then panic("a kernel lock was left held")

    spin_try_lock(*self, word: *Atomic[u32]) -> bool = word.swap(1, Ordering.Acquire) == 0
    spin_unlock(*self, word: *Atomic[u32]) = word.store(0, Ordering.Release)

    // A sleep with the tick stopped spans the ticks it was asked, or `wake_after` if an interrupt comes
    // sooner. While it lasts, the next core of `inside` takes its idle step (so it sleeps too, inside this
    // sleep), and the `ticking` cores take their ticks for every period but the last `lag`.
    override tickless_limit(*self) -> u32 = self.skip_limit

    override sleep_ticks(*self, count: u32) -> u32
        val sleeper = self.me
        val slept = if self.wake_after < count then self.wake_after else count
        if self.inside_next < self.inside_count
            self.me = self.inside[self.inside_next]
            self.inside_next += 1
            kernel.rest(self)
        val periods = if self.lag < slept then slept - self.lag else 0
        for _ in 0u32..<periods
            for core in 0u32..<u32(kernel.CORES)
                if core != sleeper && self.ticking & (1 << core) != 0
                    self.me = core
                    kernel.tick(self)
        self.me = sleeper
        slept

    // Every core's events go to the one ring, so a test reads the order across cores too.
    override trace(*self, event: TraceEvent) = self.events.record(event)

    // A stop of the machine. While a core holds, or the leader is stopped, the plays run: the other cores
    // act. A hold ends at once when the core's doorbell or a device interrupt is pending, and otherwise
    // once the plays have run, which is a wake when no one released it. A stop spans what it was asked, or
    // `wake_after` if an interrupt comes sooner.
    override stop_threshold(*self) -> u32 = self.stop_min
    override stop_limit(*self) -> u32 = self.stop_most

    override hold(*self)
        val holder = self.me
        self.holds[holder] += 1
        if !self.pending[holder] && !self.woken[holder]
            self.holding |= 1 << holder
            self.run_plays()
            self.holding &= ~(1 << holder)
        self.me = holder
        self.woken[holder] = false

    override stop_machine(*self, count: u32) -> u32
        val leader = self.me
        self.stop_asked = count
        self.stops_entered += 1
        self.held_at_entry = self.holding
        self.run_plays()
        self.me = leader
        if self.wake_after < count then self.wake_after else count

// What a play does, as its core.
const PLAY_REST: u32 = 0      // take the core's idle step
const PLAY_TICK: u32 = 1      // take its tick
const PLAY_ANSWER: u32 = 2    // answer its doorbell
const PLAY_WAKE: u32 = 3      // a device interrupt becomes pending on it
const PLAY_SWITCH: u32 = 4    // the switch it asked for
const PLAY_GIVE: u32 = 5      // an interrupt handler on it gives `given`

// A play: core `core` does `what`.
play(core: u32, what: u32) -> u32 = what << 8 | core

// Queue plays, in order.
plan(m: *Machine, plays: []const u32)
    for e in plays
        m.plays[m.plays_count] = e
        m.plays_count += 1

impl Machine
    // Run the plays, ticks, answers and wakes in turn, up to and including the next idle step.
    run_plays(*self)
        while self.plays_next < self.plays_count
            val e = self.plays[self.plays_next]
            self.plays_next += 1
            self.me = e & 0xff
            val what = e >> 8
            if what == PLAY_REST
                kernel.rest(self)
                return
            elif what == PLAY_TICK
                kernel.tick(self)
            elif what == PLAY_ANSWER
                kernel.answer_doorbell(self)
            elif what == PLAY_WAKE
                self.woken[self.me] = true
            elif what == PLAY_SWITCH
                switch_now(self)
            else
                val _ = self.given.give(self)

impl Doorbell for Machine
    // With `answering` on, the rung core answers its doorbell at once and switches to its scheduler's
    // choice, while the ringing core is still inside the call that rang it, as a second core may on a
    // board: the chosen task then reads `watched` with no lock, as `holder` and `depth` do.
    ring(*self, core: u32)
        self.rung[core] += 1
        self.pending[core] = true
        if self.answering
            val ringer = self.me
            val masking = self.masked
            self.me = core
            self.masked = 0
            kernel.answer_doorbell(self)
            val _ = kernel.switch_context(self, 0)
            self.seen_running[core] = kernel.current(self)
            if self.watched != null
                self.seen_holder[core] = self.watched.holder()
                self.seen_depth[core] = self.watched.depth()
            self.me = ringer
            self.masked = masking

    clear(*self)
        self.pending[self.me] = false

// Each core's data cache counts what it is asked.
impl Cache for Machine
    clean(*self, bytes: []const u8)
        self.cleans[self.me] += 1

    invalidate(*self, bytes: []u8)
        self.invalidates[self.me] += 1

// A protection unit that guards nothing and holds a region whose base and size are multiples of 32
// bytes, as PMSAv8 does.
impl Protection for Machine
    guard(*self, base: usize, bytes: usize) = ()
    reserved(*self, base: usize, bytes: usize) -> usize = 0

impl Isolation for Machine
    capacity(*self) -> usize = 8

    encode(*self, r: Region) -> Result[Slot, RegionError]
        if r.bytes == 0 then return Err(RegionError.Empty)
        if r.base % 32 != 0 || r.bytes % 32 != 0 then return Err(RegionError.Unaligned)
        Ok(Slot(u32(r.base & 0xffff_ffff), u32(r.bytes)))

    load(*self, map: []const Slot) = ()
    privilege(*self, unprivileged: bool) = ()

// A machine with every core offline, core 0 acting. The objects a test declares are its own locals, and
// every one of them may be used by two cores, so the whole address space counts as `.shared`.
machine() -> Machine
    kernel.shared_bounds(0, 0xffff_ffff_ffff_ffff)
    Machine(0, [0; kernel.CORES], [0; kernel.CORES], 0, [false; kernel.CORES], null, [0; kernel.CORES], [0; kernel.CORES], [0; kernel.CORES], [0; kernel.CORES], [0; kernel.CORES], 0, kernel.FOREVER, 0, 0, [0; kernel.CORES], 0, 0, TraceRing.new(), 0, 0, 0, 0, 0, 0, [0; kernel.CORES], [false; kernel.CORES], [0; 16], 0, 0, null, false, null, [kernel.NO_TASK; kernel.CORES], [kernel.NO_TASK; kernel.CORES], [0; kernel.CORES])

// Act as core `core` from now on.
on(m: *Machine, core: u32)
    m.me = core

// Start every core and let each that has tasks choose its first. Tasks are created before, while the
// cores are offline, which is when one core may create them on another.
begin(m: *Machine)
    for core in 0u32..<u32(kernel.CORES)
        on(m, core)
        kernel.start(m)
        if kernel.here(m).sched.ready != 0
            val _ = kernel.here(m).sched.first()
    on(m, 0)

// The switch the running core asked for: its scheduler's choice runs.
switch_now(m: *Machine)
    val _ = kernel.switch_context(m, 0)

// What each core's console was written, as far as `SAID_BYTES`: module storage, since the cores' consoles
// outlive any one port value a test hands on.
private const SAID_BYTES: usize = 512
private var said: [kernel.CORES][SAID_BYTES]u8
private var said_len: [kernel.CORES]usize

// Whether core `core`'s console has been written exactly `want` since it was last emptied.
said_on(core: u32, want: string) -> bool
    val w = want.bytes
    if said_len[core] != w.len then return false
    for i in 0..<w.len
        if said[core][i] != w[i] then return false
    true

// Empty every core's console.
hush()
    for core in 0..<kernel.CORES
        said_len[core] = 0

// A task's body: no task runs on the host.
private body() -> never
    loop
        ()

private var stacks: [12][128]u32

// A task at `priority` on core `core`, on stack `n`.
task_on(m: *Machine, core: u32, n: usize, priority: u8) -> Task = kernel.create(m, core, stacks[n], &body, priority).unwrap()
