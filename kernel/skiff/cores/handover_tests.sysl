module skiff.cores
@tests

import skiff.kernel
import skiff.kernel.{FOREVER, Mutex, TaskState}

// What a mutex's heir on another core sees the moment its core is rung: the machine answers the ring at
// once, inside the unlock that rang it, and the task its core then runs reads the mutex with no lock
// (`holder`, `depth`), as a task on a second core may while the unlocking core is still finishing.

@test("a mutex handed to a waiter of another core is already that waiter's when its core is rung")
hand_seen_at_ring()
    var m = machine()
    val _ = task_on(&m, 0, 0, 2)
    val h = task_on(&m, 1, 1, 2)
    val _ = task_on(&m, 1, 2, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 0)
    assert(x.lock(&m, FOREVER), "the owner locks it")
    on(&m, 1)
    assert(!x.lock(&m, FOREVER), "the waiter of another core blocks")
    switch_now(&m)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    m.answering = true
    m.watched = &x
    on(&m, 0)
    x.unlock(&m)
    assert_eq(m.rung[1], 1)
    assert(m.seen_running[1] == h, "the heir runs as soon as its core is rung")
    assert(m.seen_holder[1] == h, "and the mutex is already its own")
    assert_eq(m.seen_depth[1], 1)
    assert(x.holder() == h, "still the heir's once the unlock returns")
    assert_eq(m.masked, 0)

@test("a recursive mutex handed to a waiter of another core at its last unlock is locked once when the heir's core is rung")
recursive_hand_seen_at_ring()
    var m = machine()
    val _ = task_on(&m, 0, 0, 2)
    val h = task_on(&m, 1, 1, 2)
    val _ = task_on(&m, 1, 2, 1)
    begin(&m)
    var x = Mutex.recursive("x")
    on(&m, 0)
    assert(x.lock(&m, FOREVER), "the owner locks it")
    assert(x.lock(&m, FOREVER), "and again")
    on(&m, 1)
    assert(!x.lock(&m, FOREVER), "the waiter of another core blocks")
    switch_now(&m)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    m.answering = true
    m.watched = &x
    on(&m, 0)
    x.unlock(&m)
    assert_eq(m.rung[1], 0)
    assert_eq(x.depth(), 1)
    on(&m, 0)
    x.unlock(&m)
    assert_eq(m.rung[1], 1)
    assert(m.seen_running[1] == h, "the heir runs as soon as its core is rung")
    assert(m.seen_holder[1] == h, "holding the mutex")
    assert_eq(m.seen_depth[1], 1)
    assert_eq(m.masked, 0)

@test("of two waiters on two other cores, the better one's core is rung and its task already holds the mutex; the other's core hears nothing")
best_of_two_cores_seen_at_ring()
    var m = machine()
    val _ = task_on(&m, 0, 0, 1)
    val low = task_on(&m, 1, 1, 2)
    val _ = task_on(&m, 1, 2, 1)
    val high = task_on(&m, 2, 3, 3)
    val _ = task_on(&m, 2, 4, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 0)
    assert(x.lock(&m, FOREVER), "the owner locks it")
    on(&m, 1)
    assert(!x.lock(&m, FOREVER), "the low waiter blocks")
    switch_now(&m)
    on(&m, 2)
    assert(!x.lock(&m, FOREVER), "the high waiter blocks")
    switch_now(&m)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    val rung_low = m.rung[1]
    m.answering = true
    m.watched = &x
    on(&m, 0)
    x.unlock(&m)
    assert_eq(m.rung[2], 1)
    assert_eq(m.rung[1], rung_low)
    assert(m.seen_running[2] == high, "the better waiter runs as soon as its core is rung")
    assert(m.seen_holder[2] == high, "holding the mutex")
    assert_eq(m.seen_depth[2], 1)
    on(&m, 1)
    assert(kernel.state(&m, low).unwrap() == TaskState.Blocked, "the other still waits")
    assert_eq(m.masked, 0)

@test("a mutex handed back and forth between two cores is the heir's each time its core is rung")
hand_back_seen_at_ring()
    var m = machine()
    val a = task_on(&m, 0, 0, 2)
    val _ = task_on(&m, 0, 1, 1)
    val b = task_on(&m, 1, 2, 2)
    val _ = task_on(&m, 1, 3, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 0)
    assert(x.lock(&m, FOREVER), "a locks it")
    on(&m, 1)
    assert(!x.lock(&m, FOREVER), "b blocks")
    switch_now(&m)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    m.answering = true
    m.watched = &x
    on(&m, 0)
    x.unlock(&m)
    assert(m.seen_running[1] == b, "b runs as soon as core 1 is rung")
    assert(m.seen_holder[1] == b, "holding the mutex")
    on(&m, 0)
    assert(!x.lock(&m, FOREVER), "a blocks in its turn")
    switch_now(&m)
    on(&m, 1)
    x.unlock(&m)
    assert(m.seen_running[0] == a, "a runs as soon as core 0 is rung")
    assert(m.seen_holder[0] == a, "holding the mutex")
    assert_eq(m.seen_depth[0], 1)
    assert_eq(m.masked, 0)
