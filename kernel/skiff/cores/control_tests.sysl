module skiff.cores
@tests

import skiff.kernel
import skiff.kernel.{FOREVER, Mutex, Semaphore, Task, TaskError, TaskState}

// Task control between cores, on the host machine of three cores (machine.sysl): a call for another
// core's task records the request in the task's note and posts one `Control` message, which that core
// applies when the test answers its doorbell.

// `t`'s state, asked on its own core.
private state_of(m: *Machine, t: Task) -> TaskState
    on(m, t.core())
    kernel.state(m, t).unwrap()

// Whether `t` is suspended, asked on its own core.
private suspended_on(m: *Machine, t: Task) -> bool
    on(m, t.core())
    kernel.suspended(m, t).unwrap()

// `t`'s effective priority, asked on its own core.
private priority_on(m: *Machine, t: Task) -> u8
    on(m, t.core())
    kernel.priority(m, t).unwrap()

// Answer core `core`'s doorbell as that core.
private answer(m: *Machine, core: u32)
    on(m, core)
    kernel.answer_doorbell(m)

@test("a suspend and a resume from another core take effect when its doorbell is answered")
suspend_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    on(&m, 0)
    assert(kernel.suspend(&m, w).is_ok(), "asked")
    assert_eq(m.rung[1], 1)
    assert(!suspended_on(&m, w), "not before its core answers")
    val asked = m.switches[1]
    answer(&m, 1)
    assert(suspended_on(&m, w), "suspended once it answered")
    assert_eq(m.switches[1], asked + 1)
    switch_now(&m)
    assert(kernel.current(&m) != w, "switched away from")
    on(&m, 0)
    assert(kernel.resume(&m, w).is_ok(), "asked")
    assert_eq(m.rung[1], 2)
    answer(&m, 1)
    assert(!suspended_on(&m, w), "resumed")
    switch_now(&m)
    assert(kernel.current(&m) == w, "it runs again")
    assert_eq(m.masked, 0)

@test("requests made before the core answers combine into one message: the last suspend or resume, the last priority")
requests_combine()
    var m = machine()
    val w = task_on(&m, 1, 0, 1)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    on(&m, 0)
    assert(kernel.suspend(&m, w).is_ok(), "suspend")
    assert(kernel.set_priority(&m, w, 5).is_ok(), "priority 5")
    assert(kernel.resume(&m, w).is_ok(), "resume")
    assert(kernel.set_priority(&m, w, 4).is_ok(), "priority 4")
    assert(kernel.suspend(&m, w).is_ok(), "suspend again")
    assert_eq(m.rung[1], 1)
    answer(&m, 1)
    assert(suspended_on(&m, w), "the last was a suspend")
    assert_eq(priority_on(&m, w), 4)
    on(&m, 0)
    assert(kernel.resume(&m, w).is_ok(), "a new request")
    assert_eq(m.rung[1], 2)
    answer(&m, 1)
    assert(!suspended_on(&m, w), "resumed")
    assert_eq(priority_on(&m, w), 4)

@test("a stop from another core withdraws its waiter from the queue, and a give then goes to the count")
stop_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var s = Semaphore.new("s", 0, 1)
    on(&m, 1)
    val _ = s.take(&m, FOREVER)
    switch_now(&m)
    on(&m, 0)
    assert(kernel.stop(&m, w).is_ok(), "asked")
    answer(&m, 1)
    assert(state_of(&m, w) == TaskState.Stopped, "Stopped")
    assert_eq(s.w.queue.first(), 0xffff)
    on(&m, 0)
    val rung = m.rung[1]
    assert(s.give(&m), "given")
    assert_eq(s.count, 1)
    assert_eq(m.rung[1], rung)
    assert_eq(m.masked, 0)

@test("a priority change from another core re-sorts its waiter, and a boost lent across cores outlives it")
priority_across()
    var m = machine()
    val o = task_on(&m, 1, 0, 1)
    val _ = task_on(&m, 1, 1, 1)
    val h = task_on(&m, 0, 2, 3)
    val _ = task_on(&m, 0, 3, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 1)
    assert(x.lock(&m, FOREVER), "the owner on core 1 locks it")
    on(&m, 0)
    val _ = x.lock(&m, FOREVER)
    switch_now(&m)
    answer(&m, 1)
    assert_eq(priority_on(&m, o), 3)
    on(&m, 0)
    assert(kernel.set_priority(&m, o, 2).is_ok(), "base raised below the boost")
    answer(&m, 1)
    assert_eq(priority_on(&m, o), 3)
    on(&m, 0)
    assert(kernel.set_priority(&m, h, 1).is_ok(), "the waiter, on its own core, lowered")
    assert_eq(priority_on(&m, h), 1)
    on(&m, 1)
    x.unlock(&m)
    assert_eq(priority_on(&m, o), 2)

@test("a request to a task gone since its message was posted is dropped, and its slot's next task is untouched")
request_outlived()
    var m = machine()
    val w = task_on(&m, 1, 0, 1)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    on(&m, 0)
    assert(kernel.suspend(&m, w).is_ok(), "asked")
    assert(kernel.stop(&m, w).is_ok(), "asked")
    on(&m, 1)
    assert(kernel.delete(&m, w).is_ok(), "deleted before its core answered")
    switch_now(&m)
    on(&m, 0)
    assert(kernel.suspend(&m, w) == Err(TaskError.Stale), "the asking core sees it gone")
    on(&m, 1)
    val n = task_on(&m, 1, 4, 1)
    assert_eq(n.slot(), w.slot())
    on(&m, 0)
    assert(kernel.set_priority(&m, n, 6).is_ok(), "the new task's request rides the message in flight")
    assert_eq(m.rung[1], 1)
    answer(&m, 1)
    assert(state_of(&m, n) == TaskState.Ready, "not stopped")
    assert(!suspended_on(&m, n), "not suspended")
    assert_eq(priority_on(&m, n), 6)
    on(&m, 0)
    assert(kernel.stop(&m, n).is_ok(), "a new request posts again")
    assert_eq(m.rung[1], 2)
    answer(&m, 1)
    assert(state_of(&m, n) == TaskState.Stopped, "stopped")

@test("another core's idle task, the handle 0 and a stale handle are refused by the asking core, and nothing is posted")
refused_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 1)
    val _ = task_on(&m, 0, 1, 1)
    begin(&m)
    on(&m, 1)
    val idle = kernel.here(&m).sched.handle(1, 1)
    kernel.here(&m).sched.add_on(1, stacks_for_idle[0], 0, 0)
    on(&m, 0)
    assert(kernel.suspend(&m, idle) == Err(TaskError.Stale), "the idle task's note is for no task")
    assert(kernel.stop(&m, kernel.NO_TASK) == Err(TaskError.Stale), "the handle 0")
    on(&m, 1)
    assert(kernel.delete(&m, w).is_ok(), "deleted")
    on(&m, 0)
    assert(kernel.stop(&m, w) == Err(TaskError.Stale), "stale")
    assert(kernel.set_priority(&m, w, 40) == Err(TaskError.Priority), "the priority is checked first")
    assert_eq(m.rung[1], 0)
    assert_eq(m.masked, 0)

@test("a task of a core not yet started is acted on at once, with nothing posted")
offline_core()
    var m = machine()
    val a = task_on(&m, 1, 0, 3)
    val b = task_on(&m, 1, 1, 1)
    on(&m, 0)
    assert(kernel.suspend(&m, a).is_ok(), "suspended")
    assert(kernel.set_priority(&m, b, 2).is_ok(), "re-prioritized")
    assert_eq(m.rung[1], 0)
    assert_eq(m.switches[0], 0)
    begin(&m)
    on(&m, 1)
    assert(kernel.current(&m) == b, "the suspended task is not chosen")
    assert_eq(priority_on(&m, b), 2)
    assert(suspended_on(&m, a), "suspended")

private var stacks_for_idle: [1][64]u32
