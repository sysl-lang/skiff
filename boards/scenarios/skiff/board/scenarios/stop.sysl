module skiff.board.scenarios

import skiff.kernel
import skiff.kernel.{Port, Semaphore}

// Stopping the machine (DESIGN "Stopping the machine"), R's part on each core of a board whose port has a
// deep state (the Pico 2). Both cores allow the stop and meet; then, from one tick of the time base, core
// 0 makes a timed take of a semaphore nobody gives (`NAP`) and core 1 sleeps (`SLEEP`), and each then
// sleeps on past the other's deadline. With every other task waiting, both cores are idle long enough, so
// the machine stops until the soonest deadline, its wake timer ends the stop, and both cores take the
// ticks it slept. Each wait must end on its deadline (within `LATE`), and each core must have been part of
// a stop and have taken, from stops, most of the ticks the waits spanned. The board's `clock` (milliseconds, from
// a timer that runs through the stop) must agree with the time base over the wait: the time base may run
// ahead by a bunched tick's few, and behind by ticks lost while a core runs slowly (through the boot ROM's
// flash set-up, a core loses some), but not by half the wait, as it does when it stands still while the
// machine sleeps, however its deadlines read. Then both forbid the stop again.

private const NAP: u32 = 40         // core 0's timed take
private const SLEEP: u32 = 60       // core 1's sleep
private const AFTER: u32 = 70       // where both sleep to once their own wait has ended
private const LATE: u32 = 5         // a late or bunched tick (benchtop's seeded runs) may end a wait this late
private const MS_LATE: u64 = u64(LATE) * 1000 / u64(kernel.TICK_HZ)   // how far the time base may run ahead of the wake timer

private var stop_naps = [Semaphore.new("stop nap", 0, 1); kernel.CORES]

// R's part, on the running core.
deep_stop[P: Port](p: *P, clock: *extern() -> u64)
    val me = kernel.here_id(p)
    kernel.allow_stop(p, true)
    val stops = kernel.machine_stops(p)
    val stopped = kernel.stopped_ticks(p)
    if me == 0
        for n in 1..<kernel.CORES
            while common.stop_ready[n].load() == 0 do kernel.sleep(p, 1)
        common.stop_from.store(kernel.ticks() +% 3)
        common.stop_ready[0].store(1)
    else
        common.stop_ready[me].store(1)
        while common.stop_ready[0].load() == 0 do kernel.sleep(p, 1)
    val start = common.stop_from.load()
    kernel.sleep_until(p, start)
    val began = clock()
    var right = true
    var ended: u32 = 0
    if me == 0
        right = !stop_naps[me].take(p, NAP)
        ended = kernel.ticks()
        right = right && stop_on_time(start +% NAP, ended)
    else
        kernel.sleep_until(p, start +% SLEEP)
        ended = kernel.ticks()
        right = stop_on_time(start +% SLEEP, ended)
    val spent = clock() - began
    val expected = u64(ended -% start) * 1000 / u64(kernel.TICK_HZ)
    right = right && spent + MS_LATE >= expected && spent <= 2 * expected
    kernel.sleep_until(p, start +% AFTER)
    val took = kernel.stopped_ticks(p) -% stopped
    val count = kernel.machine_stops(p) -% stops
    kernel.allow_stop(p, false)
    if right && count >= 1 && took >= NAP / 2
        say(p, "the machine stopped with every core idle, and the time base moved on by the time it slept\n")
    else
        say(p, "a stop of the machine went wrong: the wait ended ")
        kernel.write_dec(p, ended -% start)
        p.write(" ticks after it began, with ".bytes)
        kernel.write_dec(p, count)
        p.write(" stops and ".bytes)
        kernel.write_dec(p, took)
        p.write(" ticks taken from them; the wake timer counted ".bytes)
        kernel.write_dec(p, u32(spent))
        p.write(" ms\n".bytes)

// Whether `now` is at or after `deadline`, by no more than `LATE`.
private stop_on_time(deadline: u32, now: u32) -> bool = kernel.expired(deadline, now) && now -% deadline <= LATE
