// skiff on QEMU's MPS2 AN521, core 0: it starts first, empties the links and releases core 1.

package {
  name    = "qemu-an521-core0"
  version = "0.0.1"
}

dependencies {
  kernel { workspace = true }
  armv7m { workspace = true }
  an521 { workspace = true }
  qemu-an521 { workspace = true }
}

targets {
  thumb-freestanding {
    linker_script = "link.ld"
    entry         = "_start"
  }
}
