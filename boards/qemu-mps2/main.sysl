// skiff on QEMU's MPS2 AN500 and AN386: the kernel over the armv7m arch package and the mps2 chip.
// It boots, checks that the kernel's shared state is in `.shared`, watches three ticks and checks that
// the time base kept count of them. Then it runs the scenarios' tasks (skiff.board.scenarios), and the
// last of them stops the machine with the status `boot` answered.

import sysl.sync.Atomic
import skiff.arch.armv7m
import skiff.board.scenarios
import skiff.chip.mps2
import skiff.kernel
import skiff.kernel.Port

// The bounds of `.shared`, from the link script.
extern __shared_start: u8
extern __shared_end: u8

// The core as the kernel sees it: one core, the first UART as its console, SysTick as its tick, and the
// armv7m context switch.
struct Board
end Board

impl Port for Board
    write(*self, bytes: []const u8) = mps2.write(bytes)
    cores(*self) -> u32 = 1
    core_id(*self) -> u32 = 0
    start_ticks(*self, hz: u32) = armv7m.systick_start(mps2.CLOCK_HZ / hz)
    idle(*self) = armv7m.wait_for_interrupt()
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = armv7m.new_context(stack, entry)
    request_switch(*self) = armv7m.request_switch()
    start_first(*self, sp: usize) -> never = armv7m.start_first(sp)
    mask(*self) -> u32 = armv7m.mask()
    restore(*self, state: u32) = armv7m.restore(state)
    spin_lock(*self, word: *Atomic[u32]) = armv7m.spin_lock(word)
    spin_try_lock(*self, word: *Atomic[u32]) -> bool = armv7m.spin_try_lock(word)
    spin_unlock(*self, word: *Atomic[u32]) = armv7m.spin_unlock(word)

// The status `boot` answered, which the last task stops the machine with.
private var status: i32 = 0

private var entries: scenarios.Entries = scenarios.Entries(&task_a, &task_b, &task_p1, &task_p2, &task_h, &task_r, &scenarios.again, &task_idle, &meet, &task_low, &task_middle, &task_high, &task_timed, &task_raiser, &task_hammer, &raise)

// Called by the chip's reset handler once there is a stack and `.bss` and `.shared` are zero.
@export("skiff_main")
skiff_main() -> never
    mps2.console_init()
    armv7m.enable_faults()
    var board = Board()
    status = kernel.boot(&board)
    if kernel.shared_within(usize(&__shared_start), usize(&__shared_end))
        board.write("skiff: .shared holds the shared state\n".bytes)
    kernel.shared_bounds(usize(&__shared_start), usize(&__shared_end))
    armv7m.set_irq_priority(mps2.TIMER0_IRQ, armv7m.KERNEL_IRQ_PRIORITY)
    armv7m.enable_irq(mps2.TIMER0_IRQ)
    scenarios.create_tasks(&board, 0, &entries)
    kernel.start(&board)
    for _ in 0..<3
        val n = kernel.await_tick(&board)
        board.write("skiff: core 0 tick ".bytes)
        kernel.write_dec(&board, n)
        board.write("\n".bytes)
    if kernel.ticks() == kernel.here(&board).own_ticks()
        board.write("skiff: core 0 time base agrees\n".bytes)
    scenarios.run_tasks(&board, &entries)

private task_a() -> never = scenarios.take_turns(&Board(), "A", false)
private task_b() -> never = scenarios.take_turns(&Board(), "B", true)
private task_p1() -> never = scenarios.fp_task(&Board(), 0x1000, &entries)
private task_p2() -> never = scenarios.fp_task(&Board(), 0x2000, &entries)
private task_h() -> never = scenarios.wake_on_time(&Board())
private meet() = scenarios.meet(&Board())
private task_low() -> never = scenarios.low_task(&Board())
private task_middle() -> never = scenarios.middle_task(&Board())
private task_high() -> never = scenarios.high_task(&Board())
private task_timed() -> never = scenarios.timed_task(&Board())
private task_raiser() -> never = scenarios.raiser_task(&Board(), &entries)
private task_hammer() -> never = scenarios.hammer_task(&Board())

// Raise timer 0's interrupt from software; the timer itself never runs.
private raise() = armv7m.pend_irq(mps2.TIMER0_IRQ)

// Timer 0's interrupt: the scenarios' give.
@export("skiff_timer0")
board_timer0()
    scenarios.interrupt(&Board())

private task_idle() -> never
    loop
        armv7m.wait_for_interrupt()

// R: the handle checks, then the waits, then the end of the run.
private task_r() -> never
    var board = Board()
    scenarios.check_handles(&board, &entries)
    scenarios.await_waits(&board)
    armv7m.halt(status)

// SysTick: one tick for the kernel.
@export("skiff_systick")
board_tick()
    var board = Board()
    kernel.tick(&board)

// PendSV's switch: the kernel chooses the next task.
@export("skiff_switch")
board_switch(sp: usize) -> usize
    var board = Board()
    kernel.switch_context(&board, sp)

// A fault on the one core stops the machine, with `FAULT_STATUS`, once the kernel has reported it.
@export("skiff_fault")
board_fault(exception: u32) -> never
    var board = Board()
    kernel.fault(&board, armv7m.exception_name(exception))
    armv7m.halt(armv7m.FAULT_STATUS)

// The standard library's `print` writes through C's `putchar`, and a freestanding image has no C library
// to supply it, so the console does.
@export("putchar")
putchar(c: int) -> int
    mps2.put_byte(u8(c & 0xff))
    c

// A structure copy or clear too big to inline becomes a call to C's `memcpy` or `memset`, and a
// freestanding image has no C library, so the board supplies them.
@export("memcpy")
board_memcpy(dst: *u8, src: *u8, n: usize) -> *u8
    for i in 0..<n
        dst[i] = src[i]
    dst

@export("memset")
board_memset(dst: *u8, byte: int, n: usize) -> *u8
    for i in 0..<n
        dst[i] = u8(byte & 0xff)
    dst

// The standard library's `exit`, which `panic` ends in after printing its message: stop the machine
// with that status.
@export("exit")
board_exit(code: int) -> never
    armv7m.halt(i32(code))
