// skiff on QEMU's MPS2 AN500 and AN386: the kernel over the armv7m arch package and the mps2 chip.
//
// After the kernel's boot, the board checks an interrupt from the chip's own timer through the NVIC,
// then runs tasks (board/tasks.sysl). The last of them provokes a bus fault, which must be reported and
// stop the machine with `armv7m.FAULT_STATUS`. So a passing run ends in that status, not 0.

// Arm GNU's libgcc supplies the 64-bit divide the standard library's number formatting calls
// (`__aeabi_uldivmod`), until the library supplies it itself (FINDINGS 2). The boot test passes the
// toolchain's directory for this core and float ABI to the link.
@link("gcc")

import skiff.arch.armv7m
import skiff.chip.mps2
import skiff.kernel
import board
import board.Board

// Called by the arch package's reset handler once there is a stack and `.bss` is zero.
@export("skiff_main")
skiff_main() -> never
    armv7m.init()
    mps2.console_init()
    var b = Board()
    val status = kernel.boot(&b)
    if status != 0 then armv7m.halt(status)
    board.timer_interrupt(&b)
    board.run_tasks()

// The standard library's `print` writes through C's `putchar`, and a freestanding image has no C library
// to supply it, so the console does.
@export("putchar")
putchar(c: int) -> int
    mps2.put_byte(u8(c & 0xff))
    c

// The standard library's `exit`, which `panic` ends in after printing its message: stop the machine
// with that status.
@export("exit")
board_exit(code: int) -> never
    armv7m.halt(i32(code))

// A task the MPU stopped: report it on the console. The kernel runs the other tasks on.
@export("skiff_task_fault")
task_fault(f: *armv7m.Fault, task: *kernel.TaskInfo)
    var b = Board()
    armv7m.report_task_fault(f, task, &b)

// The arch package's fault handler hands the fault here: report it on the console and stop.
@export("skiff_fault")
fault(f: *armv7m.Fault) -> never
    var b = Board()
    armv7m.report(f, &b)
    armv7m.halt(armv7m.FAULT_STATUS)
