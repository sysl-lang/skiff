// skiff on QEMU's MPS2 AN500 (Cortex-M7) and AN386 (Cortex-M4). The two share a memory map, so one
// program serves both, built once per core: for the M7's double-precision FPU (fpv5-d16) and for the
// M4's single-precision one (fpv4-sp-d16).

package {
  name    = "qemu-mps2"
  version = "0.0.1"
}

// A freestanding image keeps one error return trace for the whole program, and every statement that
// handles a failure reads and restores it: an unprivileged task, whose map holds none of it, would fault.
error_traces = false

dependencies {
  kernel { workspace = true, options = { tasks = 32 } }
  armv7m { workspace = true }
  mps2 { workspace = true }
  scenarios { workspace = true }
}

targets {
  thumbv7em-freestanding-dp {
    linker_script = "link.ld"
    entry         = "_start"
  }
  thumbv7em-freestanding {
    linker_script = "link.ld"
    entry         = "_start"
  }
}
