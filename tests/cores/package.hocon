// The kernel's paths between cores, tested on the host. A package's own options always take their
// defaults when it is tested, and the kernel's `cores` defaults to 1, where no path between cores is in
// the build; so these tests live in a package of their own that builds the kernel for three cores and
// plays each core in turn over one port.

package {
  name    = "cores"
  version = "0.0.1"
}

dependencies {
  kernel { workspace = true, options = { cores = 3 } }
}
