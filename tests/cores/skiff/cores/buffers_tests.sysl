module skiff.cores
@tests

import skiff.kernel
import skiff.kernel.{BufferError, Channel, FOREVER, Pool, Task, TaskState}

// Buffers handed between cores, on the host machine of three cores (machine.sysl): core 0 fills and
// sends, core 1 receives and gives back. Each core's data cache counts what it was asked, so a test can
// see that the giving core cleaned and the taking core invalidated.

// `t`'s state, asked on its own core.
private state_on(m: *Machine, t: Task) -> TaskState
    on(m, t.core())
    kernel.state(m, t).unwrap()

@test("core 0 fills a buffer and sends it; core 1 receives the same bytes, not a copy, and gives it back")
handover_across()
    var m = machine()
    begin(&m)
    var pool: Pool[2, 16] = Pool.new("pool", 1)
    var ch: Channel[2] = Channel.new("ch")
    on(&m, 0)
    val b = pool.try_take(&m).unwrap()
    val bytes = pool.bytes(&m, b).unwrap()
    for i in 0..<bytes.len
        bytes[i] = u8(i * 3)
    assert(ch.try_send(&m, &pool, b) == Ok(()), "sent")
    assert_eq(m.cleans[0], 1)
    on(&m, 1)
    val got = ch.try_receive(&m, &pool).unwrap()
    assert_eq(m.invalidates[1], 1)
    val seen = pool.bytes(&m, got).unwrap()
    assert_eq(usize(&seen[0]), usize(&bytes[0]))
    for i in 0..<seen.len
        assert_eq(seen[i], u8(i * 3))
    assert(pool.give(&m, got) == Ok(()), "given back on core 1")
    assert_eq(m.cleans[1], 1)
    on(&m, 0)
    assert(pool.give(&m, b) == Err(BufferError.Stale), "core 0 gave it away")
    assert_eq(pool.available(&m), 2)
    assert_eq(m.rung[1], 0)
    assert_eq(m.masked, 0)

@test("a receive blocked on core 1 is woken by core 0's send, through core 1's inbox and doorbell")
receive_blocks_across()
    var m = machine()
    val rx = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var pool: Pool[2, 16] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    on(&m, 1)
    assert(ch.receive(&m, &pool, FOREVER) == None, "waits")
    switch_now(&m)
    on(&m, 0)
    val b = pool.try_take(&m).unwrap()
    assert(ch.try_send(&m, &pool, b) == Ok(()), "sent")
    assert_eq(m.rung[1], 1)
    assert(state_on(&m, rx) == TaskState.Blocked, "blocked until its own core answers")
    on(&m, 1)
    kernel.answer_doorbell(&m)
    assert(state_on(&m, rx) == TaskState.Ready, "ready")
    assert_eq(ch.waiting(&m), 0)
    assert(ch.try_receive(&m, &pool) == None, "the buffer is kept for the woken receiver")
    assert_eq(pool.available(&m), 1)

@test("a take blocked on core 1's empty pool is woken by core 0's give back")
take_blocks_across()
    var m = machine()
    val taker = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var pool: Pool[1, 16] = Pool.new("pool", 1)
    on(&m, 0)
    val b = pool.try_take(&m).unwrap()
    on(&m, 1)
    assert(pool.take(&m, FOREVER) == None, "waits")
    switch_now(&m)
    on(&m, 0)
    assert(pool.give(&m, b) == Ok(()), "given back")
    assert_eq(m.rung[1], 1)
    on(&m, 1)
    kernel.answer_doorbell(&m)
    assert(state_on(&m, taker) == TaskState.Ready, "ready")
    assert(pool.try_take(&m) == None, "kept for the woken taker")

@test("a send from core 0 that lands between core 1's deadline tick and its timeout wins: the buffer stays kept for the receiver")
send_beats_timeout_across()
    var m = machine()
    val rx = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var pool: Pool[2, 16] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    on(&m, 1)
    val _ = ch.receive(&m, &pool, 1)
    switch_now(&m)
    on(&m, 0)
    kernel.tick(&m)
    on(&m, 1)
    val _ = kernel.here(&m).sched.tick(kernel.ticks())
    on(&m, 0)
    assert(ch.try_send(&m, &pool, pool.try_take(&m).unwrap()) == Ok(()), "the send")
    on(&m, 1)
    kernel.tick(&m)
    assert(state_on(&m, rx) == TaskState.Blocked, "the timeout did not end the wait")
    kernel.answer_doorbell(&m)
    assert(state_on(&m, rx) == TaskState.Ready, "the send did")
    assert(ch.try_receive(&m, &pool) == None, "kept for the receiver")
    assert_eq(pool.available(&m), 1)

@test("a timeout on core 1 that ends a receive first leaves core 0's send in the channel, posts nothing, and every buffer comes back")
timeout_beats_send_across()
    var m = machine()
    val rx = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var pool: Pool[2, 16] = Pool.new("pool", 1)
    var ch: Channel[1] = Channel.new("ch")
    on(&m, 1)
    val _ = ch.receive(&m, &pool, 1)
    switch_now(&m)
    on(&m, 0)
    kernel.tick(&m)
    on(&m, 1)
    kernel.tick(&m)
    assert(state_on(&m, rx) == TaskState.Ready, "timed out")
    on(&m, 0)
    assert(ch.try_send(&m, &pool, pool.try_take(&m).unwrap()) == Ok(()), "sent into the channel")
    assert_eq(m.rung[1], 0)
    on(&m, 1)
    val got = ch.try_receive(&m, &pool).unwrap()
    assert(pool.give(&m, got) == Ok(()), "given back")
    assert_eq(pool.available(&m), 2)
