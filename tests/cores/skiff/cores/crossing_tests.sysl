module skiff.cores
@tests

import skiff.kernel
import skiff.kernel.{FOREVER, INBOX_MESSAGES, Mutex, Semaphore, Task, TaskState}

// Wakes and boosts between cores, on the host machine of three cores (machine.sysl). Each test creates
// its tasks, starts the cores and then acts as one core after another; what one core posts reaches
// another only when the test answers that core's doorbell.

// `t`'s state, asked on its own core.
private state_of(m: *Machine, t: Task) -> TaskState
    on(m, t.core())
    kernel.state(m, t).unwrap()

// `t`'s effective priority, read from its core's table.
private priority_of(m: *Machine, t: Task) -> u8
    on(m, t.core())
    kernel.here(m).sched.tasks[t.slot()].priority

// How many mutexes `t` holds.
private held_by(m: *Machine, t: Task) -> u8
    on(m, t.core())
    kernel.here(m).sched.tasks[t.slot()].held

// The slots of core `core`'s ready tasks at `priority`, first to last, as decimal digits.
private ready_order(m: *Machine, core: u32, priority: u8) -> u32
    on(m, core)
    val s = &kernel.here(m).sched
    var order: u32 = 0
    var at = s.heads[usize(priority)]
    while at != 0xffff
        order = order * 10 + u32(at)
        at = s.tasks[usize(at)].next
    order

@test("a give on one core wakes a task waiting on another, through that core's inbox and doorbell")
wake_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var s = Semaphore.new("s", 0, 1)
    on(&m, 1)
    val _ = s.take(&m, 5)
    switch_now(&m)
    on(&m, 0)
    assert(s.give(&m), "given")
    assert_eq(s.count, 0)
    assert_eq(m.rung[1], 1)
    assert_eq(m.rung[0], 0)
    assert_eq(m.rung[2], 0)
    assert(state_of(&m, w) == TaskState.Blocked, "still blocked until its own core answers")
    on(&m, 1)
    val asked = m.switches[1]
    kernel.answer_doorbell(&m)
    assert(state_of(&m, w) == TaskState.Ready, "ready once its core answered")
    assert_eq(m.switches[1], asked + 1)
    assert_eq(ready_order(&m, 1, 2), u32(w.slot()))
    // The wake took it out of the timeout list: its deadline passing changes nothing.
    for _ in 0..<6
        on(&m, 0)
        kernel.tick(&m)
        on(&m, 1)
        kernel.tick(&m)
    assert(state_of(&m, w) == TaskState.Ready, "still ready")
    assert_eq(ready_order(&m, 1, 2), u32(w.slot()))
    assert_eq(kernel.here(&m).sched.expiring, 0xffff)
    assert_eq(m.masked, 0)

@test("a wake from another core that lands between the deadline's tick and the timeout wins, and the timeout does nothing")
wake_beats_timeout_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var s = Semaphore.new("s", 0, 1)
    on(&m, 1)
    val _ = s.take(&m, 1)
    switch_now(&m)
    on(&m, 0)
    kernel.tick(&m)
    // Core 1's tick finds the deadline come and moves the wait to its expiring list ...
    on(&m, 1)
    val _ = kernel.here(&m).sched.tick(kernel.ticks())
    assert_eq(kernel.here(&m).sched.expiring, u16(w.slot()))
    // ... core 0's give ends the wait first ...
    on(&m, 0)
    assert(s.give(&m), "the wake")
    assert_eq(s.count, 0)
    // ... so ending the expired waits finds it settled, and only the message makes the task ready.
    on(&m, 1)
    kernel.tick(&m)
    assert(state_of(&m, w) == TaskState.Blocked, "the timeout did not end the wait")
    kernel.answer_doorbell(&m)
    assert(state_of(&m, w) == TaskState.Ready, "the wake did")
    assert_eq(ready_order(&m, 1, 2), u32(w.slot()))
    assert_eq(kernel.here(&m).sched.expiring, 0xffff)
    assert_eq(s.count, 0)

@test("a timeout that ends a wait first leaves a give from another core to the count, and posts nothing")
timeout_beats_wake_across()
    var m = machine()
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var s = Semaphore.new("s", 0, 1)
    on(&m, 1)
    val _ = s.take(&m, 1)
    switch_now(&m)
    on(&m, 0)
    kernel.tick(&m)
    on(&m, 1)
    kernel.tick(&m)
    assert(state_of(&m, w) == TaskState.Ready, "timed out")
    on(&m, 0)
    assert(s.give(&m), "given to the count")
    assert_eq(s.count, 1)
    assert_eq(m.rung[1], 0)
    on(&m, 1)
    kernel.answer_doorbell(&m)
    assert_eq(ready_order(&m, 1, 2), u32(w.slot()))

@test("a waiter on another core raises a mutex's owner through its inbox; the owner drops it with the mutex, which goes to the waiter")
boost_across()
    var m = machine()
    val o = task_on(&m, 1, 0, 1)
    val h = task_on(&m, 0, 1, 3)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 1)
    assert(x.lock(&m, FOREVER), "the owner locks it")
    on(&m, 0)
    assert(!x.lock(&m, FOREVER), "the waiter blocks")
    switch_now(&m)
    assert_eq(m.rung[1], 1)
    assert_eq(priority_of(&m, o), 1)
    on(&m, 1)
    kernel.answer_doorbell(&m)
    assert_eq(priority_of(&m, o), 3)
    on(&m, 1)
    x.unlock(&m)
    assert_eq(priority_of(&m, o), 1)
    assert(x.holder() == h, "handed to the waiter")
    assert_eq(m.rung[0], 1)
    assert(state_of(&m, h) == TaskState.Blocked, "not ready until its core answers")
    assert_eq(held_by(&m, h), 0)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    assert(state_of(&m, h) == TaskState.Ready, "ready")
    assert_eq(held_by(&m, h), 1)
    switch_now(&m)
    assert(kernel.current(&m) == h, "the waiter runs, holding the mutex")
    x.unlock(&m)
    assert(x.holder() == kernel.NO_TASK, "free")
    assert_eq(held_by(&m, h), 0)
    assert_eq(m.masked, 0)

@test("a boost that reaches the owner's core after the owner let the mutex go is dropped")
late_boost_dropped()
    var m = machine()
    val o = task_on(&m, 1, 0, 1)
    val h = task_on(&m, 0, 1, 3)
    val _ = task_on(&m, 0, 2, 1)
    begin(&m)
    var x = Mutex.new("x")
    on(&m, 1)
    assert(x.lock(&m, FOREVER), "the owner locks it")
    on(&m, 0)
    val _ = x.lock(&m, FOREVER)
    switch_now(&m)
    on(&m, 1)
    x.unlock(&m)
    kernel.answer_doorbell(&m)
    assert_eq(priority_of(&m, o), 1)
    assert(x.holder() == h, "handed to the waiter")

@test("a hand-over to a task deleted since, whose slot now holds another, is dropped by the generation")
stale_handle_by_inbox()
    var m = machine()
    // Core 1: the waiter, then a task that will be created in its slot, and the background task.
    val w = task_on(&m, 1, 0, 2)
    val _ = task_on(&m, 1, 1, 1)
    val _ = task_on(&m, 0, 2, 1)
    val _ = task_on(&m, 2, 3, 1)
    begin(&m)
    var x = Mutex.new("x")
    var s = Semaphore.new("s", 0, 1)
    assert(x.lock(&m, FOREVER), "core 0 holds the mutex")
    on(&m, 1)
    val _ = x.lock(&m, FOREVER)
    switch_now(&m)
    on(&m, 0)
    x.unlock(&m)
    assert(x.holder() == w, "handed over, the message posted")
    on(&m, 1)
    assert(kernel.delete(&m, w).is_ok(), "deleted before its core answered")
    val n = task_on(&m, 1, 4, 2)
    assert_eq(n.slot(), w.slot())
    assert(n != w, "another generation")
    switch_now(&m)
    assert(kernel.current(&m) == n, "the new task runs")
    val _ = s.take(&m, FOREVER)
    switch_now(&m)
    // Core 2 ends the new task's wait: its own message is behind the stale one.
    on(&m, 2)
    assert(s.give(&m), "given")
    on(&m, 1)
    kernel.answer_doorbell(&m)
    assert(state_of(&m, n) == TaskState.Ready, "the new task's wake applied")
    assert_eq(held_by(&m, n), 0)
    assert_eq(priority_of(&m, n), 2)
    assert_eq(ready_order(&m, 1, 2), u32(n.slot()))

@test("a doorbell drains its core's rings in the order of the posting cores, each ring oldest first")
drain_order()
    var m = machine()
    val x = task_on(&m, 0, 0, 2)
    val y = task_on(&m, 0, 1, 2)
    val z = task_on(&m, 0, 2, 2)
    val _ = task_on(&m, 0, 3, 1)
    val _ = task_on(&m, 1, 4, 1)
    val _ = task_on(&m, 2, 5, 1)
    begin(&m)
    var sx = Semaphore.new("x", 0, 1)
    var sy = Semaphore.new("y", 0, 1)
    var sz = Semaphore.new("z", 0, 1)
    for s in [&sx, &sy, &sz]
        val _ = s.take(&m, FOREVER)
        switch_now(&m)
    assert_eq(ready_order(&m, 0, 2), 0)
    on(&m, 2)
    assert(sz.give(&m), "z")
    on(&m, 1)
    assert(sy.give(&m), "y")
    assert(sx.give(&m), "x")
    assert_eq(m.rung[0], 3)
    on(&m, 0)
    kernel.answer_doorbell(&m)
    // Core 1's ring first, in the order it posted (y, then x), then core 2's (z).
    assert_eq(ready_order(&m, 0, 2), u32(y.slot()) * 100 + u32(x.slot()) * 10 + u32(z.slot()))
    for t in [x, y, z]
        assert(state_of(&m, t) == TaskState.Ready, "ready")

// Core 0's task, at priority 2, waits on a mutex core 1's task holds and times out, `times` times, while
// core 1 never answers its doorbell: each wait posts a boost to core 1's ring from core 0.
private fill_ring(m: *Machine, x: *Mutex, times: usize)
    val _ = task_on(m, 1, 0, 1)
    val _ = task_on(m, 0, 1, 2)
    val _ = task_on(m, 0, 2, 1)
    begin(m)
    on(m, 1)
    assert(x.lock(m, FOREVER), "core 1 holds it")
    on(m, 0)
    for _ in 0..<times
        val _ = x.lock(m, 1)
        switch_now(m)
        kernel.tick(m)
        switch_now(m)

@test("a ring holds INBOX_MESSAGES, and one answer of the doorbell empties it")
ring_holds_its_messages()
    var m = machine()
    var x = Mutex.new("x")
    fill_ring(&m, &x, INBOX_MESSAGES)
    assert_eq(m.rung[1], u32(INBOX_MESSAGES))
    on(&m, 1)
    kernel.answer_doorbell(&m)
    fill_ring_more(&m, &x)
    assert_eq(m.rung[1], u32(INBOX_MESSAGES) + 1)

// One more boost from core 0, as `fill_ring` posts them.
private fill_ring_more(m: *Machine, x: *Mutex)
    on(m, 0)
    val _ = x.lock(m, 1)
    switch_now(m)
    kernel.tick(m)
    switch_now(m)

@test("a boost to a full ring stops the kernel, saying so", should_trap: "an inbox is full")
ring_full()
    var m = machine()
    var x = Mutex.new("x")
    fill_ring(&m, &x, INBOX_MESSAGES + 1)
