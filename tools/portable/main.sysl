// Instantiate the kernel over a machine with no hardware behind it (see package.hocon). Each new piece of
// the kernel that is generic over the machine is called from here as well.

import skiff.kernel
import skiff.kernel.{Flags, Machine, Mutex, NO_OWNER, Port, Queue, Semaphore}

struct Nothing
end Nothing

impl Machine for Nothing
    write(*self, bytes: []const u8) = ()
    start_ticks(*self, hz: u32) = ()
    idle(*self) = kernel.tick()

// A port that switches nothing: enough to build the scheduler for every target.
struct NoPort
end NoPort

impl Port for NoPort
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = usize(&stack[0])
    request_switch(*self) = ()
    start_first(*self, sp: usize) -> never
        loop
            ()
    mask(*self) -> u32 = 0
    restore(*self, state: u32) = ()
    idle(*self) = ()

private var sem: Semaphore = Semaphore(0, 1)
private var mutex: Mutex = Mutex(NO_OWNER)
private var queue: Queue[u32, 2] = Queue([0, 0], 0, 0)
private var flags: Flags = Flags(0)

private task() -> never
    kernel.yield_now()
    kernel.sleep(1)
    kernel.sleep_until(5)
    val _ = sem.give()
    val _ = sem.take(1)
    if mutex.lock(kernel.FOREVER) then mutex.unlock()
    val _ = queue.send(1, 0)
    val _ = queue.receive(1)
    flags.set(1)
    flags.clear(1)
    val _ = flags.wait(1, true, 1)
    kernel.sleep_forever()

@export("main")
probe() -> i32
    var m = Nothing()
    kernel.write_dec(&m, 1)
    kernel.write_hex(&m, 1)
    val status = kernel.boot(&m)
    if status != 0 then return status
    var p = NoPort()
    var stack: [32]u32 = [0; 32]
    var idle: [32]u32 = [0; 32]
    kernel.spawn(&p, stack, &task, 1)
    kernel.run(&p, idle)
