// The kernel instantiated over a machine with no hardware behind it (see package.hocon). Each piece of
// the kernel that is generic over the machine is called from here as well. The kernel is built for two
// cores, so the paths between cores are built for every CPU family too.

import skiff.kernel
import skiff.kernel.Machine

struct Nothing
end Nothing

// A tick is taken by hand: sleeping takes one, as a real core's sleep ends at its tick.
impl Machine for Nothing
    write(*self, bytes: []const u8) = ()
    cores(*self) -> u32 = 2
    core_id(*self) -> u32 = 0
    start_ticks(*self, hz: u32) = ()
    idle(*self) = kernel.tick(self)

@export("main")
probe() -> i32
    var m = Nothing()
    kernel.write_dec(&m, 1)
    kernel.write_hex(&m, 1)
    kernel.start(&m)
    kernel.await_tick(&m)
    kernel.fault(&m, "none")
    val here = kernel.here(&m)
    if !kernel.stopped(here.id) || kernel.expired(kernel.ticks(), 0) then return 1
    kernel.boot(&m)
