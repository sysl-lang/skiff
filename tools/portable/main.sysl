// The kernel instantiated over a port with no hardware behind it (see sysl.hocon). Each piece of the
// kernel that is generic over the port is called from here as well. The kernel is built for two cores,
// so the paths between cores are built for every CPU family too.

import sysl.sync.{Atomic, Lock}
import skiff.kernel
import skiff.kernel.{Access, Cache, Channel, Doorbell, Grant, Isolation, MessageBuffer, Pool, Port, Protection, Queue, Region, RegionError, Slot, StreamBuffer}

struct Nothing
end Nothing

// A tick is taken by hand: sleeping takes one, as a real core's sleep ends at its tick. A context is the
// stack's address, and no task ever runs.
impl Port for Nothing
    write(*self, bytes: []const u8) = ()
    cores(*self) -> u32 = 2
    core_id(*self) -> u32 = 0
    start_ticks(*self, hz: u32) = ()
    idle(*self) = kernel.tick(self)
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = usize(&stack[0])
    request_switch(*self) = ()
    start_first(*self, sp: usize) -> never = panic("no task runs here")
    mask(*self) -> u32 = 0
    restore(*self, state: u32) = ()
    spin_lock(*self, word: *Atomic[u32]) = ()
    spin_try_lock(*self, word: *Atomic[u32]) -> bool = true
    spin_unlock(*self, word: *Atomic[u32]) = ()

impl Doorbell for Nothing
    ring(*self, core: u32) = ()
    clear(*self) = ()

impl Cache for Nothing
    clean(*self, bytes: []const u8) = ()
    invalidate(*self, bytes: []u8) = ()

impl Protection for Nothing
    guard(*self, base: usize, bytes: usize) = ()
    reserved(*self, base: usize, bytes: usize) -> usize = 0

impl Isolation for Nothing
    capacity(*self) -> usize = 4
    encode(*self, r: Region) -> Result[Slot, RegionError] = Ok(Slot(u32(r.base), u32(r.bytes)))
    load(*self, map: []const Slot) = ()
    privilege(*self, unprivileged: bool) = ()

private var stack: [64]u32 = [0; 64]
// Objects one core keeps are constant data: an export reaches them, and a freestanding artifact has no
// entry to fill them in, so this build fails if `new` stops folding.
private var units = kernel.Semaphore.new("units", 0, 2)
private var guard = kernel.Mutex.new("guard")
private var word = kernel.KernelLock.new("word")
private var mail: Queue[u32, 2] = Queue.new("mail")
private var events = kernel.Flags.new("events", 0)
private var blocks: Pool[2, 48] = Pool.new("blocks", 1)
private var carried: Channel[2] = Channel.new("carried")
private var bytes: StreamBuffer[8] = StreamBuffer.new("bytes", 1)
private var framed: MessageBuffer[12] = MessageBuffer.new("framed")

// A message wider than a word, so a queue copies a struct in and out.
struct Reading
    channel: u8
    value: u64

// The waits and the locks, over the port.
private waits(m: *Nothing) -> bool
    var held = word.on(m)
    held.acquire()
    held.release()
    if !held.try_acquire() then return false
    held.release()
    if !units.give(m) || !units.try_take(m) || units.take(m, 1) || units.available(m) != 0 then return false
    if !guard.lock(m, kernel.FOREVER) then return false
    guard.unlock(m)
    guard.holder() == kernel.NO_TASK && messages(m)

// The queues, the flags and the notifications, over the port.
private messages(m: *Nothing) -> bool
    var readings: Queue[Reading, 3] = Queue.new("readings")
    if !readings.send(m, Reading(1, 2), kernel.FOREVER) || readings.receive(m, 1).is_none() then return false
    if !mail.try_send(m, 1) || mail.try_receive(m) != Some(1) || mail.waiting(m) != 0 then return false
    if events.set(m, 0b11) != 0b11 || events.clear(m, 0b1) != 0b11 || events.get(m) != 0b10 then return false
    if events.wait(m, 0b10, true, true, 5) != Some(0b10) then return false
    val me = kernel.current(m)
    if kernel.notify(m, me, 1, kernel.Action.SetBits).is_err() || kernel.notify_give(m, me).is_err() then return false
    kernel.notify_wait(m, 0, 0, 3) == Some(2) && kernel.notify_take(m, true, 3) == 2 && buffers(m)

// The pool and the channel, over the port.
private buffers(m: *Nothing) -> bool
    val b = blocks.take(m, kernel.FOREVER)
    if b.is_none() || blocks.try_take(m).is_none() || blocks.available(m) != 0 then return false
    if blocks.bytes(m, b.unwrap()).is_err() || blocks.capacity() != 2 || blocks.size() != 48 then return false
    if carried.send(m, &blocks, b.unwrap(), 1).is_err() || carried.try_send(m, &blocks, b.unwrap()).is_ok() then return false
    if carried.waiting(m) != 1 || carried.capacity() != 2 then return false
    val r = carried.receive(m, &blocks, 1)
    if r.is_none() || carried.try_receive(m, &blocks).is_some() then return false
    blocks.give(m, r.unwrap()).is_ok() && streams(m)

// The stream and message buffers, over the port.
private streams(m: *Nothing) -> bool
    val data: [6]u8 = [1, 2, 3, 4, 5, 6]
    var got: [8]u8 = [0; 8]
    if bytes.send(m, data[..], 1) != 6 || bytes.try_send(m, data[..]) != 2 || !bytes.set_trigger(m, 4) then return false
    if bytes.receive(m, got[..], 1) != 8 || bytes.try_receive(m, got[..]) != 0 || !bytes.reset(m) then return false
    if bytes.available(m) != 0 || bytes.space(m) != bytes.capacity() then return false
    if !framed.send(m, data[..], 1) || framed.try_send(m, data[..]) || framed.next_length(m) != 6 then return false
    if framed.space(m) == 0 || framed.receive(m, got[..], 1) != 6 || framed.try_receive(m, got[..]) != 0 then return false
    framed.reset(m)

private body() -> never
    loop
        ()

// What a board places in `.shared` beside the kernel's structure, and the handshake two images make over
// it: the fingerprint and the pointer check are worked out while compiling, so this build is what proves
// they fold on each CPU family.
struct Placed
    handshake: kernel.Handshake
    blocks: Pool[2, 48]
    counts: [4]u32

@assert(!kernel.holds_pointer[Placed](), "a structure for .shared holds a pointer")
private const PLACED: u32 = kernel.combine(kernel.fingerprint[Placed](), kernel.LAYOUT)
private var meeting: kernel.Handshake

private handshake() -> bool
    meeting.offer(PLACED)
    if meeting.await_offer() != PLACED then return false
    meeting.answer(PLACED)
    meeting.await_answer() == PLACED

private var beat: kernel.Timer

private beaten(t: *kernel.Timer, due: u32) = ()

// Software timers and their service, over the port.
private timers(m: *Nothing) -> bool
    if kernel.create_timer(m, &beat, "beat", 3, true, &beaten).is_err() || beat.core() != Some(0) then return false
    if beat.start(m, 1).is_err() || beat.reset(m, 0).is_err() || beat.change_period(m, 4, 0).is_err() then return false
    kernel.timer_turn(m)
    if beat.is_active(m) != Ok(true) || beat.stop(m, kernel.FOREVER).is_err() then return false
    if m.cores() > 3 then kernel.serve_timers(m)
    true

private var user_stack: [64]u32 = [0; 64]

// Unprivileged tasks, their calls, and stopping a task, over the port.
private protection(m: *Nothing) -> bool
    val code = Region(0, 4096, Access.Execute)
    val t = kernel.create_unprivileged(m, 0, user_stack, &body, 1, [code], [Grant.Units(&units), Grant.Bits(&events)])
    if t.is_err() || kernel.running_unprivileged(m) then return false
    val (base, bytes) = kernel.running_stack(m)
    if kernel.begin_call(m, base + bytes - 32, 32, 32)
        val _ = kernel.serve_call(m)
        if !kernel.end_call(m) then return false
    kernel.stop_running(m, kernel.Violation.Breach).is_none()

// Task control, here and through another core's inbox.
private control(m: *Nothing, t: kernel.Task) -> bool
    if kernel.suspend(m, t).is_ok() || kernel.resume(m, t).is_ok() || kernel.set_priority(m, t, 2).is_ok() then return false
    kernel.stop(m, t).is_err() && kernel.suspended(m, t).is_err() && kernel.priority(m, t).is_err()

@export("main")
probe() -> i32
    var m = Nothing()
    kernel.write_dec(&m, 1)
    kernel.write_hex(&m, 1)
    val t = kernel.create(&m, 1, stack, &body, 1)
    kernel.start(&m)
    kernel.await_tick(&m)
    kernel.answer_doorbell(&m)
    kernel.fault(&m, "none")
    val here = kernel.here(&m)
    if !kernel.stopped(here.id) || kernel.expired(kernel.ticks(), 0) then return 1
    if t.is_err() || kernel.delete(&m, t.unwrap()).is_ok() then return 1
    if !control(&m, t.unwrap()) then return 1
    if !protection(&m) || !timers(&m) || !handshake() then return 1
    if here.sched.started()
        kernel.sleep(&m, 1)
        kernel.sleep_until(&m, 1)
        kernel.yield_now(&m)
        if kernel.state(&m, t.unwrap()).is_ok() || !waits(&m) then return 1
        if kernel.switch_context(&m, 0) == 0 || kernel.current(&m) == t.unwrap() then kernel.exit(&m)
    if m.cores() > 2 then kernel.run(&m, stack, &body)
    kernel.boot(&m)
