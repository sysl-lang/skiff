// Instantiate the kernel over a machine with no hardware behind it (see package.hocon). Each new piece of
// the kernel that is generic over the machine is called from here as well.

import skiff.kernel
import sysl.sync.Atomic
import skiff.kernel.{Doorbell, Flags, Heap, Link, Machine, MessageBuffer, Mutex, NO_OWNER, NotifyAction, Pool, Port, Protection, Queue, RecursiveMutex, Ring, Semaphore, StreamBuffer}

struct Nothing
end Nothing

impl Machine for Nothing
    write(*self, bytes: []const u8) = ()
    start_ticks(*self, hz: u32) = ()
    idle(*self) = kernel.tick()

// A port that switches nothing: enough to build the scheduler for every target.
struct NoPort
end NoPort

impl Port for NoPort
    new_context(*self, stack: []u32, entry: *extern() -> never) -> usize = usize(&stack[0])
    request_switch(*self) = ()
    start_first(*self, sp: usize) -> never
        loop
            ()
    mask(*self) -> u32 = 0
    restore(*self, state: u32) = ()
    idle(*self) = ()

// Protection that guards nothing.
struct NoGuard
end NoGuard

impl Protection for NoGuard
    guard(*self, base: usize, bytes: usize) = ()

struct Block
    a: u32

// A doorbell to nobody.
struct NoBell
end NoBell

impl Doorbell for NoBell
    ring(*self) = ()

private var ring_out: Ring[u32, 4] = Ring(Atomic(0), Atomic(0), [0; 4])
private var ring_in: Ring[u32, 4] = Ring(Atomic(0), Atomic(0), [0; 4])
private var bell: NoBell = NoBell()
// Laid into the image as data, `*Doorbell` and all: an archive for a freestanding target has nothing to
// run an initializer, so this build refuses the link unless it folds.
private var link: Link[u32, 4] = Link(&ring_out, &ring_in, &bell, Flags(0))
// So does a `Some` of an address.
private var first_ring: Option[*Ring[u32, 4]] = Some(&ring_out)

private var pool: Pool[Block, 2] = Pool([Block(0); 2], [false; 2], 2)
private var heap: Heap = Heap(0, 0)
private var arena: [64]u8 = [0; 64]

private var sem: Semaphore = Semaphore(0, 1)
private var mutex: Mutex = Mutex(NO_OWNER)
private var nested: RecursiveMutex = RecursiveMutex(Mutex(NO_OWNER), 0)
private var queue: Queue[u32, 2] = Queue([0, 0], 0, 0)
private var flags: Flags = Flags(0)
private var stream: StreamBuffer[16] = StreamBuffer([0; 16], 0, 0, 1)
private var messages: MessageBuffer[16] = MessageBuffer(StreamBuffer([0; 16], 0, 0, 1))

private task() -> never
    kernel.yield_now()
    kernel.sleep(1)
    kernel.sleep_until(5)
    val _ = sem.give()
    val _ = sem.take(1)
    if mutex.lock(kernel.FOREVER) then mutex.unlock()
    if nested.take(kernel.FOREVER)
        val _ = nested.give()
    val _ = queue.send(1, 0)
    val _ = queue.receive(1)
    flags.set(1)
    flags.clear(1)
    val _ = flags.wait(1, true, 1)
    val me = kernel.running_task().index
    val _ = kernel.notify(me, 1, NotifyAction.SetBits)
    val _ = kernel.notify(me, 0, NotifyAction.Increment)
    val _ = kernel.notify(me, 2, NotifyAction.Overwrite)
    val _ = kernel.notify(me, 3, NotifyAction.NoOverwrite)
    val _ = kernel.notify_wait(0, 0xffff_ffff, 1)
    val _ = kernel.notify_take(true, 1)
    var bytes: [4]u8 = [1, 2, 3, 4]
    val _ = stream.send(bytes, 1) + stream.receive(bytes, 1)
    val _ = stream.send_now(bytes) + stream.receive_now(bytes)
    val _ = stream.set_trigger(2) && stream.reset()
    val _ = stream.available() + stream.space()
    val _ = stream.is_empty() || stream.is_full()
    val _ = messages.send(bytes, 1) && messages.send_now(bytes)
    val _ = messages.receive(bytes, 1) + messages.receive_now(bytes) + messages.next_length() + messages.space()
    val _ = messages.reset() || messages.is_empty() || messages.is_full()
    pool.alloc() match
        Some(b) -> pool.release(b)
        None -> ()
    heap.alloc(4) match
        Some(b) -> heap.release(b)
        None -> ()
    val _ = pool.available() + heap.largest()
    val _ = link.send(1, 1)
    val _ = link.receive(1)
    link.rung()
    val _ = ring_out.waiting()
    if kernel.stopped(kernel.running_task().index) then kernel.stop_running()
    kernel.set_priority(me, 2)
    val _ = kernel.priority(me) + kernel.base_priority(me)
    kernel.suspend(me)
    kernel.resume(me)
    val _ = kernel.resume_from_isr(me) || kernel.suspended(me)
    kernel.stop(me)
    kernel.sleep_forever()

@export("main")
probe() -> i32
    var m = Nothing()
    kernel.write_dec(&m, 1)
    kernel.write_hex(&m, 1)
    val status = kernel.boot(&m)
    if status != 0 then return status
    var p = NoPort()
    var stack: [32]u32 = [0; 32]
    var idle: [32]u32 = [0; 32]
    var g = NoGuard()
    heap.init(arena)
    ring_out.reset()
    ring_in.reset()
    first_ring match
        Some(r) -> r.reset()
        None -> ()
    kernel.spawn(&p, stack, &task, 1, "task")
    kernel.protect(&g)
    kernel.run(&p, idle)
