// Armv8-M Mainline (Cortex-M33, M35P, M55): what it adds to Armv7-M for protection, the PMSAv8 MPU and
// the stack limit. Everything the two share (the vector table, the context switch, SysTick, the NVIC,
// faults, kernel calls) is the armv7m package's, which a Mainline core runs unchanged; a board uses both.

package {
  name    = "armv8m"
  version = "0.0.1"
}

dependencies {
  kernel { workspace = true }
  pmsa { workspace = true }
}
