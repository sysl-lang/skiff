module skiff.arch.ticket
@tests

import sysl.sync.{Atomic, Ordering}

// The ticket lock played on the host: one thread takes each core's part in turn, so a core that waits is
// one whose ticket `turn` does not serve yet.

@test("tickets are served in the order they were taken")
tickets_in_order()
    var word: Atomic[u32] = Atomic(0)
    lock(&word)
    val b = take(&word)
    val c = take(&word)
    assert(b == 1 && c == 2, "the waiters' tickets follow the holder's")
    assert(!turn(&word, b) && !turn(&word, c), "neither waiter holds the lock")
    unlock(&word)
    assert(turn(&word, b), "the first waiter is served first")
    assert(!turn(&word, c), "the second still waits")
    unlock(&word)
    assert(turn(&word, c), "then the second")
    unlock(&word)
    assert(is_free(word.load(Ordering.Relaxed)), "free once every ticket is served")
    assert(word.load(Ordering.Relaxed) == 0x0003_0003, "three tickets taken and served")

@test("a try refuses a lock that is held or has a waiter, and takes a free one")
try_refused_while_held_or_awaited()
    var word: Atomic[u32] = Atomic(0)
    assert(try_lock(&word), "a free lock is taken")
    assert(!try_lock(&word), "a held lock is refused")
    val b = take(&word)
    assert(!try_lock(&word), "refused with a waiter behind the holder")
    assert(word.load(Ordering.Relaxed) == 0x0002_0000, "a refused try takes no ticket")
    unlock(&word)
    assert(turn(&word, b), "the waiter is served, not the try")
    assert(!try_lock(&word), "refused while the waiter holds it")
    unlock(&word)
    assert(try_lock(&word), "taken once nobody holds or waits")
    unlock(&word)
    assert(is_free(word.load(Ordering.Relaxed)), "and free again")

@test("serving past 0xffff wraps the low half and leaves the next ticket alone")
serving_wraps_alone()
    assert(served(0xabcd_ffff) == 0xabcd_0000, "the low half wraps without carrying")
    assert(served(0xabcd_1234) == 0xabcd_1235, "an ordinary release")
    // One core holds ticket 0xffff; another took ticket 0 behind it.
    var word: Atomic[u32] = Atomic(0x0000_ffff)
    val b = take(&word)
    assert(b == 0, "the ticket after 0xffff is 0")
    unlock(&word)
    assert(word.load(Ordering.Relaxed) == 0x0001_0000, "the next ticket is still 1")
    assert(turn(&word, b), "ticket 0 is served")
    unlock(&word)
    assert(is_free(word.load(Ordering.Relaxed)), "free once ticket 0 is let go")
    val c = take(&word)
    assert(c == 1 && turn(&word, c), "the next taker is served at once")

@test("the next ticket wraps past 0xffff on its own")
next_wraps_alone()
    assert(taken(0xffff_1234) == 0x0000_1234, "the high half wraps, the low half is untouched")
    var word: Atomic[u32] = Atomic(0xffff_ffff)
    assert(is_free(word.load(Ordering.Relaxed)), "both halves at 0xffff is free")
    val a = take(&word)
    assert(a == 0xffff && turn(&word, a), "ticket 0xffff is served at once")
    assert(word.load(Ordering.Relaxed) == 0x0000_ffff, "the next ticket wrapped to 0")
    val b = take(&word)
    assert(b == 0 && !turn(&word, b), "ticket 0 waits behind 0xffff")
    unlock(&word)
    assert(turn(&word, b), "and is served after it")
    unlock(&word)
    assert(word.load(Ordering.Relaxed) == 0x0001_0001, "free, one past the wrap")
    var tried: Atomic[u32] = Atomic(0xffff_ffff)
    assert(try_lock(&tried), "a try takes a free lock across the wrap")
    assert(tried.load(Ordering.Relaxed) == 0x0000_ffff, "the try's ticket wrapped the high half")

@test("a lock taken 70000 times in a row passes both wraps and ends free")
many_rounds()
    var word: Atomic[u32] = Atomic(0)
    for _ in 0..<70000
        lock(&word)
        unlock(&word)
    assert(word.load(Ordering.Relaxed) == 0x1170_1170, "both halves at 70000 mod 65536")
