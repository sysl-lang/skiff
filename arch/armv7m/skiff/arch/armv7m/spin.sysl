module skiff.arch.armv7m

import sysl.sync.Atomic
import skiff.arch.ticket

// The chip lock on an Armv7-M or Armv8-M Mainline core, for the kernel's `Port`: the ticket lock
// (`arch/ticket`) on a word in memory every core reaches. Its atomic add and compare-and-swap compile to
// LDREX/STREX here, with the barriers their orderings ask for, so the lock is the language's and no
// assembly is needed. Cores take it in the order they asked for it.

// Take the lock at `word`, waiting behind every core that asked for it first.
spin_lock(word: *Atomic[u32]) = ticket.lock(word)

// Take the lock at `word` if nobody holds it or waits for it, answering whether it did.
spin_try_lock(word: *Atomic[u32]) -> bool = ticket.try_lock(word)

// Let the lock at `word` go to the next core waiting, publishing everything written under it.
spin_unlock(word: *Atomic[u32]) = ticket.unlock(word)
