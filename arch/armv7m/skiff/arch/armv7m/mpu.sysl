module skiff.arch.armv7m

import sysl.slices.align_up
import skiff.arch.pmsa
import skiff.arch.pmsa.{MpuCtrl, MpuType, V7Rasr, V7Rbar}
import skiff.kernel.{Region, RegionError, Slot}

// The Armv7-M memory protection unit (PMSAv7, Architecture Reference Manual B3.5), for a board's
// `Protection` and `Isolation` (kernel DESIGN "Protection"). Each core has its own.
//
// The MPU runs with PRIVDEFENA set, so privileged code sees the default memory map wherever no region
// says otherwise, and unprivileged code sees nothing but its regions. Where regions overlap, the one
// with the higher number wins. Two regions forbid every access, privileged or not:
//   - **The null guard**, region 7: the first `NULL_GUARD_BYTES` of the address space, so that a read or
//     write through a null pointer, or a small offset from one, faults. The processor reads the vector
//     table through the default memory map, not the MPU's regions, so the table may live there, as it
//     does on QEMU's MPS2 boards. It is the highest region, so it wins over an unprivileged task's code
//     region that starts at zero.
//   - **The stack guard**, region 6: `STACK_GUARD_BYTES` at the bottom of the running task's stack,
//     moved on every switch. A region must be aligned to its size, so the guard starts at the first such
//     boundary in the stack, and the task has what lies above it. It wins over an unprivileged task's
//     stack region.
// Regions 0 to 5 hold an unprivileged task's map while it runs, and nothing while a privileged one does.
//
// A frame bigger than the guard can step over it, so a task whose functions keep large arrays on the
// stack can still write below its stack unseen. The guard catches a push, a call or an exception frame
// that runs off the end, which is how a stack almost always overflows.
private struct Mpu
    kind: MpuType               // 0xE000_ED90 MPU_TYPE: how many regions
    ctrl: MpuCtrl               // 0x94
    rnr: volatile u32           // 0x98 region number
    rbar: volatile u32          // 0x9c region base address (`V7Rbar`)
    rasr: volatile u32          // 0xa0 region attributes and size (`V7Rasr`)

@assert(offsetof(Mpu, rasr) == 0x10, "MPU_RASR is at 0xE000EDA0")

private const MPU: usize = 0xE000_ED90
private mpu() -> *Mpu = ptr_cast(MPU)

private const MAP_REGIONS: u32 = 6
private const STACK_REGION: u4 = 6
private const NULL_REGION: u4 = 7
private const REGIONS_NEEDED: u8 = 8

// How much of the address space from zero faults on any access.
const NULL_GUARD_BYTES: usize = 256

// How much of the bottom of a task's stack faults on any access.
const STACK_GUARD_BYTES: usize = 64

// Make `region` a guard of `bytes` at `base`: never executed, and with AP 000 no access at all.
private set_guard(m: *Mpu, region: u4, base: usize, bytes: usize)
    m.rbar = (V7Rbar::Bits(u32(base)) with { valid = 1, region = region }).bits
    m.rasr = (V7Rasr::Bits(0) with { xn = 1, size = size_field(bytes), enable = 1 }).bits

// RASR's SIZE field for a region of `bytes`, a power of two of at least 32: the region is 2^(SIZE + 1)
// bytes.
private size_field(bytes: usize) -> u5
    var log: u32 = 0
    while (1usize << log) < bytes
        log += 1
    u5(log - 1)

// Where a stack starting at `base` has its guard.
private stack_guard(base: usize) -> usize
    val p: *u8 = ptr_cast(base)
    usize(align_up(p, STACK_GUARD_BYTES))

// Guard the stack at `base`, `bytes` long: the board's `Protection.guard` on a PMSAv7 core.
guard_stack_v7(base: usize, bytes: usize)
    val g = stack_guard(base)
    if g + STACK_GUARD_BYTES > base + bytes then panic("skiff: a task stack too small for its guard")
    set_guard(mpu(), STACK_REGION, g, STACK_GUARD_BYTES)
    barrier()

// The guard and the bytes below it, up to the first 64-byte boundary: `Protection.reserved`.
reserved_v7(base: usize, bytes: usize) -> usize = stack_guard(base) + STACK_GUARD_BYTES - base

// How many regions a task's map may take: `Isolation.capacity`.
capacity_v7() -> usize = usize(MAP_REGIONS)

// How the unit holds `r`: `Isolation.encode`.
encode_v7(r: Region) -> Result[Slot, RegionError] = pmsa.encode_v7(r)

// Hold `map` in regions 0 to 5, and nothing in the rest of them: `Isolation.load`.
load_v7(map: []const Slot)
    val m = mpu()
    for k in 0u32..<MAP_REGIONS
        if usize(k) < map.len
            m.rbar = (V7Rbar::Bits(map[usize(k)].first) with { valid = 1, region = u4(k) }).bits
            m.rasr = map[usize(k)].second
        else
            m.rnr = k
            m.rasr = 0
    barrier()

// Turn the running core's MPU on with the null guard, an empty stack guard until the first task runs,
// and no map. Called on each core before it runs its tasks.
enable_protection_v7()
    val m = mpu()
    if m.kind.dregion < REGIONS_NEEDED then panic("skiff: this core's MPU has fewer than eight regions")
    for k in 0u32..<MAP_REGIONS
        m.rnr = k
        m.rasr = 0
    set_guard(m, NULL_REGION, 0, NULL_GUARD_BYTES)
    m.rnr = u32(STACK_REGION)
    m.rasr = 0
    m.ctrl = MpuCtrl::Bits(0) with { privdefena = 1, enable = 1 }
    barrier()

// Make the MPU's new regions hold for the next instruction.
private[armv7m] barrier()
    asm
        [thumb]
            "dsb"
            "isb"
        [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "skiff.arch.armv7m is for Armv7-M cores"

// Whether the running core's MPU is on.
private[armv7m] protection_on() -> bool = mpu().ctrl.enable == 1
